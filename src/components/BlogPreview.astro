---
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';

// Import stock images for Astro optimization
const stockImages = import.meta.glob<{ default: ImageMetadata }>('../assets/stock-*.webp', { eager: true });

interface Props {
	post: CollectionEntry<'blog'>;
}

const { data, id, body } = Astro.props.post;

// Resolve image: use optimized src/assets if available, fallback to public path
const stockKey = `../assets/${data.img.split('/').pop()}`;
const optimizedImg = stockImages[stockKey]?.default;

const wordCount = body ? body.split(/\s+/).length : 0;
const readingTime = Math.max(1, Math.ceil(wordCount / 220));

const publishDate = data.publishDate.toLocaleDateString('en-US', {
	year: 'numeric',
	month: 'short',
	day: 'numeric',
});

function categorySlug(cat: string): string {
	return cat
		.toLowerCase()
		.replace(/&/g, 'and')
		.replace(/[^a-z0-9]+/g, '-')
		.replace(/^-+|-+$/g, '');
}
---

<article class="card">
	{optimizedImg ? (
		<Image
			src={optimizedImg}
			alt={data.img_alt || ''}
			widths={[400, 800]}
			sizes="(max-width: 50em) 100vw, 400px"
			format="avif"
			loading="lazy"
			decoding="async"
			class="card-img"
		/>
	) : (
		<img src={data.img} alt={data.img_alt || ''} width="400" height="237" loading="lazy" decoding="async" />
	)}
	<div class="card-body">
		<h3 class="title">
			<a class="card-link" href={`/blog/${id}/`}>{data.title}</a>
		</h3>
		<div class="card-meta">
			<span>{publishDate}</span>
			<span class="sep">&middot;</span>
			<span>{readingTime} min read</span>
		</div>
		<div class="card-tags">
			{data.category.slice(0, 2).map((cat) => (
				<a class="tag" href={`/blog/category/${categorySlug(cat)}/`}>{cat}</a>
			))}
		</div>
	</div>
</article>

<style>
	/* Card: white panel, hairline border, no shadow at rest. Hover = strong hairline + 2px lift. */
	.card {
		position: relative;
		display: flex;
		flex-direction: column;
		height: 100%;
		width: 100%;
		background: var(--sg-panel);
		border: 1px solid var(--sg-hair);
		border-radius: var(--radius-md);
		overflow: hidden;
		transition: border-color 0.2s var(--ease-out), transform 0.2s var(--ease-out);
	}

	.card:hover {
		border-color: var(--gray-700);
		transform: translateY(-2px);
	}

	img {
		display: block;
		width: 100%;
		height: 11rem;
		object-fit: cover;
		border-bottom: 1px solid var(--sg-hair);
	}

	@media (prefers-reduced-motion: reduce) {
		.card {
			transition: border-color 0.2s var(--ease-out);
		}
		.card:hover {
			transform: none;
		}
	}

	.card-body {
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
		padding: 0.875rem 1rem 1rem;
	}

	/* Card title: Inter 600, ink. The h3 element keeps its semantics; the display face is overridden here. */
	.title {
		font-family: var(--font-body);
		font-size: 1.0625rem;
		font-weight: 600;
		color: var(--gray-0);
		line-height: 1.35;
		letter-spacing: -0.01em;
		margin: 0;
	}

	.card-link,
	.card-link:link,
	.card-link:visited,
	.card-link:hover {
		color: var(--gray-0) !important;
		text-decoration: none !important;
	}

	/* Stretched link: make the whole card clickable while keeping tag links clickable */
	.card-link::before {
		content: '';
		position: absolute;
		inset: 0;
		z-index: 1;
	}

	.card-link:focus-visible {
		outline: none;
	}

	.card-link:focus-visible::before {
		outline: 2px solid var(--accent-regular);
		outline-offset: -2px;
		border-radius: var(--radius-md);
	}

	.card-meta {
		display: flex;
		align-items: center;
		gap: 0.4rem;
		font-family: var(--font-mono);
		font-size: 0.75rem;
		color: var(--gray-400);
	}

	.card-tags {
		display: flex;
		gap: 0.35rem;
		flex-wrap: wrap;
		position: relative;
		z-index: 2;
	}

	/* Tags: cream chip, hairline, radius-xs, mono. Hover = strong hairline + accent text. */
	.tag {
		font-family: var(--font-mono);
		font-size: 0.72rem;
		padding: 0.15rem 0.5rem;
		border-radius: var(--radius-xs);
		background: var(--gray-900);
		border: 1px solid var(--sg-hair);
		color: var(--gray-300);
		text-decoration: none;
		transition: border-color 0.2s var(--ease-out), color 0.2s var(--ease-out);
	}

	.tag:hover {
		border-color: var(--gray-700);
		color: var(--accent-text);
	}

	.tag:focus-visible {
		outline: 2px solid var(--accent-regular);
		outline-offset: 2px;
	}

	@media (min-width: 50em) {
		img {
			height: 14rem;
		}
	}
</style>
