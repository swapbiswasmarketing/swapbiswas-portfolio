---
import Icon from './Icon.astro';
import SiteMark from './SiteMark.astro';
import type { iconPaths } from './IconPaths';
import ThemeToggle from './ThemeToggle.astro';

/** Main menu items */
const textLinks: { label: string; href: string }[] = [
	{ label: 'Home', href: '/' },
	// { label: 'Work', href: '/work/' }, // Hidden - work pages don't have final data yet
	{ label: 'Blog', href: '/blog/' },
	{ label: 'Tools', href: '/tools/' },
	{ label: 'Reading List', href: '/reading-list/' },
	{ label: 'About', href: '/about/' },
	{ label: 'Contact', href: '/contact/' },
];

/** Icon links to social media - edit these with links to your profiles! */
const iconLinks: { label: string; href: string; icon: keyof typeof iconPaths }[] = [
	{ label: 'LinkedIn', href: 'https://linkedin.com/in/swapbiswas/', icon: 'linkedin-logo' },
	{ label: 'Twitter', href: 'https://twitter.com/swapbiswas', icon: 'twitter-logo' },
	{ label: 'Instagram', href: 'https://instagram.com/swapbiswas', icon: 'instagram-logo' },
];

/** Test if a link is pointing to the current page. */
const isCurrentPage = (href: string) => {
	let pathname = Astro.url.pathname.replace(import.meta.env.BASE_URL, '');
	if (pathname.at(0) !== '/') pathname = '/' + pathname;
	if (pathname.at(-1) !== '/') pathname += '/';
	return pathname === href || (href !== '/' && pathname.startsWith(href));
};
---

<nav>
	<div class="menu-header">
		<a href="/" class="site-title">
			<SiteMark size="24px" class="site-mark" />
			Swapnil Biswas
		</a>
		<menu-button>
			<template>
				<button class="menu-button" aria-expanded="false">
					<span class="sr-only">Menu</span>
					<Icon icon="list" />
				</button>
			</template>
		</menu-button>
	</div>
	<noscript>
		<ul class="nav-items">
			{
				textLinks.map(({ label, href }) => (
					<li>
						<a aria-current={isCurrentPage(href) ? 'page' : null} class="link" href={href}>
							{label}
						</a>
					</li>
				))
			}
		</ul>
	</noscript>
	<noscript>
		<div class="menu-footer">
			<div class="socials">
				{
					iconLinks.map(({ href, icon, label }) => (
						<a href={href} class="social" target="_blank" rel="noopener noreferrer">
							<span class="sr-only">{label}</span>
							<Icon icon={icon} />
						</a>
					))
				}
			</div>
		</div>
	</noscript>
	<div id="menu-content" hidden>
		<ul class="nav-items">
			{
				textLinks.map(({ label, href }) => (
					<li>
						<a aria-current={isCurrentPage(href) ? 'page' : null} class="link" href={href}>
							{label}
						</a>
					</li>
				))
			}
		</ul>
		<div class="menu-footer">
			<div class="socials">
				{
					iconLinks.map(({ href, icon, label }) => (
						<a href={href} class="social" target="_blank" rel="noopener noreferrer">
							<span class="sr-only">{label}</span>
							<Icon icon={icon} />
						</a>
					))
				}
			</div>

			<div class="theme-toggle">
				<ThemeToggle />
			</div>
		</div>
	</div>
</nav>

<script>
	class MenuButton extends HTMLElement {
		constructor() {
			super();

			// Inject menu toggle button when JS runs.
			this.appendChild(this.querySelector('template')!.content.cloneNode(true));
			const btn = this.querySelector('button')!;

			// Hide menu (shown by default to support no-JS browsers).
			const menu = document.getElementById('menu-content')!;
			menu.hidden = true;
			// Add "menu-content" class in JS to avoid covering content in non-JS browsers.
			menu.classList.add('menu-content');

			/** Set whether the menu is currently expanded or collapsed. */
			const setExpanded = (expand: boolean) => {
				btn.setAttribute('aria-expanded', expand ? 'true' : 'false');
				menu.hidden = !expand;
			};

			// Toggle menu visibility when the menu button is clicked.
			btn.addEventListener('click', () => setExpanded(menu.hidden));

			// Hide menu button for large screens.
			const handleViewports = (e: MediaQueryList | MediaQueryListEvent) => {
				setExpanded(e.matches);
				btn.hidden = e.matches;
			};
			const mediaQueries = window.matchMedia('(min-width: 50em)');
			handleViewports(mediaQueries);
			mediaQueries.addEventListener('change', handleViewports);
		}
	}
	customElements.define('menu-button', MenuButton);
</script>

<style>
	/* Sticky paper bar: 88% paper + blur, one hairline rule underneath. No glass pill, no ring, no shadow. */
	nav {
		z-index: 9999;
		position: sticky;
		top: 0;
		font-family: var(--font-body);
		font-weight: 500;
		margin-bottom: 3.5rem;
		background: color-mix(in srgb, var(--gray-999) 88%, transparent);
		-webkit-backdrop-filter: blur(12px);
		backdrop-filter: blur(12px);
		border-bottom: 1px solid var(--sg-hair);
	}

	.menu-header {
		display: flex;
		justify-content: space-between;
		align-items: center;
		gap: 0.5rem;
		padding: 0.875rem 1.5rem;
	}

	.site-title {
		display: flex;
		gap: 0.625rem;
		align-items: center;
		line-height: 1.1;
		font-family: var(--font-display);
		font-weight: 600;
		font-size: 1.0625rem;
		letter-spacing: -0.01em;
		font-synthesis: none;
		color: var(--gray-0);
		text-decoration: none;
	}

	.site-title:hover,
	.site-title:focus {
		color: var(--gray-0);
	}

	/* Small ink square holding a paper "S" - inverts automatically in dark mode. */
	.site-mark {
		flex: none;
		display: block;
		width: 24px;
		height: 24px;
	}

	.menu-button {
		position: relative;
		display: flex;
		border: 1px solid var(--sg-hair);
		border-radius: var(--radius-sm);
		padding: 0.375rem;
		font-size: 1.375rem;
		color: var(--gray-300);
		background: var(--sg-panel);
		cursor: pointer;
		transition:
			color var(--theme-transition),
			background-color var(--theme-transition),
			border-color var(--theme-transition);
	}

	.menu-button:hover {
		color: var(--gray-0);
		border-color: var(--gray-700);
	}

	.menu-button[aria-expanded='true'] {
		color: var(--gray-0);
		background: var(--gray-900);
		border-color: var(--gray-700);
	}

	.menu-button[hidden] {
		display: none;
	}

	/* Mobile dropdown: floating panel, hairline border, shadow allowed here. */
	.menu-content {
		position: absolute;
		top: 100%;
		left: 0;
		right: 0;
		background: var(--sg-panel);
		border: 1px solid var(--sg-hair);
		border-top: 0;
		border-radius: 0 0 var(--radius-md) var(--radius-md);
		box-shadow: var(--shadow-lg);
		overflow: hidden;
	}

	.nav-items {
		margin: 0;
		display: flex;
		flex-direction: column;
		gap: 0.25rem;
		font-size: var(--text-md);
		line-height: 1.2;
		list-style: none;
		padding: 1rem;
		border-bottom: 1px solid var(--sg-hair);
	}

	.link {
		display: block;
		padding: 0.625rem 0.75rem;
		border-radius: var(--radius-sm);
		font-family: var(--font-body);
		font-weight: 500;
		color: var(--gray-300);
		text-decoration: none;
		transition:
			color var(--theme-transition),
			background-color var(--theme-transition);
	}

	.link:hover,
	.link:focus {
		color: var(--gray-0);
		background-color: var(--gray-900);
	}

	.link[aria-current='page'] {
		color: var(--gray-0);
		background-color: var(--gray-900);
	}

	.menu-footer {
		--icon-size: var(--text-xl);
		--icon-padding: 0.5rem;

		display: flex;
		justify-content: space-between;
		align-items: center;
		gap: 0.75rem;
		padding: 1rem 1.25rem 1rem 1rem;
	}

	.socials {
		display: flex;
		flex-wrap: wrap;
		gap: 0.625rem;
		font-size: var(--icon-size);
	}

	.social {
		display: flex;
		padding: var(--icon-padding);
		text-decoration: none;
		color: var(--gray-400);
		transition: color var(--theme-transition);
	}

	.social:hover,
	.social:focus {
		color: var(--gray-0);
	}

	.theme-toggle {
		display: flex;
		align-items: center;
		height: calc(var(--icon-size) + 2 * var(--icon-padding));
	}

	@media (min-width: 50em) {
		nav {
			display: grid;
			grid-template-columns: 1fr auto 1fr;
			align-items: center;
			padding: 0.75rem 2.5rem;
			gap: 1rem;
		}

		.menu-header {
			padding: 0;
		}

		.site-title {
			font-size: 1.125rem;
		}

		.menu-content {
			display: contents;
		}

		.nav-items {
			position: relative;
			flex-direction: row;
			gap: 0.125rem;
			font-size: 0.9375rem;
			border: 0;
			padding: 0;
			background: transparent;
			box-shadow: none;
		}

		.link {
			display: inline-block;
			padding: 0.5rem 0.875rem;
			border-radius: var(--radius-sm);
		}

		.link:hover,
		.link:focus {
			color: var(--gray-0);
			background-color: transparent;
		}

		.link[aria-current='page'] {
			color: var(--gray-0);
			background-color: var(--gray-900);
		}

		.menu-footer {
			--icon-padding: 0.375rem;

			justify-self: flex-end;
			align-items: center;
			padding: 0;
			background-color: transparent;
			box-shadow: none;
		}

		.socials {
			display: none;
		}
	}

	@media (min-width: 60em) {
		.socials {
			display: flex;
			justify-content: flex-end;
			gap: 0;
		}
	}

	@media (forced-colors: active) {
		.link[aria-current='page'] {
			color: SelectedItem;
		}

		/* Backgrounds are stripped in forced colors, so keep the mark's square as a border. */
		.site-mark {
			forced-color-adjust: none;
		}
	}
</style>
