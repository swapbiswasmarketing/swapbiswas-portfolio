---
import CallToAction from './CallToAction.astro';
import Icon from './Icon.astro';

interface Props {
	/** Skip rendering until the band nears the viewport. Blog posts only; see the note
	 *  above .author-bio in src/pages/blog/[...slug].astro for why it is opt-in. */
	skipOffscreen?: boolean;
}

const { skipOffscreen = false } = Astro.props;
---

<aside class:list={[skipOffscreen && 'skip-offscreen']}>
	<h2>Interested in working together?</h2>
	<CallToAction href="mailto:swapbiswas.marketing@gmail.com">
		Send Me a Message
		<Icon icon="paper-plane-tilt" size="1.2em" />
	</CallToAction>
</aside>

<style>
	/* Tinted cream band with hairline rules top and bottom. No shadow. */
	aside {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 3rem;
		border-top: 1px solid var(--sg-hair);
		border-bottom: 1px solid var(--sg-hair);
		padding: 5rem 1.5rem;
		background-color: var(--gray-900);
	}

	/* The last block above the footer on a post, so it is skipped until it nears the
	   viewport. Why, why the clip margin and the @supports gate, and why only on posts: the
	   note above .author-bio in src/pages/blog/[...slug].astro. The placeholders are content
	   boxes: 146px at 412px, 88px once the heading and button share a row. */
	.skip-offscreen {
		contain-intrinsic-block-size: auto 146px;
	}

	@supports (overflow-clip-margin: 8px) {
		.skip-offscreen {
			content-visibility: auto;
			overflow-clip-margin: 8px;
		}
	}

	h2 {
		font-family: var(--font-display);
		font-weight: 600;
		font-size: var(--text-xl);
		line-height: 1.05;
		letter-spacing: -0.02em;
		color: var(--gray-0);
		text-align: center;
		max-width: 15ch;
	}

	@media (min-width: 50em) {
		aside {
			padding: 7.5rem;
			flex-direction: row;
			flex-wrap: wrap;
			justify-content: space-between;
		}

		.skip-offscreen {
			contain-intrinsic-block-size: auto 88px;
		}

		h2 {
			font-size: var(--text-3xl);
			text-align: left;
		}
	}
</style>
