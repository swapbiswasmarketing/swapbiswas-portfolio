---
import '../styles/global.css';

interface Props {
	title?: string | undefined;
	description?: string | undefined;
	image?: string | undefined;
	noindex?: boolean | undefined;
	article?: {
		publishedTime: string;
		modifiedTime?: string;
		author?: string;
		tags?: string[];
	};
	profile?: {
		firstName: string;
		lastName: string;
		username?: string;
	};
}

const {
	title = 'Swapnil Biswas: AI, Product & Digital Growth Marketer',
	description = 'Swapnil Biswas - Product Marketing & Growth Strategist specializing in AI, SEO, and content. 657K+ leads generated, 18M+ traffic driven. Explore my work and blog.',
	image = '/og/home.webp',
	noindex = false,
	article,
	profile,
} = Astro.props;

const absoluteImageUrl = new URL(image, Astro.site).href;
const ogType = article ? 'article' : profile ? 'profile' : 'website';
---

<meta charset="UTF-8" />
<meta name="description" content={description} />
<meta name="author" content="Swapnil Biswas" />
<meta name="google-adsense-account" content="ca-pub-3086200953871328" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="color-scheme" content="light dark" />
{noindex && <meta name="robots" content="noindex, follow" />}
<meta name="generator" content={Astro.generator} />
<title>{title}</title>

<!-- Canonical URL -->
<link rel="canonical" href={Astro.url.href} />

<!-- RSS Feed -->
<link rel="alternate" type="application/rss+xml" title="Swapnil Biswas - Blog" href="/rss.xml" />

<!-- Open Graph -->
<meta property="og:type" content={ogType} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={absoluteImageUrl} />
<meta property="og:url" content={Astro.url.href} />
<meta property="og:site_name" content="Swapnil Biswas" />
{article && (
	<>
		<meta property="article:published_time" content={article.publishedTime} />
		{article.modifiedTime && <meta property="article:modified_time" content={article.modifiedTime} />}
		<meta property="article:author" content={article.author || 'https://swapbiswas.com/about/'} />
		{article.tags?.map((tag) => <meta property="article:tag" content={tag} />)}
	</>
)}
{profile && (
	<>
		<meta property="profile:first_name" content={profile.firstName} />
		<meta property="profile:last_name" content={profile.lastName} />
		{profile.username && <meta property="profile:username" content={profile.username} />}
	</>
)}

<!-- Twitter Card -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={absoluteImageUrl} />
<meta name="twitter:site" content="@swapbiswas" />

<!-- Favicons -->
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="icon" type="image/png" href="/favicon.png" />
<link rel="icon" href="/favicon.ico" />
<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
<link rel="manifest" href="/manifest.webmanifest" />
<meta name="theme-color" content="#f6f4ef" media="(prefers-color-scheme: light)" />
<meta name="theme-color" content="#151311" media="(prefers-color-scheme: dark)" />
<link rel="dns-prefetch" href="https://api.kit.com" />
<!-- Fonts are self-hosted from /public/assets/fonts and declared in global.css, so there
     is nothing to preconnect to and no third-party stylesheet to wait on. See the
     comment at the top of src/styles/global.css. -->
<!-- Analytics: only load on production -->
<script is:inline>
	if (location.hostname === 'swapbiswas.com' || location.hostname === 'www.swapbiswas.com') {
		// Google Tag Manager.
		// GTM loads GA4 (G-32PVYX6VRH) itself - you can see it request
		// gtag/js?id=G-32PVYX6VRH&cx=c&gtm=... - so this page must NOT also load a
		// standalone gtag.js. Doing both shipped two ~166 KiB copies of the same
		// library and cost ~138ms of long tasks. dataLayer is still created here so
		// anything pushed before gtm.js arrives is queued and replayed.
		window.dataLayer = window.dataLayer || [];
		(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
		new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
		j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
		'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
		})(window,document,'script','dataLayer','GTM-WGNTLP2R');

		// Microsoft Clarity
		(function(c,l,a,r,i,t,y){
			c[a]=c[a]||function(){(c[a].q=c[a].q||[]).push(arguments)};
			t=l.createElement(r);t.async=1;t.src="https://www.clarity.ms/tag/"+i;
			y=l.getElementsByTagName(r)[0];y.parentNode.insertBefore(t,y);
		})(window,document,"clarity","script","myl5bf3yc1");

		// Google AdSense (production only).
		// There is deliberately no preconnect hint for pagead2. The old one was a
		// <link rel=preconnect> appended by JS one statement before the script that used
		// it, in the same tick, so the script's own request opened the connection just as
		// fast and PageSpeed reported it as an unused preconnect.
		var ad=document.createElement('script');ad.async=true;ad.crossOrigin='anonymous';
		ad.src='https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-3086200953871328';
		document.head.appendChild(ad);
	}
</script>

<script is:inline>
	// Theme: inlined in <head> to prevent FOUC. Handles View Transitions.
	(function () {
		function getThemePreference() {
			if (typeof localStorage !== 'undefined' && localStorage.getItem('theme')) {
				return localStorage.getItem('theme');
			}
			// Follow the visitor's OS preference everywhere (homepage included).
			// The toggle still works and, once used, the saved choice wins.
			return window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
		}

		function applyTheme() {
			var isDark = getThemePreference() === 'dark';
			document.documentElement.classList[isDark ? 'add' : 'remove']('theme-dark');
		}

		// Apply immediately (blocking - prevents flash)
		applyTheme();

		// Re-apply after View Transition swap (before new page renders)
		if (!window._themeInit) {
			window._themeInit = true;
			var swapping = false;

			document.addEventListener('astro:before-swap', function () {
				swapping = true;
			});

			document.addEventListener('astro:after-swap', function () {
				applyTheme();
				swapping = false;
			});

			if (typeof localStorage !== 'undefined') {
				var observer = new MutationObserver(function () {
					if (swapping) return;
					var isDark = document.documentElement.classList.contains('theme-dark');
					localStorage.setItem('theme', isDark ? 'dark' : 'light');
				});
				observer.observe(document.documentElement, { attributes: true, attributeFilter: ['class'] });
			}
		}
	})();
</script>
