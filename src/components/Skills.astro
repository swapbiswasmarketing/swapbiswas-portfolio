---
import Icon from './Icon.astro';
---

<section class="box skills">
	<h2 class="sr-only">What I do</h2>
	<div class="stack gap-2 lg:gap-4">
		<Icon icon="strategy" size="2.5rem" />
		<h3>Product & GTM Strategy</h3>
		<p>Go-to-market campaigns, product launches, positioning, and competitive strategy for B2B SaaS.</p>
	</div>
	<div class="stack gap-2 lg:gap-4">
		<Icon icon="terminal-window" size="2.5rem" />
		<h3>AI & Marketing Automation</h3>
		<p>AI agents, workflow automation, and predictive analytics to scale marketing operations.</p>
	</div>
	<div class="stack gap-2 lg:gap-4">
		<Icon icon="trophy" size="2.5rem" />
		<h3>Data Analytics & Growth</h3>
		<p>Growth hacking, market research, conversion rate optimization, and data-driven decision making.</p>
	</div>
</section>


<style>
	.box {
		border: 1px solid var(--sg-hair);
		border-radius: var(--radius-md);
		padding: 1.5rem;
		background: var(--sg-panel);
	}

	.skills {
		display: flex;
		flex-direction: column;
		gap: 3rem;
	}

	/* Icons render with currentColor - ink */
	.skills > .stack {
		color: var(--gray-0);
	}

	.skills h3 {
		font-family: var(--font-display);
		font-weight: 600;
		font-size: 1.25rem;
		line-height: 1.15;
		letter-spacing: -0.01em;
		color: var(--gray-0);
	}

	.skills p {
		color: var(--gray-300);
	}

	@media (min-width: 50em) {
		.box {
			padding: 2.5rem;
		}

		.skills {
			display: grid;
			grid-template-columns: repeat(3, 1fr);
			gap: 4rem;
		}

		.skills h3 {
			font-size: 1.5rem;
		}
	}
</style>
