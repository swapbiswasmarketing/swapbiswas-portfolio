---
interface Props {
	title: string;
	tagline?: string;
	eyebrow?: string;
	align?: 'start' | 'center';
}

const { align = 'center', tagline, title, eyebrow } = Astro.props;
---

<div class:list={['hero stack gap-4', align]}>
	<div class="stack gap-2">
		{eyebrow && <p class="section-eyebrow">{eyebrow}</p>}
		<h1 class="title">{title}</h1>
		{tagline && <p class="tagline">{tagline}</p>}
	</div>
	<slot />
</div>

<style>
	.hero {
		font-size: var(--text-lg);
		text-align: start;
	}

	.title,
	.tagline {
		max-width: 37ch;
		margin-inline: auto;
	}

	/* Ink display title: tight tracking, no gradient text. */
	.title {
		font-family: var(--font-display);
		font-weight: 600;
		font-synthesis: none;
		font-size: clamp(2.75rem, 6.5vw, 5rem);
		color: var(--gray-0);
		letter-spacing: -0.03em;
		line-height: 1;
	}

	.tagline {
		font-family: var(--font-body);
		font-weight: 400;
		font-size: var(--text-lg);
		line-height: 1.5;
		color: var(--gray-400);
		max-width: 52ch;
	}

	@media (min-width: 50em) {
		.hero {
			font-size: var(--text-xl);
		}

		.start {
			text-align: start;
		}

		.start .title,
		.start .tagline {
			margin-inline: unset;
		}
	}
</style>
