---
// Learn about using Astro layouts:
// https://docs.astro.build/en/basics/layouts/

import { ViewTransitions } from 'astro:transitions';
import Analytics from '@vercel/analytics/astro';
import SpeedInsights from '@vercel/speed-insights/astro';
import Footer from '../components/Footer.astro';
// Component Imports
import MainHead from '../components/MainHead.astro';
import Nav from '../components/Nav.astro';
import { personSchema } from '../lib/personSchema';

interface BreadcrumbItem {
	name: string;
	url?: string;
}

interface Props {
	title?: string | undefined;
	description?: string | undefined;
	image?: string | undefined;
	noindex?: boolean | undefined;
	breadcrumbs?: BreadcrumbItem[];
	article?: {
		publishedTime: string;
		modifiedTime?: string;
		author?: string;
		tags?: string[];
	};
	profile?: {
		firstName: string;
		lastName: string;
		username?: string;
	};
}

const { title, description, image, noindex, breadcrumbs, article, profile } = Astro.props;

const navItems = [
	{ name: "Home", url: "https://swapbiswas.com/" },
	{ name: "Blog", url: "https://swapbiswas.com/blog/" },
	{ name: "Tools", url: "https://swapbiswas.com/tools/" },
	{ name: "Reading List", url: "https://swapbiswas.com/reading-list/" },
	{ name: "About", url: "https://swapbiswas.com/about/" },
	{ name: "Contact", url: "https://swapbiswas.com/contact/" },
];
const siteGraphSchema = {
	"@context": "https://schema.org",
	"@graph": [
		personSchema,
		...navItems.map((item) => ({
			"@type": "SiteNavigationElement",
			"name": item.name,
			"url": item.url,
		})),
	],
};

const breadcrumbSchema = breadcrumbs && breadcrumbs.length > 0 ? {
	"@context": "https://schema.org",
	"@type": "BreadcrumbList",
	"itemListElement": [
		{ "@type": "ListItem", "position": 1, "name": "Home", "item": "https://swapbiswas.com" },
		...breadcrumbs.map((crumb, i) => ({
			"@type": "ListItem",
			"position": i + 2,
			"name": crumb.name,
			...(crumb.url ? { "item": `https://swapbiswas.com${crumb.url}` } : {})
		}))
	]
} : null;
---

<html lang="en">
	<head>
		<MainHead title={title} description={description} image={image} noindex={noindex} article={article} profile={profile} />
		{breadcrumbSchema && <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />}
		<script type="application/ld+json" set:html={JSON.stringify(siteGraphSchema)} />
		<ViewTransitions />
		<Analytics />
		<SpeedInsights />
		<slot name="head" />
	</head>
	<body>
		<a href="#main-content" class="skip-link">Skip to content</a>
		<!-- Google Tag Manager (noscript) -->
		<noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-WGNTLP2R" height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
		<div class="stack backgrounds">
			<Nav />
			<div id="main-content">
				{breadcrumbs && breadcrumbs.length > 0 && (
					<nav class="breadcrumb-nav" aria-label="Breadcrumb">
						<ol class="breadcrumb-list">
							<li class="breadcrumb-item">
								<a href="/" aria-label="Home">
									<svg class="breadcrumb-home" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
								</a>
								<svg class="breadcrumb-chevron" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="9 18 15 12 9 6"/></svg>
							</li>
							{breadcrumbs.map((crumb, i) => (
								<li class="breadcrumb-item">
									{crumb.url && i < breadcrumbs.length - 1 ? (
										<>
											<a href={crumb.url}>{crumb.name}</a>
											<svg class="breadcrumb-chevron" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="9 18 15 12 9 6"/></svg>
										</>
									) : (
										<span class="breadcrumb-current" aria-current="page">{crumb.name}</span>
									)}
								</li>
							))}
						</ol>
					</nav>
				)}
				<slot />
			</div>
			<Footer />
		</div>

		<!-- Newsletter Slide-in Popup -->
		<div class="nl-popup" id="nl-popup" role="dialog" aria-label="Subscribe to newsletter">
			<button class="nl-popup-close" aria-label="Close newsletter popup">&times;</button>
			<p class="nl-popup-title">Get Marketing & AI Insights</p>
			<p class="nl-popup-desc">Join the newsletter. No spam, just value.</p>
			<form class="nl-popup-form" id="nl-popup-form">
				<input type="email" name="email_address" placeholder="Your email" required autocomplete="email" aria-label="Email address" />
				<button type="submit">Subscribe</button>
			</form>
			<p class="nl-popup-status" id="nl-popup-status"></p>
		</div>

		<script>
			// Add "loaded" class once the document has completely loaded.
			addEventListener('load', () => document.documentElement.classList.add('loaded'));
		</script>

		<!-- Service Worker Registration.
		     Deferred to after `load`: registering during page load spawns the worker
		     and fires its install-time precache (4 extra requests) while the LCP image
		     is still in flight. Nothing on the first visit is served by the worker
		     anyway - it only controls subsequent navigations. -->
		<script is:inline>
			if ('serviceWorker' in navigator) {
				addEventListener('load', function () {
					navigator.serviceWorker.register('/sw.js');
				});
			}
		</script>

		<!-- Core Web Vitals are collected by the SpeedInsights component in the head
		     above, which reports LCP, CLS, INP, FCP and TTFB per route to Vercel. A
		     hand-rolled web-vitals module used to sit here measuring the same five a
		     second time and pushing them to dataLayer as a `web_vitals` event that no GTM
		     tag consumed. It compiled to its own chunk (5,927 bytes raw) which was the
		     748ms node setting max critical path latency in PageSpeed's dependency tree,
		     and one of only three module requests on the page. It was a deferred module,
		     so removing it does not move FCP or LCP; what it removes is one request,
		     roughly 6 KB of parse and evaluation, and a duplicate set of LCP/CLS/INP/FCP/
		     TTFB PerformanceObservers. If GA4 needs Core Web Vitals again, pull them from
		     CrUX in Looker Studio rather than re-adding a second in-page collector. -->

		<!-- Analytics Event Tracking -->
		<script is:inline>
		(function() {
			if (window._analyticsInit) return;
			window._analyticsInit = true;

			var dl = window.dataLayer = window.dataLayer || [];
			function track(event, params) {
				dl.push(Object.assign({ event: event }, params || {}));
			}

			// Click tracking (runs once, delegates via document)
			document.addEventListener('click', function(e) {
				var link = e.target.closest('a');
				if (!link) return;
				var href = link.getAttribute('href') || '';

				// Mailto CTA clicks
				if (href.indexOf('mailto:') === 0) {
					track('cta_click', { cta_type: 'email', cta_text: link.textContent.trim() });
				}

				// Share button clicks
				if (link.classList.contains('share-btn')) {
					var platform = 'unknown';
					var label = link.getAttribute('aria-label') || '';
					if (label.indexOf('Twitter') > -1) platform = 'twitter';
					else if (label.indexOf('LinkedIn') > -1) platform = 'linkedin';
					else if (label.indexOf('Facebook') > -1) platform = 'facebook';
					track('share_click', { share_platform: platform, share_url: window.location.pathname });
				}

				// Footer social links
				if (link.closest('footer') && link.getAttribute('target') === '_blank') {
					track('social_click', { social_platform: link.textContent.trim().toLowerCase(), social_url: href });
				}

				// CTA navigation buttons
				if (link.closest('.cta')) {
					track('cta_click', { cta_type: 'navigation', cta_text: link.textContent.trim(), cta_url: href });
				}
			});

			// Theme toggle tracking - only track actual user clicks, not initial load
			var lastTheme = document.documentElement.classList.contains('theme-dark') ? 'dark' : 'light';
			var pageReady = false;
			window.addEventListener('load', function() { pageReady = true; });
			var themeObs = new MutationObserver(function() {
				var isDark = document.documentElement.classList.contains('theme-dark');
				var newTheme = isDark ? 'dark' : 'light';
				if (!pageReady || newTheme === lastTheme) return;
				lastTheme = newTheme;
				track('theme_toggle', { theme: newTheme });
			});
			themeObs.observe(document.documentElement, { attributes: true, attributeFilter: ['class'] });

			// Blog reading-progress milestone state.
			//
			// This lives outside initPageTracking(), and the scroll listener is bound once
			// for the session, because .content-column is a different element after every
			// View Transition navigation. Binding per element meant the `_tracked` guard
			// never matched, so each blog-to-blog navigation stacked another live scroll
			// handler, all but the newest measuring a detached node.
			//
			// The measurement is deferred to the first scroll frame. This inline script is
			// the last thing in <body>, so its getBoundingClientRect() used to be the first
			// layout read in the document and the browser billed the whole initial layout to
			// it - PageSpeed reported a 52ms forced reflow at exactly this line. That layout
			// was discarded straight away by enhanceContent()'s DOM writes and the font swap,
			// so it bought nothing. Nothing needs these numbers until the reader scrolls, and
			// taking them inside the rAF that already throttles this handler gets a settled
			// layout for free.
			//
			// This only pays off together with the single rAF scroll frame in
			// blog/[...slug].astro. That file's bindToc() -> onScroll() is the other
			// pre-first-paint layout read; leave it synchronous and the same 52ms simply
			// gets re-attributed to the blog page chunk. Do not revert one without the other.
			//
			// The trade: once a blog post has been seen, a scroll and a resize listener stay
			// bound on window for the rest of the session, even on non-blog pages. Both
			// bodies are a flag check and an early return, which is cheaper than rebinding.
			var progressEl = null, progressMilestones = null;
			var progressTop = 0, progressHeight = 1, progressMeasured = false;
			var progressTicking = false, progressBound = false;

			function measureProgress() {
				var rect = progressEl.getBoundingClientRect();
				progressTop = rect.top + window.scrollY;
				progressHeight = rect.height || 1;
				progressMeasured = true;
			}

			function bindProgressScroll() {
				if (progressBound) return;
				progressBound = true;
				// Only invalidate on resize; re-measuring here would force a layout inside a
				// resize handler for numbers that are not read until the next scroll frame.
				window.addEventListener('resize', function() { progressMeasured = false; }, { passive: true });
				window.addEventListener('scroll', function() {
					if (progressTicking) return;
					progressTicking = true;
					requestAnimationFrame(function() {
						progressTicking = false;
						if (!progressEl || !progressMilestones) return;
						if (!progressMeasured) measureProgress();
						var scrollPos = window.scrollY + window.innerHeight - progressTop;
						var pct = Math.min(Math.round((scrollPos / progressHeight) * 100), 100);
						for (var m in progressMilestones) {
							if (!progressMilestones[m] && pct >= parseInt(m)) {
								progressMilestones[m] = true;
								track('blog_read_progress', { read_percent: parseInt(m), blog_title: document.title });
							}
						}
					});
				}, { passive: true });
			}

			// Re-init page-specific tracking on every navigation (View Transitions)
			function initPageTracking() {
				// Newsletter homepage form
				var nlForm = document.getElementById('newsletter-form');
				if (nlForm && !nlForm._tracked) {
					nlForm._tracked = true;
					nlForm.addEventListener('submit', function() {
						track('newsletter_signup', { signup_location: 'homepage' });
					});
				}

				// Newsletter popup form
				var nlPopup = document.getElementById('nl-popup-form');
				if (nlPopup && !nlPopup._tracked) {
					nlPopup._tracked = true;
					nlPopup.addEventListener('submit', function() {
						track('newsletter_signup', { signup_location: 'popup' });
					});
				}

				// Blog reading progress milestones.
				// The old selector ended in `|| document.querySelector('article')`, and on
				// the homepage that matched the first <article class="card"> rendered by
				// BlogPreview. So the homepage ran getBoundingClientRect() on a ~300px blog
				// card on every scroll frame - a forced layout, interleaved with the strand
				// ticker's per-frame SVG writes - and reported blog_read_progress against
				// that card. .content-column only exists in blog/[...slug].astro, which is
				// the only page this belongs on.
				var article = document.querySelector('.content-column');
				if (!article) {
					// Navigated to a non-blog page: drop the reference so the shared scroll
					// handler stops measuring the article we just left.
					progressEl = null;
					progressMilestones = null;
				} else if (!article._tracked) {
					article._tracked = true;
					progressEl = article;
					progressMilestones = { 25: false, 50: false, 75: false, 100: false };
					progressMeasured = false;
					bindProgressScroll();
				}
			}

			// Run on initial load and on every View Transition navigation
			initPageTracking();
			document.addEventListener('astro:page-load', initPageTracking);
		})();
		</script>

		<script is:inline>
			(function() {
				var popup = document.getElementById('nl-popup');
				var closeBtn = popup && popup.querySelector('.nl-popup-close');
				var form = document.getElementById('nl-popup-form');
				var statusEl = document.getElementById('nl-popup-status');
				if (!popup) return;
				if (localStorage.getItem('nl-popup-dismissed')) return;
				if (/[?&]nopopup\b/.test(location.search)) return;

				var shown = false;
				function showPopup() {
					if (shown) return;
					shown = true;
					popup.classList.add('visible');
				}
				function dismiss() {
					popup.classList.remove('visible');
					localStorage.setItem('nl-popup-dismissed', '1');
				}

				var scrollHandler = function() {
					var pct = (window.scrollY + window.innerHeight) / document.documentElement.scrollHeight;
					if (pct > 0.6) { showPopup(); window.removeEventListener('scroll', scrollHandler); }
				};
				window.addEventListener('scroll', scrollHandler, { passive: true });
				setTimeout(function() { showPopup(); window.removeEventListener('scroll', scrollHandler); }, 30000);

				if (closeBtn) closeBtn.addEventListener('click', dismiss);

				// Slide the popup away while the footer is on screen so it never covers the footer links.
				var footerEl = document.querySelector('footer');
				if (footerEl && 'IntersectionObserver' in window) {
					new IntersectionObserver(function(entries) {
						popup.classList.toggle('nl-popup--docked', entries[0].isIntersecting);
					}, { threshold: 0.05 }).observe(footerEl);
				}

				if (form) {
					form.addEventListener('submit', function(e) {
						e.preventDefault();
						var emailInput = form.querySelector('input[name="email_address"]');
						var email = emailInput ? emailInput.value : '';
						var btn = form.querySelector('button[type="submit"]');
						if (btn) { btn.textContent = 'Subscribing...'; btn.disabled = true; }
						var formData = new FormData();
						formData.append('email_address', email);
						fetch('https://app.kit.com/forms/9145889/subscriptions', {
							method: 'POST',
							body: formData,
							headers: { 'Accept': 'application/json' }
						}).then(function(res) {
							if (!res.ok) throw new Error('Subscription failed');
							if (statusEl) { statusEl.textContent = 'Subscribed!'; statusEl.style.color = 'var(--sg-ok)'; }
							form.reset();
							window.dataLayer = window.dataLayer || [];
							window.dataLayer.push({ event: 'newsletter_signup', signup_location: 'popup' });
							setTimeout(dismiss, 2000);
						}).catch(function() {
							if (statusEl) { statusEl.textContent = 'Something went wrong.'; statusEl.style.color = 'var(--accent-text)'; }
						}).finally(function() {
							if (btn) { btn.textContent = 'Subscribe'; btn.disabled = false; }
						});
					});
				}
			})();
		</script>

		<style>
			/* Newsletter Popup - floating surface, so --shadow-lg is allowed */
			.nl-popup {
				position: fixed;
				bottom: 1.5rem;
				right: 1.5rem;
				z-index: 9990;
				width: 320px;
				max-width: calc(100vw - 2rem);
				padding: 1.5rem;
				background: var(--sg-panel);
				border: 1px solid var(--sg-hair);
				border-radius: var(--radius-md);
				box-shadow: var(--shadow-lg);
				transform: translateY(120%);
				opacity: 0;
				transition: transform 0.4s var(--ease-out), opacity 0.3s ease;
				pointer-events: none;
			}

			.nl-popup.visible {
				transform: translateY(0);
				opacity: 1;
				pointer-events: auto;
			}

			.nl-popup.visible.nl-popup--docked {
				transform: translateY(120%);
				opacity: 0;
				pointer-events: none;
			}

			.nl-popup-close {
				position: absolute;
				top: 0.5rem;
				right: 0.75rem;
				background: none;
				border: none;
				color: var(--gray-400);
				font-family: var(--font-body);
				font-size: 1.5rem;
				cursor: pointer;
				line-height: 1;
				padding: 0.25rem;
			}

			.nl-popup-close:hover {
				color: var(--gray-0);
			}

			.nl-popup-title {
				font-family: var(--font-body);
				font-weight: 600;
				font-size: var(--text-md);
				letter-spacing: -0.01em;
				color: var(--gray-0);
				margin-bottom: 0.25rem;
			}

			.nl-popup-desc {
				font-size: var(--text-sm);
				color: var(--gray-400);
				margin-bottom: 0.75rem;
			}

			.nl-popup-form {
				display: flex;
				gap: 0.5rem;
			}

			.nl-popup-form input {
				flex: 1;
				padding: 0.5rem 0.75rem;
				border: 1px solid var(--gray-700);
				border-radius: var(--radius-sm);
				background: var(--sg-panel);
				color: var(--gray-0);
				font-size: var(--text-sm);
				font-family: var(--font-body);
				outline: none;
				min-width: 0;
				transition: border-color 0.2s var(--ease-out), box-shadow 0.2s var(--ease-out);
			}

			.nl-popup-form input:focus {
				border-color: var(--accent-regular);
				box-shadow: 0 0 0 3px var(--accent-overlay);
			}

			.nl-popup-form input::placeholder {
				color: var(--gray-600);
			}

			.nl-popup-form button {
				padding: 0.5rem 1rem;
				border: 1px solid var(--gray-0);
				border-radius: var(--radius-sm);
				background: var(--gray-0);
				color: var(--accent-text-over);
				font-size: var(--text-sm);
				font-weight: 500;
				font-family: var(--font-body);
				cursor: pointer;
				white-space: nowrap;
				transition: background-color 0.2s var(--ease-out), border-color 0.2s var(--ease-out), transform 0.2s var(--ease-out);
			}

			.nl-popup-form button:hover {
				background: var(--gray-100);
				border-color: var(--gray-100);
				transform: translateY(-1px);
			}

			.nl-popup-form button:disabled {
				opacity: 0.6;
				cursor: not-allowed;
				transform: none;
			}

			.nl-popup-status {
				font-size: var(--text-sm);
				margin-top: 0.5rem;
				min-height: 1rem;
			}

			@media (max-width: 480px) {
				.nl-popup {
					bottom: 0;
					right: 0;
					left: 0;
					width: 100%;
					max-width: 100%;
					border-radius: var(--radius-md) var(--radius-md) 0 0;
					transform: translateY(100%);
				}
			}

			/* Breadcrumb Navigation - mono meta */
			.breadcrumb-nav {
				max-width: 83rem;
				margin-inline: auto;
				padding: 1.25rem 1.5rem 0.75rem;
			}

			.breadcrumb-list {
				display: flex;
				flex-wrap: wrap;
				align-items: center;
				gap: 0;
				list-style: none;
				padding: 0;
				margin: 0;
				font-family: var(--font-mono);
				font-size: 0.75rem;
				color: var(--gray-400);
			}

			.breadcrumb-item {
				display: flex;
				align-items: center;
			}

			.breadcrumb-home {
				display: block;
			}

			.breadcrumb-item a {
				display: flex;
				align-items: center;
				color: var(--gray-400);
				text-decoration: none;
				transition: color 0.2s var(--ease-out);
			}

			.breadcrumb-item a:hover {
				color: var(--accent-text);
			}

			.breadcrumb-chevron {
				margin: 0 0.4rem;
				color: var(--gray-600);
				flex-shrink: 0;
			}

			.breadcrumb-current {
				color: var(--gray-200);
				font-weight: 500;
				max-width: 35ch;
				overflow: hidden;
				text-overflow: ellipsis;
				white-space: nowrap;
			}

			@media (max-width: 480px) {
				.breadcrumb-current {
					max-width: 20ch;
				}
			}

			.skip-link {
				position: absolute;
				top: -100%;
				left: 50%;
				transform: translateX(-50%);
				z-index: 10000;
				padding: 0.75rem 1.5rem;
				background: var(--gray-0);
				color: var(--accent-text-over);
				font-family: var(--font-body);
				font-weight: 500;
				font-size: 0.9375rem;
				border-radius: 0 0 var(--radius-sm) var(--radius-sm);
				text-decoration: none;
				transition: top 0.2s ease;
			}

			.skip-link:focus {
				top: 0;
			}

			/* Legacy background tokens - neutralized. index.astro / about.astro still
			   reference --bg-image-subtle-* / --bg-scale inside .with-background::before
			   (which both pages set to display: none). Kept so var() lookups resolve to
			   nothing visible; no image URLs are requested anymore. */
			:root {
				--_placeholder-bg: linear-gradient(transparent, transparent);
				--bg-image-main: var(--_placeholder-bg);
				--bg-image-main-curves: var(--_placeholder-bg);
				--bg-image-subtle-1: var(--_placeholder-bg);
				--bg-image-subtle-2: var(--_placeholder-bg);
				--bg-image-footer: var(--_placeholder-bg);
				--bg-svg-blend-mode: normal;
				--bg-blend-mode: normal;
				--bg-image-aspect-ratio: 2.25;
				--bg-scale: 1;
				--bg-aspect-ratio: calc(var(--bg-image-aspect-ratio) / var(--bg-scale));
				--bg-gradient-size: 100%;
			}

			/* Page canvas: plain paper with one barely-there cream wash at the top edge */
			.backgrounds {
				min-height: 100%;
				isolation: isolate;
				background:
					radial-gradient(60% 40% at 50% 0%, var(--gray-900), transparent 70%),
					var(--gray-999);
			}
			@media (forced-colors: active) {
