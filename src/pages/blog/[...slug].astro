---
import { type CollectionEntry, getCollection, render } from 'astro:content';

import ContactCTA from '../../components/ContactCTA.astro';
import Hero from '../../components/Hero.astro';
import Pill from '../../components/Pill.astro';
import ShareButtons from '../../components/ShareButtons.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { Image } from 'astro:assets';
import portraitImg from '../../assets/portrait-new.webp';

interface Props {
	entry: CollectionEntry<'blog'>;
}

export async function getStaticPaths() {
	const posts = await getCollection('blog');
	return posts.map((entry) => ({
		params: { slug: entry.id },
		props: { entry },
	}));
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);
const tocHeadings = headings.filter((h) => h.depth >= 2 && h.depth <= 3);

function categorySlug(cat: string): string {
	return cat
		.toLowerCase()
		.replace(/&/g, 'and')
		.replace(/[^a-z0-9]+/g, '-')
		.replace(/^-+|-+$/g, '');
}

// Reading time calculation
const wordCount = entry.body ? entry.body.split(/\s+/).length : 0;
const readingTime = Math.max(1, Math.ceil(wordCount / 220));

// Short articleBody excerpt for schema - strip markdown noise, cap at 300 chars.
const articleBodyExcerpt = entry.body
	? entry.body
			.replace(/```[\s\S]*?```/g, '')
			.replace(/\[([^\]]+)\]\([^)]+\)/g, '$1')
			.replace(/[#>*_`~\[\]|]/g, '')
			.replace(/\s+/g, ' ')
			.trim()
			.slice(0, 300)
	: entry.data.description;

// Format publish date
const dateFormatOptions: Intl.DateTimeFormatOptions = {
	year: 'numeric',
	month: 'long',
	day: 'numeric',
};
const publishDate = entry.data.publishDate.toLocaleDateString('en-US', dateFormatOptions);
const publishDateISO = entry.data.publishDate.toISOString();

// Only surface an "Updated" badge when the post has actually been revised after publish
const hasMeaningfulUpdate =
	entry.data.updatedDate &&
	entry.data.updatedDate.valueOf() > entry.data.publishDate.valueOf();
const updatedDate = hasMeaningfulUpdate
	? entry.data.updatedDate!.toLocaleDateString('en-US', dateFormatOptions)
	: null;
const updatedDateISO = hasMeaningfulUpdate ? entry.data.updatedDate!.toISOString() : null;

// Related posts (same category, excluding current)
const allPosts = await getCollection('blog');
const relatedPosts = allPosts
	.filter((p) => p.id !== entry.id && p.data.category.some((c) => entry.data.category.includes(c)))
	.sort((a, b) => {
		const aScore = a.data.category.filter((c) => entry.data.category.includes(c)).length;
		const bScore = b.data.category.filter((c) => entry.data.category.includes(c)).length;
		return bScore - aScore || b.data.publishDate.valueOf() - a.data.publishDate.valueOf();
	})
	.slice(0, 3);

const blogPostSchema = {
	"@context": "https://schema.org",
	"@type": "BlogPosting",
	"headline": entry.data.title,
	"description": entry.data.description,
	"image": `https://swapbiswas.com/og/${entry.id}.webp`,
	"datePublished": entry.data.publishDate.toISOString(),
	"dateModified": (entry.data.updatedDate || entry.data.publishDate).toISOString(),
	"author": { "@id": "https://swapbiswas.com/#person" },
	"publisher": { "@id": "https://swapbiswas.com/#person" },
	"mainEntityOfPage": {
		"@type": "WebPage",
		"@id": `https://swapbiswas.com/blog/${entry.id}/`
	},
	"url": `https://swapbiswas.com/blog/${entry.id}/`,
	"inLanguage": "en-US",
	"isAccessibleForFree": true,
	"wordCount": wordCount,
	"timeRequired": `PT${readingTime}M`,
	"articleSection": entry.data.category[0],
	"articleBody": articleBodyExcerpt,
	"keywords": entry.data.category.join(", "),
	"speakable": {
		"@type": "SpeakableSpecification",
		"cssSelector": [".description", ".content > p:first-of-type", ".faq-item:first-of-type .faq-answer"]
	}
};

const faqSchema = entry.data.faqs && entry.data.faqs.length > 0 ? {
	"@context": "https://schema.org",
	"@type": "FAQPage",
	"mainEntity": entry.data.faqs.map((faq) => ({
		"@type": "Question",
		"name": faq.q,
		"acceptedAnswer": {
			"@type": "Answer",
			"text": faq.a
		}
	}))
} : null;

const howToSchema = entry.data.howTo && entry.data.howTo.steps.length > 0 ? {
	"@context": "https://schema.org",
	"@type": "HowTo",
	"name": entry.data.howTo.name || entry.data.title,
	"description": entry.data.description,
	"image": `https://swapbiswas.com/og/${entry.id}.webp`,
	...(entry.data.howTo.totalTime && { "totalTime": entry.data.howTo.totalTime }),
	"step": entry.data.howTo.steps.map((step, index) => ({
		"@type": "HowToStep",
		"position": index + 1,
		"name": step.name,
		"text": step.text,
		"url": `https://swapbiswas.com/blog/${entry.id}/#step-${index + 1}`
	}))
} : null;
---

<BaseLayout
	title={entry.data.title}
	description={entry.data.description}
	image={`/og/${entry.id}.webp`}
	breadcrumbs={[{ name: "Blog", url: "/blog/" }, { name: entry.data.title }]}
	article={{
		publishedTime: entry.data.publishDate.toISOString(),
		modifiedTime: (entry.data.updatedDate || entry.data.publishDate).toISOString(),
		author: "https://swapbiswas.com/about/",
		tags: entry.data.category,
	}}
>
	<div class="reading-progress" aria-hidden="true"><div class="reading-progress-bar"></div></div>
	<script type="application/ld+json" is:inline set:html={JSON.stringify(blogPostSchema)} />
	{faqSchema && <script type="application/ld+json" is:inline set:html={JSON.stringify(faqSchema)} />}
	{howToSchema && <script type="application/ld+json" is:inline set:html={JSON.stringify(howToSchema)} />}
	<div class="stack gap-20">
		<div class="stack gap-15">
			<header>
				<div class="wrapper stack gap-2">
					<Hero title={entry.data.title} align="start">
						<div class="details">
							<div class="tags">
								{entry.data.category.map((cat) => (
									<Pill href={`/blog/category/${categorySlug(cat)}/`}>{cat}</Pill>
								))}
							</div>
							<div class="meta-line">
								<time datetime={publishDateISO} class="meta-item">
									<svg class="meta-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
									{publishDate}
								</time>
								<span class="meta-separator" aria-hidden="true"></span>
								<span class="meta-item">
									<svg class="meta-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
									{readingTime} min read
								</span>
								{updatedDate && (
									<>
										<span class="meta-separator" aria-hidden="true"></span>
										<time datetime={updatedDateISO!} class="updated-badge">
											<svg class="meta-icon" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="23 4 23 10 17 10"/><path d="M20.49 15a9 9 0 1 1-2.12-9.36L23 10"/></svg>
											Updated {updatedDate}
										</time>
									</>
								)}
							</div>
							<p class="description">{entry.data.description}</p>
						</div>
					</Hero>
				</div>
			</header>
			<main class="wrapper">
				<div class="blog-layout">
					{tocHeadings.length > 2 && (
						<aside class="toc-sidebar">
							<nav class="toc">
								<button class="toc-toggle" aria-expanded="false">
									<span class="toc-title">Table of Contents</span>
									<span class="toc-toggle-icon">+</span>
								</button>
								<ol class="toc-list">
									{tocHeadings.map((h) => (
										<li class:list={[`toc-item`, `depth-${h.depth}`]}>
											<a href={`#${h.slug}`}>{h.text}</a>
										</li>
									))}
								</ol>
							</nav>
						</aside>
					)}
					<div class="stack gap-10 content-column" data-pagefind-body>
						{/* sizes is derived, not guessed: .content-column is max-width min(66ch, 100%)
						   inside .wrapper (max-width 83rem, padding-inline 1.5rem), and the >=72em grid
						   still hands it min(66ch, calc(100% - 32rem)), so 66ch is the ceiling at every
						   breakpoint. 66ch of Inter at 17px measures 658px, which is exactly what PSI
						   reported. Below a 706px viewport the column is just the wrapper content box.
						   Every condition is viewport-only, so the preload scanner can pick a candidate
						   before layout and the LCP request is not delayed. The -400w and -660w files
						   come from the width ladder in src/pages/og/[...slug].webp.ts - this markup and
						   that route have to ship together, because a srcset candidate that 404s does
						   NOT fall back to src. */}
						<img
							src={`/og/${entry.id}.webp`}
							srcset={`/og/${entry.id}-400w.webp 400w, /og/${entry.id}-660w.webp 660w, /og/${entry.id}.webp 1200w`}
							sizes="(min-width: 45em) 660px, calc(100vw - 3rem)"
							alt={entry.data.img_alt || ''}
							width="1200"
							height="630"
							fetchpriority="high"
						/>
						<div class="content">
							<Content />
						</div>
						<ShareButtons title={entry.data.title} url={`https://swapbiswas.com/blog/${entry.id}/`} />

						<!-- FAQ Section -->
						{entry.data.faqs && entry.data.faqs.length > 0 && (
							<section class="faq-section" aria-labelledby="faq-heading">
								<h2 id="faq-heading" class="faq-heading">Frequently Asked Questions</h2>
								<div class="faq-list">
									{entry.data.faqs.map((faq, i) => (
										<details class="faq-item" open={i === 0}>
											<summary class="faq-question">
												<span>{faq.q}</span>
												<svg class="faq-chevron" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg>
											</summary>
											<p class="faq-answer">{faq.a}</p>
										</details>
									))}
								</div>
							</section>
						)}

						<!-- Author Bio -->
						<a href="/about/" class="author-bio">
							{/* portrait-new.webp is 1024x1280 and 79.9 KiB; .author-avatar paints it into
							   a 64px circle. densities (not widths) emits a 64px src plus 2x and 3x
							   candidates, about 8 KiB in total and content-hashed so they cache immutably.
							   The 3x rung is not padding: densities emits x descriptors, so the browser
							   picks purely on device pixel ratio and a ladder ending at 2x paints 128px
							   into a 192-device-pixel box on every flagship phone.
							   widths would additionally emit a full-size 1024px fallback that no srcset-
							   capable browser fetches, and would stamp width="1024" height="1280" on a
							   64px element. height={80} keeps the source's 4:5 ratio: Astro's sharp
							   service resizes by width alone when no fit is given, and .author-avatar's
							   object-fit: cover does the square crop, exactly as it does today. */}
							<Image
								src={portraitImg}
								alt="Swapnil Biswas"
								class="author-avatar"
								width={64}
								height={80}
								densities={[1, 2, 3]}
								loading="lazy"
								decoding="async"
							/>
							<div class="author-info">
								<p class="author-name">Written by <strong>Swapnil Biswas</strong></p>
								<p class="author-desc">Product Marketing & Growth Strategist. I write about AI, SEO, and marketing strategy from real experience - not theory.</p>
							</div>
						</a>

						<!-- Related Posts -->
						{relatedPosts.length > 0 && (
							<div class="related-posts">
								<h2>Related Articles</h2>
								<div class="related-grid">
									{relatedPosts.map((post) => (
										<a href={`/blog/${post.id}/`} class="related-card">
											{/* .related-grid is 3 columns from 50em inside the 658px content column with a
											   1rem gap, so a card box is (658 - 32) / 3 = 209px wide by 10rem tall. The
											   sizes value says 320px rather than 209px on purpose: object-fit: cover on a
											   1.90 source in a 1.30 box scales to cover the height, so the source is drawn
											   at about 305px wide even though the box is 209px. sizes ignores object-fit,
											   so the crop has to be built into the number or the cards go soft. */}
											<img
												src={`/og/${post.id}.webp`}
												srcset={`/og/${post.id}-400w.webp 400w, /og/${post.id}-660w.webp 660w, /og/${post.id}.webp 1200w`}
												sizes="(min-width: 50em) 320px, (min-width: 45em) 660px, calc(100vw - 3rem)"
												alt={post.data.title}
												width="1200"
												height="630"
												loading="lazy"
												decoding="async"
											/>
											<span class="related-title">{post.data.title}</span>
										</a>
									))}
								</div>
							</div>
						)}
					</div>
				</div>
			</main>
		</div>
		<ContactCTA />
	</div>

	<!-- Back to top button -->
	<button class="back-to-top" aria-label="Back to top" title="Back to top">&#8593;</button>
</BaseLayout>

<style>
	/* Reading Progress Bar */
	.reading-progress {
		position: fixed;
		top: 0;
		left: 0;
		width: 100%;
		height: 3px;
		z-index: 9998;
		background: transparent;
	}

	.reading-progress-bar {
		height: 100%;
		/* Full width scaled down, rather than a percentage width. Progress used to be
		   written as `width: N%` against `transition: width 0.1s linear`, so every scroll
		   event started a fresh main-thread transition that re-ran layout and paint on a
		   fixed element stacked above the whole page, and kept repainting for 100ms after
		   the scroll stopped. The pending width change also dirtied layout, which forced
		   the next scroll listener's getBoundingClientRect to flush a synchronous one.
		   scaleX is handled by the compositor and invalidates no layout, which is also
		   what "Avoid non-composited animations" was flagging. width:100% with a left
		   transform-origin renders identically to the old width:0-to-100%. */
		width: 100%;
		transform: scaleX(0);
		transform-origin: 0 50%;
		background: var(--accent-regular);
		transition: transform 0.1s linear;
		/* The transition retriggers on nearly every frame while scrolling, so hold the
		   compositor layer open rather than promoting and demoting it each time. The
		   layer is a 3px strip, so the memory cost is negligible. */
		will-change: transform;
	}

	/* Meta line (date, reading time, updated) */
	.meta-line {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.625rem;
		color: var(--gray-400);
		font-family: var(--font-mono);
		font-size: 0.8125rem;
		line-height: 1.4;
	}

	.meta-item {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		white-space: nowrap;
	}

	.meta-icon {
		opacity: 0.75;
		flex-shrink: 0;
	}

	.meta-separator {
		width: 3px;
		height: 3px;
		border-radius: 50%;
		background: var(--gray-600);
		opacity: 1;
	}

	.updated-badge {
		display: inline-flex;
		align-items: center;
		gap: 0.35rem;
		padding: 0.2rem 0.65rem;
		font-size: 0.75rem;
		font-weight: 500;
		font-family: var(--font-mono);
		border-radius: var(--radius-xs);
		background: var(--accent-subtle-overlay);
		border: 1px solid var(--sg-hair);
		color: var(--accent-text);
		white-space: nowrap;
		letter-spacing: 0.01em;
	}

	header {
		padding-bottom: 2.5rem;
		border-bottom: 1px solid var(--sg-hair);
	}

	.details {
		display: flex;
		flex-direction: column;
		padding: 0.5rem;
		gap: 1.5rem;
		justify-content: space-between;
		align-items: center;
	}

	.tags {
		display: flex;
		gap: 0.5rem;
	}

	.description {
		font-size: 1.125rem;
		line-height: 1.6;
		color: var(--gray-300);
		max-width: 54ch;
	}

	/* Blog Layout */
	.blog-layout {
		position: relative;
		/* clip (not hidden) so it does not become a scroll container and break the
		   sticky TOC sidebar on desktop. */
		overflow-x: clip;
	}

	/* Table of Contents - Sidebar */
	.toc-sidebar {
		margin-bottom: 1.5rem;
	}

	.toc {
		padding: 1rem 1.25rem;
		border: 1px solid var(--sg-hair);
		border-radius: var(--radius-md);
		background: var(--sg-panel);
		margin-inline: 0.5rem;
	}

	@media (min-width: 50em) {
		.toc {
			margin-inline: 0;
		}
	}

	.toc-toggle {
		display: flex;
		align-items: center;
		justify-content: space-between;
		width: 100%;
		background: none;
		border: none;
		padding: 0;
		cursor: pointer;
		color: inherit;
	}

	.toc-title {
		font-size: var(--text-xs);
		font-family: var(--font-mono);
		font-weight: 500;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: var(--gray-0);
	}

	.toc-toggle-icon {
		font-family: var(--font-mono);
		font-size: var(--text-lg);
		color: var(--gray-300);
		transition: transform 0.2s ease;
		line-height: 1;
	}

	.toc-sidebar.toc-open .toc-toggle-icon {
		transform: rotate(45deg);
	}

	.toc-list {
		list-style: none;
		padding: 0;
		margin: 0;
		border-left: 1px solid var(--sg-hair);
		max-height: 0;
		overflow: hidden;
		transition: max-height 0.3s ease, margin-top 0.3s ease;
		margin-top: 0;
	}

	.toc-sidebar.toc-open .toc-list {
		max-height: 80vh;
		margin-top: 0.75rem;
		overflow-y: auto;
		padding-right: 0.35rem;
	}

	.toc-item a {
		display: block;
		padding: 0.35rem 0 0.35rem 1rem;
		margin-left: -1px;
		border-left: 2px solid transparent;
		color: var(--gray-400);
		font-family: var(--font-body);
		font-weight: 500;
		font-size: var(--text-sm);
		text-decoration: none;
		transition: color 0.2s ease, border-color 0.2s ease;
	}

	.toc-item a:hover {
		color: var(--gray-0);
	}

	.toc-item.active > a {
		color: var(--accent-text);
		border-left-color: var(--accent-regular);
	}

	.toc-item.depth-3 a {
		padding-left: 2rem;
		font-size: 0.8rem;
	}

	.content-column {
		max-width: min(66ch, 100%);
		margin-inline: auto;
		min-width: 0;
	}

	.content {
		max-width: 100%;
		margin-inline: auto;
		overflow-wrap: break-word;
		word-break: break-word;
		font-family: var(--font-body);
		font-size: 1.0625rem;
		line-height: 1.65;
		color: var(--gray-200);
	}

	.content :global(h2),
	.content :global(h3) {
		font-family: var(--font-display);
		font-weight: 600;
		color: var(--gray-100);
	}

	.content :global(h2) {
		font-size: clamp(1.75rem, 3vw, 2.25rem);
		line-height: 1.1;
		letter-spacing: -0.02em;
	}

	.content :global(h3) {
		font-size: clamp(1.375rem, 2.2vw, 1.625rem);
		line-height: 1.15;
		letter-spacing: -0.01em;
	}

	.content :global(h4),
	.content :global(h5) {
		font-family: var(--font-body);
		font-weight: 600;
		color: var(--gray-100);
	}

	/* Hero image (OG render at the top of the article) */
	.content-column > :global(img:first-child) {
		width: 100%;
		height: auto;
		border-radius: var(--radius-md);
		border: 1px solid var(--sg-hair);
		box-shadow: none;
	}

	.content :global(table) {
		display: table;
		border-collapse: collapse;
		min-width: 100%;
		border: 1px solid var(--sg-hair);
		border-radius: var(--radius-sm);
		font-size: var(--text-sm);
	}

	/* Wrap tables in a scrollable container via JS */
	.content :global(.table-wrap) {
		overflow-x: auto;
		-webkit-overflow-scrolling: touch;
		border-radius: var(--radius-sm);
		margin-top: 1rem;
		margin-bottom: 1rem;
	}

	.content :global(thead) {
		background: var(--gray-900);
	}

	.content :global(th) {
		padding: 0.75rem 1rem;
		text-align: left;
		font-weight: 600;
		color: var(--gray-0);
		border-bottom: 1px solid var(--gray-700);
		white-space: nowrap;
	}

	.content :global(td) {
		padding: 0.75rem 1rem;
		color: var(--gray-200);
		border-bottom: 1px solid var(--sg-hair);
		min-width: 6rem;
	}

	.content :global(td:first-child),
	.content :global(th:first-child) {
		min-width: 8rem;
	}

	.content :global(tbody tr:hover) {
		background: var(--gray-999);
	}

	.content :global(tbody tr:last-child td) {
		border-bottom: none;
	}

	.content :global(pre) {
		position: relative;
		overflow-x: auto;
		padding: 1.25rem 1.5rem;
		border-radius: var(--radius-sm);
		border: 1px solid var(--sg-hair);
		background: var(--gray-900);
		font-family: var(--font-mono);
		font-size: var(--text-sm);
		line-height: 1.7;
	}

	/* Shiki dual themes (astro.config: themes light/dark, defaultColor:false) */
	.content :global(.astro-code),
	.content :global(pre.astro-code) {
		background-color: var(--gray-900) !important;
		color: var(--shiki-light);
	}

	.content :global(.astro-code span) {
		color: var(--shiki-light);
	}

