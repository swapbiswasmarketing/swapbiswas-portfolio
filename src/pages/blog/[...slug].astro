	.faq-answer {
		padding: 0 1.25rem 1.25rem;
		margin: 0;
		font-size: var(--text-sm);
		line-height: 1.7;
		color: var(--gray-300);
	}

	/* Author Bio */
	.author-bio {
		display: flex;
		gap: 1rem;
		align-items: center;
		padding: 1.5rem;
		border: 1px solid var(--gray-800);
		border-radius: 1rem;
		background: var(--gradient-subtle);
		text-decoration: none;
		transition: box-shadow var(--theme-transition);
	}

	.author-bio:hover {
		box-shadow: var(--shadow-md);
	}

	.author-avatar {
		width: 64px;
		height: 64px;
		border-radius: 50%;
		object-fit: cover;
		flex-shrink: 0;
	}

	.author-info {
		display: flex;
		flex-direction: column;
		gap: 0.25rem;
	}

	.author-name {
		font-size: var(--text-md);
		color: var(--gray-200);
		margin: 0;
	}

	.author-desc {
		font-size: var(--text-sm);
		color: var(--gray-400);
		margin: 0;
		line-height: 1.5;
	}

	/* Related Posts */
	.related-posts {
		margin-top: 1rem;
	}

	.related-posts h2 {
		font-size: var(--text-xl);
		margin-bottom: 1rem;
	}

	.related-grid {
		display: grid;
		grid-template-columns: 1fr;
		gap: 1rem;
	}

	.related-card {
		display: block;
		border: 1px solid var(--gray-800);
		border-radius: 0.75rem;
		overflow: hidden;
		text-decoration: none;
		transition: box-shadow var(--theme-transition);
	}

	.related-card:hover {
		box-shadow: var(--shadow-md);
	}

	.related-card img {
		width: 100%;
		height: 10rem;
		object-fit: cover;
		border-radius: 0;
		border: none;
		box-shadow: none;
		background: none;
	}

	.related-title {
		display: block;
		padding: 0.75rem 1rem;
		font-size: var(--text-sm);
		font-weight: 500;
		color: var(--gray-200);
		font-family: var(--font-brand);
	}

	@media (min-width: 50em) {
		.related-grid {
			grid-template-columns: repeat(3, 1fr);
		}
	}

	/* Back to top button */
	:global(.back-to-top) {
		position: fixed;
		bottom: 2rem;
		right: 2rem;
		z-index: 100;
		width: 3rem;
