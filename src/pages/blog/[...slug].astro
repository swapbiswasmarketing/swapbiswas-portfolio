	.content :global(li.task-list-item:has(input:checked)) {
		opacity: 0.55;
		text-decoration: line-through;
		text-decoration-color: var(--gray-500);
	}

	@media (min-width: 50em) {
		.details {
			flex-direction: row;
			gap: 2.5rem;
		}

		.content :global(blockquote) {
			font-size: var(--text-lg);
		}
