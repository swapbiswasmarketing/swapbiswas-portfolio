	@media (min-width: 72em) {
		/* Centred article with the TOC floating in the LEFT gutter: a 3-column grid
		   (gutter | centred content | gutter). The content column is centred on the
		   page; the sticky TOC sits in the left gutter and never overlaps the text.
		   calc(100% - 32rem) reserves >=16rem per gutter so the TOC always has room. */
		.blog-layout {
			display: grid;
			grid-template-columns: 1fr min(66ch, calc(100% - 32rem)) 1fr;
			align-items: start;
		}
		.content-column {
			grid-column: 2;
		}
		.toc-sidebar {
			grid-column: 1;
			justify-self: end;
			align-self: start;
			position: sticky;
			top: 5rem;
			width: 15rem;
			margin-right: clamp(1.5rem, 3vw, 3rem);
			margin-bottom: 0;
			opacity: 1;
			pointer-events: auto;
			transition: opacity 0.3s ease;
		}

		.toc-toggle-icon {
			display: none;
		}

		.toc-toggle {
			cursor: default;
		}

		.toc {
			border: none;
			border-radius: 0;
			background: none;
			padding: 0;
			margin-inline: 0;
		}

		.toc-list {
			margin-top: 0.75rem;
			max-height: calc(100vh - 10rem);
			overflow-y: auto;
			padding-right: 0.5rem;
			/* Keeps an entry off the cut edge when it is scrolled into view. */
			scroll-padding-block: 0.875rem;
		}

		/* Fade whichever edge is actually cut, so a half-visible entry reads as
		   "more above/below" instead of text sliced under the heading. */
		.toc-list.is-clipped-top {
			-webkit-mask-image: linear-gradient(to bottom, transparent 0, #000 1.5rem);
			mask-image: linear-gradient(to bottom, transparent 0, #000 1.5rem);
		}

		.toc-list.is-clipped-bottom {
			-webkit-mask-image: linear-gradient(to top, transparent 0, #000 1.5rem);
			mask-image: linear-gradient(to top, transparent 0, #000 1.5rem);
		}

		.toc-list.is-clipped-top.is-clipped-bottom {
			-webkit-mask-image: linear-gradient(to bottom, transparent 0, #000 1.5rem, #000 calc(100% - 1.5rem), transparent 100%);
			mask-image: linear-gradient(to bottom, transparent 0, #000 1.5rem, #000 calc(100% - 1.5rem), transparent 100%);
		}

		/* Thin scrollbar for TOC */
		.toc::-webkit-scrollbar,
		.toc-list::-webkit-scrollbar {
			width: 3px;
		}

		.toc::-webkit-scrollbar-track,
		.toc-list::-webkit-scrollbar-track {
			background: transparent;
		}

		.toc::-webkit-scrollbar-thumb,
