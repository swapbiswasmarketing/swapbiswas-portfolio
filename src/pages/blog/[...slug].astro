<script>
	// These are re-resolved on every View Transition navigation. They cannot be `const`
	// bound once at module scope: with the ClientRouter a bundled module script runs a
	// single time, so after an in-site navigation the old references point at a detached
	// document and the TOC silently stops tracking. See bindToc() at the bottom.
	let tocSidebar: HTMLElement | null = null;
	let contentEl: HTMLElement | null = null;
	let tocToggle: HTMLButtonElement | null = null;
	let tocItems: NodeListOf<Element> | Element[] = [];
	let headings: { item: Element; el: HTMLElement | null }[] = [];
	const isDesktop = () => window.matchMedia('(min-width: 72em)').matches;

	function refreshTocRefs() {
		tocSidebar = document.querySelector('.toc-sidebar');
		contentEl = document.querySelector('.content');
		tocToggle = document.querySelector('.toc-toggle');
		tocItems = document.querySelectorAll('.toc-item');

		headings = Array.from(tocItems).map((item) => {
			const link = item.querySelector('a');
			const id = link?.getAttribute('href')?.slice(1);
			return { item, el: id ? document.getElementById(id) : null };
		}).filter((h) => h.el);

		// Mobile TOC toggle. The _tocBound flag keeps a second navigation from stacking
		// a duplicate listener on the same element.
		if (tocToggle && tocSidebar && !(tocToggle as any)._tocBound) {
			(tocToggle as any)._tocBound = true;
			const sidebar = tocSidebar;
			const toggle = tocToggle;
			toggle.addEventListener('click', () => {
				if (isDesktop()) return;
				const isOpen = sidebar.classList.toggle('toc-open');
				toggle.setAttribute('aria-expanded', String(isOpen));
			});

			// Close TOC when a link is clicked on mobile
			sidebar.querySelectorAll('.toc-item a').forEach((link) => {
				link.addEventListener('click', () => {
					if (!isDesktop()) {
						sidebar.classList.remove('toc-open');
						toggle.setAttribute('aria-expanded', 'false');
					}
				});
			});
		}
	}

	// The sticky two-column grid handles TOC placement now; clear any stale inline
	// left from earlier (the old position:fixed sidebar set it manually).
	function positionToc() {
		if (tocSidebar) tocSidebar.style.left = '';
	}

	// ---------------------------------------------------------------------------
	// Scroll pipeline.
	//
	// Everything on this page that reacts to scroll - the TOC active heading, the
	// TOC's scroll-into-view and edge fades, the reading progress bar and the
	// back-to-top button - is driven by ONE passive listener whose only job is to
	// schedule a frame. Inside that frame every layout read happens first and every
	// style write second, so a frame can never force a second layout.
	//
	// What this replaced: three unthrottled scroll listeners. Per scroll event they
	// read getBoundingClientRect() on all 7 TOC headings, wrote the .active class
	// onto 8 list items, then read list.scrollHeight / clientHeight / two rects (a
	// forced layout, because those class writes had just dirtied style), toggled two
	// more classes, then read .content's rect and offsetHeight (a second forced
	// layout) and wrote bar.style.width. Three synchronous layouts per event.
	//
	// The measurements are all scroll-independent - a heading's distance from the top
	// of the document, and a link's offset inside the TOC's scroll box, do not change
	// as the window scrolls - so they are taken once and reused. The only live reads
	// left are window.scrollY, window.innerHeight and the TOC list's own scrollTop,
	// all taken at the top of the frame while layout is still clean from the previous
	// paint, which makes them free.
	//
	// The other half of this fix is in BaseLayout.astro, where the read-progress
	// tracker's getBoundingClientRect() was the first layout read in the document.
	// Both were pre-first-paint reads, so leaving either one synchronous just makes
	// PageSpeed re-attribute the same 52ms forced reflow to the other. Do not revert
	// one without the other.
	// ---------------------------------------------------------------------------

	// Cached geometry. metricsDirty is set on bind, on resize, and by a ResizeObserver
	// on the article - which covers everything that actually moves a heading: the font
	// swap, a lazily loaded image that did not reserve space, enhanceContent() wrapping
	// tables, and an FAQ <details> being opened. Nothing the write phase touches
	// changes the article's height, so the observer cannot feed back on itself.
	let metricsDirty = true;
	let headingTops: number[] = [];
	let tocLinkOffsets: { top: number; height: number }[] = [];
	let tocScrollMax = 0;
	let tocClientHeight = 0;
	let tocOverflows = false;
	let contentTop = 0;
	let contentHeight = 0;
	let tocList: HTMLElement | null = null;
	let progressBar: HTMLElement | null = null;
	let backToTopBtn: Element | null = null;
	let contentResizeObs: ResizeObserver | null = null;

	// Last values written, so the write phase can skip a no-op. A View Transition hands
	// us a DOM with none of these applied, so bindToc() resets them.
	let lastActive = -1;
	let lastProgress = -1;
	let lastBackToTop = false;
	let lastClipTop = false;
	let lastClipBottom = false;
	let mobileStylesCleared = false;

	function measureLayout() {
		metricsDirty = false;
		const scrollY = window.scrollY;

		headingTops = headings.map((h) => h.el!.getBoundingClientRect().top + scrollY);

		if (tocList) {
			tocClientHeight = tocList.clientHeight;
			const scrollHeight = tocList.scrollHeight;
			tocOverflows = scrollHeight > tocClientHeight + 1;
			tocScrollMax = scrollHeight - tocClientHeight;
			// Origin of the list's scrollable content in viewport coordinates. A link's
			// offset within that content is (linkTop - origin), which is what the old code
			// computed live as linkBox.top - listBox.top + list.scrollTop.
			const listOrigin = tocList.getBoundingClientRect().top - tocList.scrollTop;
			tocLinkOffsets = headings.map((h) => {
				const link = h.item.querySelector('a') as HTMLElement | null;
				if (!link) return { top: 0, height: 0 };
				const box = link.getBoundingClientRect();
				return { top: box.top - listOrigin, height: box.height };
			});
		} else {
			tocOverflows = false;
			tocScrollMax = 0;
			tocClientHeight = 0;
			tocLinkOffsets = [];
		}

		if (contentEl) {
			contentTop = contentEl.getBoundingClientRect().top + scrollY;
			contentHeight = contentEl.offsetHeight;
		}
	}

	// Two entry points share the frame. A window scroll or resize runs the whole
	// pipeline; a scroll of the TOC list itself repaints only the edge fades, because
	// running the scroll-into-view branch there would pull the list back to the active
	// item while the reader is browsing it.
	let frameQueued = false;
	let wantFull = false;

	function scheduleFrame(full: boolean) {
		if (full) wantFull = true;
		if (frameQueued) return;
		frameQueued = true;
		requestAnimationFrame(runFrame);
	}

	function runFrame() {
		frameQueued = false;
		const full = wantFull;
		wantFull = false;
		// Guard on the article only, not on the sidebar. .toc-sidebar is rendered only
		// when a post has more than two h2/h3 headings, and the progress bar and the
		// back-to-top button have to keep working on a post that has no TOC.
		if (!contentEl) return;

		// ---- read phase ------------------------------------------------------
		if (metricsDirty) measureLayout();
		const scrollY = window.scrollY;
		const viewportH = window.innerHeight;
		const listScrollTop = tocList ? tocList.scrollTop : 0;
		const desktop = isDesktop();

		// ---- write phase -----------------------------------------------------
		if (full) {
			// Mobile: clear inline styles left by a previous desktop layout. Once per
			// bind is enough; the old code rewrote them on every scroll event.
			if (!desktop && !mobileStylesCleared && tocSidebar) {
				mobileStylesCleared = true;
				tocSidebar.style.opacity = '';
				tocSidebar.style.pointerEvents = '';
				tocSidebar.style.left = '';
			}

			// Active heading: the last one whose top has passed y=120, defaulting to the
			// first. Identical test to the old h.el.getBoundingClientRect().top <= 120,
			// just against a cached document-relative top instead of a fresh layout read.
			let active = headings.length ? 0 : -1;
			for (let i = 0; i < headingTops.length; i++) {
				if (headingTops[i] - scrollY <= 120) active = i;
				else break;
			}
			if (active !== lastActive) {
				lastActive = active;
				tocItems.forEach((item) => item.classList.remove('active'));
				if (active >= 0) headings[active].item.classList.add('active');
			}

			// Desktop: keep the active TOC item in view. Scroll the list itself rather
			// than calling scrollIntoView, which also scrolls every scrollable ancestor
			// (including the window) and fights the sticky sidebar. The EDGE_PAD keeps an
			// entry from sitting half-clipped against the top or bottom edge, which reads
			// as broken text tucked under the "Table of Contents" heading. This still runs
			// every frame, not just when the active item changes, so a reader who scrolls
			// the list away from the active entry gets pulled back exactly as before - it
			// is pure arithmetic now, so running it every frame costs nothing.
			if (desktop && tocList && tocOverflows && active >= 0 && tocLinkOffsets[active]) {
				const EDGE_PAD = 14;
				const itemTop = tocLinkOffsets[active].top;
				const itemBottom = itemTop + tocLinkOffsets[active].height;
				let target: number | null = null;
				if (itemTop - EDGE_PAD < listScrollTop) {
					target = itemTop - EDGE_PAD;
				} else if (itemBottom + EDGE_PAD > listScrollTop + tocClientHeight) {
					target = itemBottom + EDGE_PAD - tocClientHeight;
				}
				if (target !== null) {
					const clamped = Math.max(0, Math.min(target, tocScrollMax));
					if (Math.abs(clamped - listScrollTop) > 1) {
						tocList.scrollTo({ top: clamped, behavior: 'smooth' });
					}
				}
			}

			// Reading progress. Rounding to 0.1% skips the write entirely when nothing
			// visible changed, which is most frames of a slow scroll.
			if (progressBar) {
				const scrollable = contentHeight - viewportH;
				const progress = scrollable <= 0
					? 0
					: Math.min(100, Math.max(0, ((scrollY - contentTop) / scrollable) * 100));
				const rounded = Math.round(progress * 10) / 10;
				if (rounded !== lastProgress) {
					lastProgress = rounded;
					progressBar.style.transform = 'scaleX(' + rounded / 100 + ')';
				}
			}

			// Back to top
			const showTop = scrollY > 400;
			if (showTop !== lastBackToTop) {
				lastBackToTop = showTop;
				backToTopBtn?.classList.toggle('visible', showTop);
			}
		}

		// Fade whichever edge of the TOC is actually cut, so a partially scrolled entry
		// degrades gracefully instead of being sliced through the middle of a line.
		if (tocList) {
			const clipTop = tocOverflows && listScrollTop > 1;
			const clipBottom = tocOverflows && listScrollTop < tocScrollMax - 1;
			if (clipTop !== lastClipTop) {
				lastClipTop = clipTop;
				tocList.classList.toggle('is-clipped-top', clipTop);
			}
			if (clipBottom !== lastClipBottom) {
				lastClipBottom = clipBottom;
				tocList.classList.toggle('is-clipped-bottom', clipBottom);
			}
		}
	}

	// Re-resolve the TOC for the page currently on screen. Runs on first load and again
	// after every View Transition navigation, because the bundled module script itself
	// only executes once per full page load.
	function bindToc() {
		refreshTocRefs();
		tocList = tocSidebar ? tocSidebar.querySelector('.toc-list') : null;
		progressBar = document.querySelector('.reading-progress-bar') as HTMLElement | null;
		// Document order puts this page's floating button before the footer's own
		// .back-to-top, which is what the old querySelector already relied on.
		backToTopBtn = document.querySelector('.back-to-top');

		// Keep the edge fades correct when the reader scrolls the TOC itself.
		if (tocList && !(tocList as any)._tocScrollBound) {
			(tocList as any)._tocScrollBound = true;
			tocList.addEventListener('scroll', () => scheduleFrame(false), { passive: true });
		}

		// A View Transition hands us a fresh DOM with none of our classes or inline
		// styles applied, so forget what was written to the previous page's elements.
		metricsDirty = true;
		lastActive = -1;
		lastProgress = -1;
		lastBackToTop = false;
		lastClipTop = false;
		lastClipBottom = false;
		mobileStylesCleared = false;

		// Re-point the invalidation observer at this page's article. Anything that
		// changes the article's height moves the headings the TOC tracks - and so does
		// anything that changes the height of something ABOVE it, which resizes neither
		// .content nor .content-column: the mobile TOC drawer opening (+458px) and an ad
		// slot injected above the article are both invisible to an observer on those two.
		// document.body's height moves for all of them, so observe it as well. The
		// ClientRouter swaps document.body on every navigation, hence re-observing here.
		// Still no feedback loop: the write phase only sets a transform on a fixed 3px
		// bar, toggles colour-only classes and writes an element's own scrollTop, none of
		// which changes any layout box height.
		if ('ResizeObserver' in window) {
			if (!contentResizeObs) {
				contentResizeObs = new ResizeObserver(() => {
					metricsDirty = true;
					scheduleFrame(true);
				});
			}
			contentResizeObs.disconnect();
			if (contentEl) contentResizeObs.observe(contentEl);
			const column = document.querySelector('.content-column');
			if (column) contentResizeObs.observe(column);
			contentResizeObs.observe(document.body);
		}

		positionToc();
		// Scheduled, not called inline. The old code ran onScroll() here during initial
		// script execution, before the browser had laid the page out even once, so its
		// getBoundingClientRect() calls forced that first layout synchronously - and it
		// was thrown away moments later by enhanceContent()'s DOM writes and the font
		// swap. A frame here measures once, after first paint, against settled layout.
		scheduleFrame(true);
	}

	bindToc();
	document.addEventListener('astro:page-load', bindToc);

	// One window scroll listener drives the whole page. Its body is a flag check and a
	// rAF schedule; all the work is in runFrame(). Window listeners survive View
	// Transitions, so this is bound once for the session.
	if (!(window as any)._blogScrollBound) {
		(window as any)._blogScrollBound = true;
		window.addEventListener('scroll', () => scheduleFrame(true), { passive: true });
		window.addEventListener('resize', () => {
			metricsDirty = true;
			mobileStylesCleared = false;
			positionToc();
			scheduleFrame(true);
		}, { passive: true });
	}

	// ---------------------------------------------------------------------------
	// Content enhancements.
	//
	// Everything below has to run again after every View Transition navigation,
	// because the bundled module script itself executes only once per full load.
	// Two rules keep that safe:
	//   1. DOM creation here is idempotent - each step checks whether it already ran.
	//   2. Interaction is handled by delegated listeners on `document`, bound once.
	//      Delegation survives any number of body swaps, so no per-element listener
	//      can go stale or get stacked twice.
	// ---------------------------------------------------------------------------

	function getLightbox(): { box: HTMLElement; img: HTMLImageElement } {
		// The ClientRouter swaps the body, so a previously appended lightbox may be gone.
		let box = document.querySelector('.lightbox') as HTMLElement | null;
		if (!box) {
			box = document.createElement('div');
			box.className = 'lightbox';
			const img = document.createElement('img');
			img.alt = 'Enlarged image';
			box.appendChild(img);
			document.body.appendChild(box);
		}
		return { box, img: box.querySelector('img') as HTMLImageElement };
	}

	function closeLightbox() {
		document.querySelector('.lightbox')?.classList.remove('active');
	}

	function enhanceContent() {
		// Anchor links on headings
		document.querySelectorAll('.content h2[id], .content h3[id]').forEach((heading) => {
			const id = heading.getAttribute('id');
			if (!id || heading.querySelector('.heading-anchor')) return;
			const anchor = document.createElement('a');
			anchor.className = 'heading-anchor';
			anchor.href = `#${id}`;
			anchor.setAttribute('aria-label', `Copy link to ${heading.textContent}`);
			anchor.textContent = '#';
			heading.prepend(anchor);
		});

		// Wrap tables in a scrollable container. Skip any table already wrapped,
		// otherwise a second navigation nests wrappers inside wrappers.
		document.querySelectorAll('.content table').forEach((table) => {
			if ((table.parentElement as HTMLElement | null)?.classList.contains('table-wrap')) return;
			const tableWrap = document.createElement('div');
			tableWrap.className = 'table-wrap';
			table.parentNode!.insertBefore(tableWrap, table);
			tableWrap.appendChild(table);
		});

		// Copy button on code blocks, one per <pre>
		document.querySelectorAll('.content pre').forEach((pre) => {
			if (pre.querySelector('.copy-btn')) return;
			const btn = document.createElement('button');
			btn.className = 'copy-btn';
			btn.textContent = 'Copy';
			pre.appendChild(btn);
		});

		// The lightbox is NOT built here. It used to be created on every page load and
		// every View Transition navigation, which put a full-viewport fixed node and an
		// <img> with no src into the render tree of every post - and PageSpeed listed that
		// srcless image under "Image elements do not have explicit width and height".
		// getLightbox() is idempotent, so the click handler below builds it on first use.

		// Interactive task-list checkboxes with per-post localStorage persistence
		const taskBoxes = document.querySelectorAll<HTMLInputElement>('li.task-list-item input[type="checkbox"]');
		if (taskBoxes.length > 0) {
			const slug = location.pathname.replace(/^\/blog\//, '').replace(/\/$/, '') || 'index';
			const storageKey = 'checklist:' + slug;
			let saved: Record<string, boolean> = {};
			try { saved = JSON.parse(localStorage.getItem(storageKey) || '{}'); } catch {}
			taskBoxes.forEach((cb, idx) => {
				cb.removeAttribute('disabled');
				cb.disabled = false;
				const key = String(idx);
				if (saved[key]) cb.checked = true;
				if ((cb as any)._taskBound) return;
				(cb as any)._taskBound = true;
				cb.addEventListener('change', () => {
					// Re-read before writing: another tab may have changed the same key.
					try { saved = JSON.parse(localStorage.getItem(storageKey) || '{}'); } catch {}
					saved[key] = cb.checked;
					try { localStorage.setItem(storageKey, JSON.stringify(saved)); } catch {}
				});
			});
		}
	}

	enhanceContent();
	// The scroll pipeline above owns the reading progress bar and the back-to-top
	// button now. bindToc() is registered on astro:page-load first, so the frame it
	// schedules runs after this DOM mutation and measures the wrapped tables and the
	// prepended heading anchors rather than the raw markup.
	document.addEventListener('astro:page-load', enhanceContent);

	// Delegated interaction + window listeners, bound exactly once for the session.
	if (!(window as any)._blogContentGlobalBound) {
		(window as any)._blogContentGlobalBound = true;

		document.addEventListener('keydown', (e) => {
			if (e.key === 'Escape') closeLightbox();
		});

		document.addEventListener('click', (e) => {
			const target = e.target as HTMLElement;

			// Heading anchor: copy the deep link
			const anchor = target.closest('.heading-anchor') as HTMLAnchorElement | null;
			if (anchor) {
				e.preventDefault();
				const id = anchor.getAttribute('href')?.slice(1);
				if (!id) return;
				const url = `${window.location.origin}${window.location.pathname}#${id}`;
				navigator.clipboard.writeText(url).then(() => {
					anchor.textContent = '✓';
					anchor.classList.add('copied');
					setTimeout(() => { anchor.textContent = '#'; anchor.classList.remove('copied'); }, 1500);
				}).catch(() => {});
				history.replaceState(null, '', `#${id}`);
				document.getElementById(id)?.scrollIntoView({ behavior: 'smooth', block: 'start' });
				return;
			}

			// Code block copy button
			const copyBtn = target.closest('.copy-btn') as HTMLButtonElement | null;
			if (copyBtn) {
				const pre = copyBtn.closest('pre');
				const code = pre?.querySelector('code');
				const text = code ? code.textContent ?? '' : pre?.textContent ?? '';
				navigator.clipboard.writeText(text.replace(/Copy$/, '')).then(() => {
					copyBtn.textContent = 'Copied!';
					setTimeout(() => { copyBtn.textContent = 'Copy'; }, 2000);
				}).catch(() => {});
				return;
			}

			// Back to top
			if (target.closest('.back-to-top')) {
				window.scrollTo({ top: 0, behavior: 'smooth' });
				return;
			}

			// Clicking the lightbox backdrop closes it
			if (target.closest('.lightbox')) {
				closeLightbox();
				return;
			}

			// Clicking a content image opens it
			const img = target.closest('.content img') as HTMLImageElement | null;
			if (img) {
				const { box, img: lightboxImg } = getLightbox();
				lightboxImg.src = img.src;
				lightboxImg.alt = img.alt;
				// The box is built on first use, so on the very first open its style has never
				// been computed and adding .active in the same task would resolve to a single
				// computed style with no from-state, skipping the fade. Reading a layout
				// property flushes the opacity:0 / scale(0.95) starting style first.
				// requestAnimationFrame is not enough: its callbacks run before the frame's
				// style recalc, so the element would still have no from-state. One forced
				// layout on a deliberate click is not worth optimising away.
				void box.offsetWidth;
				box.classList.add('active');
			}
		});
	}
</script>
