	/* Pre-paint start states for the intro reveal.
	   These used to be applied only by gsap.set() inside initSignal(). Now that the
	   loader slides away on its own schedule instead of waiting for the GSAP bundle,
	   the hero would briefly show itself fully revealed and then snap back to hidden
	   when GSAP finally landed. Declaring the same start values in CSS - under the
	   same html.signal-js flag that shows the loader - closes that window. GSAP writes
	   inline styles, which override these, and the 6s failsafe drops .signal-js so
	   nothing can ever be left invisible.
	   The h1 is deliberately NOT armed here: its .ltr spans are built in JS and never
	   receive Astro's scope attribute, so `.signal-h1 .ltr { display: inline-block }`
	   does not apply to them, transforms are ignored on the resulting inline boxes,
	   and the letter reveal has therefore never rendered. Arming it in CSS would add
	   an animation the live design does not currently have. */
	:global(html.signal-js) .signal-hero [data-fade] { opacity: 0; transform: translateY(24px); }
	:global(html.signal-js) .signal-portrait-wrap .signal-portrait { clip-path: circle(0% at 50% 45%); }

	/* the continuous strand - spans the whole page, drawn on scroll */
	.signal-strand { position: absolute; top: 0; left: 0; width: 100%; z-index: -1; pointer-events: none; }
	.signal-strand path { fill: none; }
	#sp-flare { transform-box: fill-box; transform-origin: center; animation: flarePulse 2.4s ease-in-out infinite; }
