---
import { getCollection } from 'astro:content';
import { Picture } from 'astro:assets';
// Component Imports
import CallToAction from '../components/CallToAction.astro';
// Page section components
import ContactCTA from '../components/ContactCTA.astro';
import Icon from '../components/Icon.astro';
import BlogPreview from '../components/BlogPreview.astro';
import ResumeSection from '../components/ResumeSection.astro';
import Skills from '../components/Skills.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import portraitImg from '../assets/portrait-new.webp';

const projects = (await getCollection('work'))
	.sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf())
	.slice(0, 4);

const posts = (await getCollection('blog'))
	.sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf())
	.slice(0, 3);

// w/h are the files' real intrinsic sizes. They are needed so the browser can
// reserve each logo's box from its aspect ratio before the image loads - without
// them the marquee reflows on load (Lighthouse: "image elements do not have
// explicit width and height").
const brands = [
	{ name: 'LambdaTest', logo: '/assets/brands/lambdatest-trim.webp', w: 1211, h: 210 },
	{ name: 'Samsung', logo: '/assets/brands/samsung-trim.webp', w: 820, h: 140 },
	{ name: 'Sociowash', logo: '/assets/brands/sociowash-trim.webp', w: 232, h: 140 },
	{ name: 'Medilife', logo: '/assets/brands/medilife-trim.webp', w: 168, h: 110 },
	{ name: 'Appknox', logo: '/assets/brands/appknox.svg', w: 115, h: 26 },
	{ name: 'Lido Learning', logo: '/assets/brands/lido-trim.webp', w: 281, h: 86 },
];

// The Selected Work showcase is built and ready, but the work entries currently
// use placeholder images (e.g. "800x950"). Flip this to true once they have real
// project imagery and the section will appear automatically.
const showSelectedWork = false;
---

<BaseLayout
	description="Swapnil Biswas - Product Marketing & Growth Strategist specializing in AI, SEO, and content. 657K+ leads generated, 18M+ traffic driven. Explore my work and blog."
	image="/og/home.webp"
>
	<script slot="head" is:inline>
		// Enable the Signal intro loader before paint (only with JS + no reduced-motion),
		// so no-JS / reduced-motion visitors always see content immediately.
		(function () {
			// Preload the hero painting this visitor will actually see. It is the LCP
			// element, and the day/dusk variants are swapped by a class on <html> rather
			// than a media query, so a static <link> in the markup could not know which
			// one to fetch. MainHead's theme script has already resolved the class by
			// the time this runs, so we can pick correctly and still be in <head>,
			// ahead of the parser reaching the <img>.
			// imagesrcset/imagesizes must match the <img> byte-for-byte or the browser
			// downloads the painting twice.
			try {
				var stem = document.documentElement.classList.contains('theme-dark')
					? '/assets/art/hero-landscape-dusk'
					: '/assets/art/hero-landscape';
				var pl = document.createElement('link');
				pl.rel = 'preload';
				pl.as = 'image';
				pl.setAttribute('fetchpriority', 'high');
				pl.setAttribute(
					'imagesrcset',
					stem + '-800.webp 800w, ' + stem + '-1200.webp 1200w, ' + stem + '-1600.webp 1600w, ' + stem + '.webp 2000w'
				);
				pl.setAttribute('imagesizes', '(min-width: 1552px) 900px, (min-width: 50em) 58vw, 100vw');
				document.head.appendChild(pl);
			} catch (e) {}
			try {
				var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
				if (!reduce && !window.__signalLoaderShown) {
					document.documentElement.classList.add('signal-js');
				}
			} catch (e) {}
			// Safety: never let the loader trap content if the main script fails to run.
			// __signalReleased tells the GSAP code the failsafe already fired, so it must
			// NOT re-hide the hero start states and re-run the intro after the fact.
			setTimeout(function () {
				var l = document.getElementById('signal-loader');
				if (l) l.style.display = 'none';
				window.__signalReleased = true;
				document.documentElement.classList.remove('signal-js');
			}, 6000);
		})();
	</script>
	<script type="application/ld+json" set:html={JSON.stringify({
		"@context": "https://schema.org",
		"@graph": [
			{
				"@type": "WebSite",
				"@id": "https://swapbiswas.com/#website",
				"url": "https://swapbiswas.com",
				"name": "Swapnil Biswas",
				"description": "Product Marketing & Growth Strategist specializing in AI, SEO, and content.",
				"publisher": { "@id": "https://swapbiswas.com/#person" },
				"potentialAction": {
					"@type": "SearchAction",
					"target": "https://swapbiswas.com/blog/?q={search_term_string}",
					"query-input": "required name=search_term_string"
				}
			},
			{ "@id": "https://swapbiswas.com/#person" },
			{
				"@type": "ItemList",
				"name": "Latest Blog Posts",
				"itemListElement": posts.map((post, i) => ({
					"@type": "ListItem",
					"position": i + 1,
					"url": `https://swapbiswas.com/blog/${post.id}/`
				}))
			}
		]
	})} />
	<div class="stack gap-20 lg:gap-30">
		<!-- Signal: ambient background, scroll progress, section HUD (decorative) -->
		<div class="signal-aura" aria-hidden="true"><span class="aura aura-1"></span><span class="aura aura-2"></span><span class="aura aura-3"></span></div>
		<canvas class="signal-constellation" aria-hidden="true"></canvas>
		<div class="signal-grain" aria-hidden="true"></div>
		<div class="signal-progress" aria-hidden="true"><span id="signal-progress-bar"></span></div>
		<div class="signal-hud" aria-hidden="true"><span id="signal-hud-idx">01</span><span class="signal-hud-sep"></span><span class="signal-hud-total">06</span></div>
		<!-- Signal: continuous strand + custom cursor + intro loader (decorative) -->
		<div class="signal-cursor" aria-hidden="true"><span class="sc-ring"></span><span class="sc-dot"></span></div>
		<span class="signal-cursor-label" aria-hidden="true"></span>
		<div class="signal-loader" id="signal-loader" aria-hidden="true">
			<div class="sl-inner">
				<div class="sl-count"><span id="signal-pct">0</span><i>%</i></div>
				<div class="sl-label">Calibrating signal</div>
				<div class="sl-bar"><span id="signal-bar"></span></div>
			</div>
		</div>
		<script is:inline>
			// The intro loader drives itself.
			//
			// It used to be a GSAP timeline built inside initSignal(), which Astro's
			// ClientRouter only fires on `astro:page-load` - and on a first navigation
			// that event is dispatched from window `load`. So the loader waited for every
			// image and all of GTM/GA/Clarity/AdSense before it could even start counting.
			// Measured on a throttled phone profile: the overlay painted at ~4.0s showing
			// "0", sat frozen there, and was killed by the 6s failsafe before GSAP ever
			// ran. This script is inline and sits directly after the markup, so it starts
			// on the very first frame after the loader paints.
			//
			// The timeline below is a transcription of the GSAP one it replaces - same
			// durations, same offsets, same easing functions (copied from gsap-core.js)
			// - so the animation is unchanged. It just no longer waits for a 46 KiB bundle.
			(function () {
				var root = document.documentElement;
				var el = document.getElementById('signal-loader');
				if (!el || !root.classList.contains('signal-js')) return;

				var inner = el.querySelector('.sl-inner');
				var pctEl = document.getElementById('signal-pct');
				var barEl = document.getElementById('signal-bar');

				// Returning to the homepage via a View Transition: the intro plays once.
				if (window.__signalLoaderShown) {
					el.style.display = 'none';
					window.__signalRevealReady = true;
					return;
				}
				window.__signalLoaderShown = true;

				// gsap eases, verbatim from node_modules/gsap/gsap-core.js.
				// power2 is Cubic, power3 is Quart; Expo is gsap's blended variant, not
				// the textbook 2^(10(p-1)).
				function power2InOut(p) { return p < 0.5 ? 4 * p * p * p : 1 - Math.pow(-2 * p + 2, 3) / 2; }
				function power3In(p) { return p * p * p * p; }
				function expoIn(p) { return Math.pow(2, 10 * (p - 1)) * p + p * p * p * p * p * p * (1 - p); }
				function expoInOut(p) { return p < 0.5 ? expoIn(p * 2) / 2 : 1 - expoIn((1 - p) * 2) / 2; }

				// Seconds on the original timeline:
				//   count  0.00 -> 1.40  power2.inOut
				//   inner  1.52 -> 2.02  power3.in    (+0.12 after the count)
				//   slide  1.84 -> 2.79  expo.inOut   (-0.18 from the inner fade's end)
				//   reveal @ 2.17                     (-0.62 from the slide's end)
				var COUNT_END = 1.4, INNER_A = 1.52, INNER_B = 2.02, SLIDE_A = 1.84, SLIDE_B = 2.79, REVEAL_AT = 2.17;

				var t0 = null, revealed = false, finished = false;

				function fireReveal() {
					if (revealed) return;
					revealed = true;
					window.__signalRevealReady = true;
					document.dispatchEvent(new Event('signal:reveal'));
				}
				function finish() {
					if (finished) return;
					finished = true;
					el.style.display = 'none';
					fireReveal();
				}
				function seg(t, a, b) { return Math.min(1, Math.max(0, (t - a) / (b - a))); }

				function frame(now) {
					if (t0 === null) t0 = now;
					var t = (now - t0) / 1000;

					var c = power2InOut(seg(t, 0, COUNT_END));
					if (pctEl) pctEl.textContent = String(Math.round(c * 100));
					if (barEl) barEl.style.transform = 'scaleX(' + c + ')';

					if (inner && t >= INNER_A) {
						var i = power3In(seg(t, INNER_A, INNER_B));
						inner.style.transform = 'translateY(' + -24 * i + 'px)';
						inner.style.opacity = String(1 - i);
					}
					if (t >= SLIDE_A) {
						el.style.transform = 'translateY(' + -100 * expoInOut(seg(t, SLIDE_A, SLIDE_B)) + '%)';
					}
					if (t >= REVEAL_AT) fireReveal();

					if (t >= SLIDE_B) { finish(); return; }
					requestAnimationFrame(frame);
				}
				requestAnimationFrame(frame);
			})();
		</script>
		<svg class="signal-strand" id="signal-strand" aria-hidden="true" preserveAspectRatio="none">
			<defs>
				<linearGradient id="signalGrad" x1="0" y1="0" x2="0" y2="1">
					<stop id="sg0" offset="0%" stop-color="#B53B15"></stop>
					<stop id="sg1" offset="45%" stop-color="#6A3A2A"></stop>
					<stop id="sg2" offset="75%" stop-color="#15130F"></stop>
					<stop id="sg3" offset="100%" stop-color="#B53B15"></stop>
				</linearGradient>
				<filter id="signalGlow" x="-60%" y="-60%" width="220%" height="220%">
					<feGaussianBlur stdDeviation="2" result="b"></feGaussianBlur>
					<feMerge><feMergeNode in="b"></feMergeNode><feMergeNode in="SourceGraphic"></feMergeNode></feMerge>
				</filter>
			</defs>
			<path id="sp-base" stroke="url(#signalGrad)" stroke-width="2.2" fill="none" stroke-linecap="round" opacity="0.9"></path>
			<path id="sp-pkt1" stroke="#B53B15" stroke-width="3.2" fill="none" stroke-linecap="round" filter="url(#signalGlow)"></path>
			<path id="sp-pkt2" stroke="#B53B15" stroke-width="2.5" fill="none" stroke-linecap="round" filter="url(#signalGlow)"></path>
			<line id="sp-filament" stroke="rgba(181,59,21,.4)" stroke-width="1" stroke-dasharray="2 3" opacity="0"></line>
			<circle id="sp-halo" r="22" fill="#B53B15" opacity="0.22" filter="url(#signalGlow)"></circle>
			<circle id="sp-flare" r="7" fill="#B53B15" filter="url(#signalGlow)"></circle>
		</svg>

		<div class="wrapper stack gap-8 lg:gap-20">
			<header class="signal-hero">
				<span class="signal-bgword" aria-hidden="true">SIGNAL</span>
				<!-- Renaissance backdrop: the sitter (portrait) in front of a landscape. Day in light
				     mode, dusk in dark mode; the theme is a class, so two <img> toggled by CSS. -->
				<!-- srcset ladder: 800 / 1200 / 1600 / 2000. Without the two middle
				     rungs a 412px phone at DPR 2 needs 824px, finds nothing between
				     800w and 2000w, and downloads the 365 KB master for what is a
				     masked decorative backdrop. This is the LCP element. -->
				<div class="hero-art" aria-hidden="true">
					<img
						class="hero-art--day"
						src="/assets/art/hero-landscape-800.webp"
						srcset="/assets/art/hero-landscape-800.webp 800w, /assets/art/hero-landscape-1200.webp 1200w, /assets/art/hero-landscape-1600.webp 1600w, /assets/art/hero-landscape.webp 2000w"
						sizes="(min-width: 1552px) 900px, (min-width: 50em) 58vw, 100vw"
						width="2000"
						height="1116"
						alt=""
						loading="eager"
						fetchpriority="high"
						decoding="async"
					/>
					<img
						class="hero-art--dusk"
						src="/assets/art/hero-landscape-dusk-800.webp"
						srcset="/assets/art/hero-landscape-dusk-800.webp 800w, /assets/art/hero-landscape-dusk-1200.webp 1200w, /assets/art/hero-landscape-dusk-1600.webp 1600w, /assets/art/hero-landscape-dusk.webp 2000w"
						sizes="(min-width: 1552px) 900px, (min-width: 50em) 58vw, 100vw"
						width="2000"
						height="1116"
						alt=""
						loading="lazy"
						decoding="async"
					/>
				</div>
				<div class="signal-hero-copy">
					<span class="signal-badge" data-fade><i></i> Available for new projects</span>
					<p class="eyebrow" data-fade>The signal, routed</p>
					<h1 class="signal-h1">
						<span class="ln"><span>Swapnil</span></span>
						<span class="ln"><span>Biswas</span></span>
					</h1>
					<p class="signal-lede" data-fade>I build the marketing engines - <b>AI agents</b>, content systems, and growth loops - that turn raw signal into <b>compounding growth</b>.</p>
					<a class="signal-cta" href="/contact/" data-cursor="say hello" data-magnetic data-fade>
						Let&rsquo;s talk <span class="arw" aria-hidden="true">&#8594;</span>
					</a>
					<div class="signal-roles" data-fade>
						<span>Product Marketing</span><span>Growth</span><span>SEO</span><span>AI</span>
					</div>
				</div>

				<div class="signal-cue" aria-hidden="true"><span>scroll</span><span class="line"></span></div>

				<div class="signal-portrait-wrap" data-cursor="that's me">
					{/* No fetchpriority here: the LCP element is the hero painting, and the
					    portrait starts clipped to circle(0%) so it is not even visible for
					    the first couple of seconds. Holding "high" here made the two images
					    compete and pushed the actual LCP resource further down the queue.
					    sizes matches the real box - .signal-portrait-wrap is
					    width: min(360px, 80%), so it never renders wider than 360px, and
					    measured 250/291/346/360px at 360/412/480/768px viewports. The old
					    100vw made a 412px phone at DPR 2 ask for 824px and fetch the 1024w
					    file instead of the 768w one. */}
					<Picture
						src={portraitImg}
						alt="Swapnil Biswas - AI, Product & Digital Growth Marketer"
						widths={[480, 768, 1024]}
						sizes="min(360px, 72vw)"
						formats={['avif', 'webp']}
						fallbackFormat="webp"
						loading="eager"
						pictureAttributes={{ class: "signal-portrait-pic" }}
						class="signal-portrait"
					/>
				</div>
			</header>

			<div class="signal-marquee signal-marquee--tags" aria-hidden="true">
				<div class="mq-track" id="mq-tags">
					<span class="mq-tag"><span>Product Marketing</span><span class="star">✦</span><span>Growth Strategy</span><span class="star">✦</span><span>AI Agents</span><span class="star">✦</span><span>SEO</span><span class="star">✦</span><span>Content</span><span class="star">✦</span><span>Demand Gen</span><span class="star">✦</span></span>
					<span class="mq-tag"><span>Product Marketing</span><span class="star">✦</span><span>Growth Strategy</span><span class="star">✦</span><span>AI Agents</span><span class="star">✦</span><span>SEO</span><span class="star">✦</span><span>Content</span><span class="star">✦</span><span>Demand Gen</span><span class="star">✦</span></span>
				</div>
			</div>

			<Skills />

			<section class="stats">
				<div class="stat" data-count="657" data-suffix="K">
					<div class="stat-number">
						<span class="stat-value">0</span><span class="stat-suffix">K</span>
					</div>
					<span class="stat-label">Leads Generated</span>
				</div>
				<div class="stat" data-count="18.2" data-suffix="M" data-decimal="1">
					<div class="stat-number">
						<span class="stat-value">0</span><span class="stat-suffix">M</span>
					</div>
					<span class="stat-label">Website Traffic</span>
				</div>
				<div class="stat" data-count="10" data-suffix="x">
					<div class="stat-number">
						<span class="stat-value">0</span><span class="stat-suffix">x</span>
					</div>
					<span class="stat-label">Conversion Results</span>
				</div>
				<div class="stat" data-count="15" data-suffix="+">
					<div class="stat-number">
						<span class="stat-value">0</span><span class="stat-suffix">+</span>
					</div>
					<span class="stat-label">People Mentored</span>
				</div>
				<div class="stat" data-count="20" data-suffix="+">
					<div class="stat-number">
						<span class="stat-value">0</span><span class="stat-suffix">+</span>
					</div>
					<span class="stat-label">AI Agents & Apps Created</span>
				</div>
			</section>
		</div>

		<main class="wrapper stack gap-20 lg:gap-30">
			<!-- Selected Work section hidden - work case studies don't have final data yet
			<section class="section with-background with-cta">
				<header class="section-header stack gap-2 lg:gap-4">
					<h3>Selected Work</h3>
					<p>Take a look below at some of my featured marketing and branding projects.</p>
				</header>

				<div class="gallery">
					<Grid variant="offset">
						{
							projects.map((project) => (
								<li>
									<PortfolioPreview project={project} />
								</li>
							))
						}
					</Grid>
				</div>

				<div class="cta">
					<CallToAction href="/work/">
						View All
						<Icon icon="arrow-right" size="1.2em" />
					</CallToAction>
				</div>
			</section>
			-->

			{showSelectedWork && projects.length > 0 && (
				<section class="signal-work">
					<header class="section-header stack gap-2 lg:gap-4">
						<p class="section-eyebrow">Selected Work</p>
						<h2>Campaigns &amp; builds</h2>
					</header>
					<div class="work-list">
						{projects.map((p, i) => (
							<a class="work-item" href={`/work/${p.id}`} data-cursor="view">
								<div class="work-media">
									<img src={p.data.img} alt={p.data.img_alt || p.data.title} loading="lazy" decoding="async" />
									<span class="work-index">{String(i + 1).padStart(2, '0')}</span>
								</div>
								<div class="work-meta">
									<h4 class="work-title">{p.data.title}</h4>
									<p class="work-desc">{p.data.description}</p>
									<div class="work-tags">{p.data.tags.slice(0, 3).map((t) => <span>{t}</span>)}</div>
									<span class="work-arrow">View case study <span aria-hidden="true">&#8594;</span></span>
								</div>
							</a>
						))}
					</div>
				</section>
			)}

			<section class="section with-background">
				<header class="section-header stack gap-2 lg:gap-4">
					<p class="section-eyebrow">The Journal</p>
					<h2>Latest Posts</h2>
					<p>Read my latest thoughts on marketing, AI, SEO, and growth strategy.</p>
				</header>

				<div class="gallery">
					<ul class="signal-posts-grid">
						{
							posts.map((post) => (
								<li>
									<BlogPreview post={post} />
								</li>
							))
						}
					</ul>
				</div>

				<div class="cta signal-posts-cta">
					<CallToAction href="/blog/">
						View All
						<Icon icon="arrow-right" size="1.2em" />
					</CallToAction>
				</div>
			</section>

			<section class="section with-background">
				<div class="resume-wrapper">
					<ResumeSection />
				</div>
			</section>

			<section class="signal-brands-sec">
				<header class="signal-brands-head section-header stack gap-2 lg:gap-4">
					<p class="section-eyebrow">Trusted by</p>
					<h2>Brands I've helped grow</h2>
				</header>
				<div class="signal-marquee signal-marquee--brands" aria-hidden="true">
					<div class="mq-track" id="mq-brands">
						{[...brands, ...brands, ...brands, ...brands, ...brands, ...brands].map((brand) => (
							<span class="mq-logo"><img src={brand.logo} alt={brand.name} width={brand.w} height={brand.h} loading="lazy" decoding="async" /></span>
						))}
					</div>
				</div>
			</section>
		</main>

		<!-- Newsletter / Get Updates -->
		<section class="newsletter-section">
			<div class="wrapper newsletter-wrapper">
				<div class="newsletter-art">
					<img
						src="/assets/art/newsletter-dove-800.webp"
						srcset="/assets/art/newsletter-dove-800.webp 800w, /assets/art/newsletter-dove.webp 2000w"
						sizes="(min-width: 50em) 21rem, calc(100vw - 9rem)"
						width="2000"
						height="1493"
						alt="Oil painting of a white messenger dove carrying a red ribbon over rolling green hills, a bell tower on the far ridge"
						loading="lazy"
						decoding="async"
					/>
				</div>
				<div class="newsletter-body">
				<div class="newsletter-content">
					<h2>Get Updates</h2>
					<p>Subscribe for insights on marketing, AI, SEO, and growth strategy. No spam, just value.</p>
				</div>
				<form id="newsletter-form" class="newsletter-form" action="https://app.kit.com/forms/9145889/subscriptions" method="post" data-sv-form="9145889" data-uid="e4f2ff34aa" data-format="inline" data-version="5">
					<input
						type="email"
						name="email_address"
						placeholder="Your email address"
						required
						autocomplete="email"
						aria-label="Email address for newsletter"
					/>
					<button type="submit">Subscribe</button>
				</form>
				<p class="newsletter-status" id="newsletter-status" role="status" aria-live="polite"></p>
				</div>
			</div>
		</section>

		<ContactCTA />
	</div>
</BaseLayout>

<script>
	function initHomePage() {
		const stats = document.querySelectorAll('.stat[data-count]');
		if (!stats.length) return;

		// Reset stat values for re-animation
		stats.forEach((stat) => {
			const valueEl = stat.querySelector('.stat-value') as HTMLElement;
			if (valueEl) valueEl.textContent = '0';
		});

		const prefersReduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
		const animateCountUp = () => {
			stats.forEach((stat) => {
				const target = parseFloat(stat.getAttribute('data-count') || '0');
				const hasDecimal = stat.hasAttribute('data-decimal');
				const valueEl = stat.querySelector('.stat-value') as HTMLElement;
				if (!valueEl) return;

				// Respect reduced motion: write the final value, no animation.
				if (prefersReduced) {
					valueEl.textContent = hasDecimal ? target.toFixed(1) : target.toString();
					return;
				}

				const duration = 2000;
				const startTime = performance.now();

				const update = (currentTime: number) => {
					const elapsed = currentTime - startTime;
					const progress = Math.min(elapsed / duration, 1);
					const eased = 1 - Math.pow(1 - progress, 3);
					const current = eased * target;

					valueEl.textContent = hasDecimal
						? current.toFixed(1)
						: Math.floor(current).toString();

					if (progress < 1) {
						requestAnimationFrame(update);
					} else {
						valueEl.textContent = hasDecimal
							? target.toFixed(1)
							: target.toString();
					}
				};

				requestAnimationFrame(update);
			});
		};

		const observer = new IntersectionObserver(
			(entries) => {
				entries.forEach((entry) => {
					if (entry.isIntersecting) {
						animateCountUp();
						observer.disconnect();
					}
				});
			},
			{ threshold: 0.3 }
		);

		const section = document.querySelector('.stats');
		if (section) observer.observe(section);

		// Newsletter form (Kit / ConvertKit)
		const nlForm = document.getElementById('newsletter-form') as HTMLFormElement;
		const nlStatus = document.getElementById('newsletter-status') as HTMLElement;
		if (nlForm && !(nlForm as any)._nlInit) {
			(nlForm as any)._nlInit = true;
			nlForm.addEventListener('submit', async (e) => {
				e.preventDefault();
				const btn = nlForm.querySelector('button') as HTMLButtonElement;
				btn.textContent = 'Subscribing...';
				btn.disabled = true;

				try {
					const formData = new FormData(nlForm);
					const res = await fetch(nlForm.action, {
						method: 'POST',
						body: formData,
						headers: { 'Accept': 'application/json' },
					});
					if (!res.ok) throw new Error('Subscription failed');

					nlStatus.textContent = 'Done - subscribed! You\'ll hear from me soon.';
					nlStatus.style.color = 'var(--sg-text)';
					nlForm.reset();

					window.dataLayer?.push({ event: 'newsletter_signup', signup_location: 'homepage' });
				} catch {
					nlStatus.textContent = 'Error - something went wrong. Please try again.';
					nlStatus.style.color = 'var(--accent-text)';
				}
				btn.textContent = 'Subscribe';
				btn.disabled = false;
			});
		}
	}
	document.addEventListener('astro:page-load', initHomePage);
</script>

