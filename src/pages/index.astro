	/* ============================================================
	   THE SIGNAL - heavy layers (ambient, HUD, marquees, wordmark)
	   ============================================================ */
	/* ambient aura + grain + vignette */
	.signal-aura { position: fixed; inset: 0; z-index: 0; pointer-events: none; overflow: hidden; }
	.signal-aura .aura { position: absolute; border-radius: 50%; filter: blur(90px); opacity: var(--sg-aura-op); will-change: transform; }
	/* auras are paper/cream tints only (no colored blobs) */
	.signal-aura .aura-1 { width: 55vw; height: 55vw; left: -12vw; top: -14vw; background: radial-gradient(circle, var(--sg-aura-2), transparent 68%); animation: auraDrift1 28s ease-in-out infinite; }
	.signal-aura .aura-2 { width: 48vw; height: 48vw; right: -14vw; top: 16vh; background: radial-gradient(circle, var(--sg-aura-1), transparent 68%); animation: auraDrift2 34s ease-in-out infinite; }
	.signal-aura .aura-3 { width: 44vw; height: 44vw; left: 26vw; bottom: -20vh; background: radial-gradient(circle, var(--sg-aura-2), transparent 68%); animation: auraDrift3 40s ease-in-out infinite; }
	.signal-aura::after { content: ''; position: absolute; inset: 0; background: radial-gradient(125% 95% at 50% 28%, transparent 52%, var(--sg-void) 100%); }
	@keyframes auraDrift1 { 0%, 100% { transform: translate(0, 0) scale(1); } 50% { transform: translate(8vw, 6vh) scale(1.15); } }
	@keyframes auraDrift2 { 0%, 100% { transform: translate(0, 0) scale(1); } 50% { transform: translate(-7vw, 10vh) scale(1.12); } }
	@keyframes auraDrift3 { 0%, 100% { transform: translate(0, 0) scale(1); } 50% { transform: translate(6vw, -8vh) scale(1.2); } }
	/* No blend mode in light mode. The tile is 220x220 with RGB exactly (0,0,0) on
	   every pixel and only alpha varying 0..25, so over an opaque backdrop `multiply`
	   and normal source-over are the same formula:
	     multiply: Co = as*ab*(Cb*Cs) + (1-as)*ab*Cb  ->  (1-as)Cb   when Cs=0, ab=1
	     normal:   Co = as*Cs + (1-as)*ab*Cb          ->  (1-as)Cb
	   The blend mode was buying an identical pixel result at the cost of forcing the
	   compositor to isolate `.backgrounds` (which has isolation: isolate) into an
	   offscreen surface and re-blend the full viewport on every damaged frame - and
	   the page is damaged every frame, because the strand ticker writes an SVG
	   attribute per rAF. Dark mode keeps `overlay` so its rendering is untouched. */
	.signal-grain { position: fixed; inset: 0; z-index: 1; pointer-events: none; background-image: url('/assets/backgrounds/noise.webp'); background-size: 200px; opacity: 0.035; }
	:global(:root.theme-dark) .signal-grain { mix-blend-mode: overlay; }

	/* scroll progress bar */
	.signal-progress { position: fixed; top: 0; left: 0; right: 0; height: 2px; z-index: 9995; pointer-events: none; }
	.signal-progress span { display: block; height: 100%; transform: scaleX(0); transform-origin: left; background: var(--accent-regular); }

	/* section index HUD */
	.signal-hud { position: fixed; left: 1.4rem; bottom: 1.2rem; z-index: 60; display: flex; align-items: center; gap: 0.55rem; font-family: var(--font-mono); font-weight: 500; font-size: 0.7rem; letter-spacing: 0.12em; color: var(--gray-400); }
	.signal-hud-sep { width: 28px; height: 1px; background: var(--gray-700); }
	#signal-hud-idx { color: var(--sg-text); }
	@media (max-width: 50em) { .signal-hud { display: none; } }

	/* giant background wordmark */
	.signal-bgword { position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); z-index: -3; font-family: var(--font-display); font-weight: 600; font-synthesis: none; font-size: min(36vw, 32rem); line-height: 1; letter-spacing: -0.04em; color: transparent; -webkit-text-stroke: 1px var(--sg-bgword-stroke); white-space: nowrap; user-select: none; pointer-events: none; }
	@media (max-width: 50em) { .signal-bgword { display: none; } .signal-strand { opacity: 0.6; } }
	/* desktop: fade the wordmark out before the hero painting starts (the painting is
	   feathered in from the left, so without this the letter strokes show through it) */
	@media (min-width: 50em) { .signal-bgword { -webkit-mask-image: linear-gradient(to right, #000 36%, transparent 56%); mask-image: linear-gradient(to right, #000 36%, transparent 56%); } }

	/* availability badge */
	.signal-badge { display: inline-flex; align-items: center; gap: 0.5rem; font-family: var(--font-mono); font-weight: 500; font-size: 0.72rem; letter-spacing: 0.08em; text-transform: uppercase; color: var(--sg-text); border: 1px solid var(--sg-hair); border-radius: 999px; padding: 0.4rem 0.85rem; margin-bottom: 1.1rem; background: var(--sg-panel); }
	.signal-badge i { width: 8px; height: 8px; border-radius: 50%; background: var(--sg-ok); animation: badgePulse 2s infinite; }
	@keyframes badgePulse { 0% { box-shadow: 0 0 0 0 color-mix(in srgb, var(--sg-ok) 50%, transparent); } 70% { box-shadow: 0 0 0 8px color-mix(in srgb, var(--sg-ok) 0%, transparent); } 100% { box-shadow: 0 0 0 0 color-mix(in srgb, var(--sg-ok) 0%, transparent); } }

	/* scroll cue */
	.signal-cue { position: absolute; bottom: 1.5rem; left: 50%; transform: translateX(-50%); display: flex; flex-direction: column; align-items: center; gap: 0.5rem; font-family: var(--font-mono); font-size: 0.6rem; letter-spacing: 0.12em; text-transform: uppercase; color: var(--sg-muted); z-index: 2; }
	.signal-cue .line { width: 1px; height: 38px; background: var(--accent-regular); animation: cueDrip 2s infinite; }
	@keyframes cueDrip { 0% { opacity: 0.2; } 50% { opacity: 1; } 100% { opacity: 0.2; } }
	@media (max-width: 50em) { .signal-cue { display: none; } }

	/* marquees (full-bleed) */
	.signal-marquee { position: relative; z-index: 2; overflow: hidden; width: 100vw; margin-left: calc(50% - 50vw); border-block: 1px solid var(--sg-hair); padding: 1.15rem 0; }
	.signal-marquee--tags { background: var(--gray-900); }
	.mq-track { display: flex; align-items: center; gap: 3rem; width: max-content; will-change: transform; }
	.mq-tag { display: inline-flex; align-items: center; gap: 3rem; white-space: nowrap; font-family: var(--font-mono); font-weight: 500; font-size: clamp(0.85rem, 1.6vw, 1.05rem); letter-spacing: 0.12em; text-transform: uppercase; color: var(--gray-300); }
	.mq-tag .star { color: var(--accent-text); }
	.mq-logo { height: 3.4rem; display: flex; align-items: center; justify-content: center; flex: none; padding: 0 0.85rem; }
	/* brands marquee: per-item spacing (no flex gap) so the loop seam is exact across copies */
	#mq-brands { gap: 0; }
	#mq-brands .mq-logo { padding: 0 1.8rem; }
	.mq-logo img { height: 2.4rem; width: auto; max-width: none; object-fit: contain; filter: brightness(0) opacity(0.5); transition: filter 0.3s; }
	:global(:root.theme-dark) .mq-logo img { filter: brightness(0) invert(1) opacity(0.6); }
	.mq-logo:hover img { filter: brightness(0) opacity(0.9); }
	:global(:root.theme-dark) .mq-logo:hover img { filter: brightness(0) invert(1) opacity(1); }

	/* brands section */
	.signal-brands-sec { display: flex; flex-direction: column; align-items: center; gap: 3rem; }
	.signal-brands-head { justify-self: center; text-align: center; }

	/* selected work showcase */
	.signal-work { display: flex; flex-direction: column; gap: 3.5rem; }
	.work-list { display: flex; flex-direction: column; gap: 4.5rem; }
	.work-item { display: grid; grid-template-columns: 1fr; gap: 1.4rem; text-decoration: none; color: inherit; }
	.work-media { position: relative; aspect-ratio: 16 / 10; border-radius: var(--radius-md); overflow: hidden; border: 1px solid var(--sg-hair); background: var(--sg-panel); transition: border-color 0.2s var(--ease-out), transform 0.2s var(--ease-out); }
	.work-media img { width: 100%; height: 100%; object-fit: cover; }
	.work-item:hover .work-media { border-color: var(--gray-700); transform: translateY(-2px); }
	.work-index { position: absolute; top: 1rem; left: 1rem; font-family: var(--font-mono); font-weight: 500; font-size: 0.72rem; letter-spacing: 0.08em; color: var(--accent-text-over); background: var(--gray-0); padding: 0.3rem 0.6rem; border-radius: var(--radius-xs); }
	.work-meta { display: flex; flex-direction: column; gap: 0.85rem; }
	.work-title { font-family: var(--font-display); font-weight: 600; font-synthesis: none; font-size: clamp(1.6rem, 4vw, 2.6rem); line-height: 1.05; letter-spacing: -0.02em; color: var(--sg-text); }
	.work-desc { color: var(--sg-lede); max-width: 52ch; }
	.work-tags { display: flex; gap: 0.5rem; flex-wrap: wrap; }
	.work-tags span { font-family: var(--font-mono); font-size: 0.72rem; letter-spacing: 0.08em; text-transform: uppercase; color: var(--gray-300); background: var(--gray-900); border: 1px solid var(--sg-hair); border-radius: var(--radius-xs); padding: 0.25rem 0.55rem; }
	.work-arrow { display: inline-flex; align-items: center; gap: 0.4rem; font-family: var(--font-body); font-weight: 500; color: var(--accent-text); transition: gap 0.3s; }
	.work-item:hover .work-arrow { gap: 0.8rem; }
	@media (min-width: 50em) {
		.work-item { grid-template-columns: 1.1fr 0.9fr; align-items: center; gap: 3.5rem; }
		.work-item:nth-child(even) .work-media { order: 2; }
	}

	/* latest posts - balanced 3-up row (no offset dangling gap) */
	.signal-posts-grid { display: grid; grid-template-columns: 1fr; gap: 1.5rem; list-style: none; padding: 0; margin: 0; }
	@media (min-width: 50em) { .signal-posts-grid { grid-template-columns: repeat(3, 1fr); gap: 2rem; } }
	.signal-posts-cta { display: flex; justify-content: center; }
	@media (min-width: 50em) { .signal-posts-cta { grid-area: auto; grid-column: 1 / -1; } }

	/* section eyebrow */
	.section-eyebrow { font-family: var(--font-mono); font-weight: 500; font-size: 0.72rem; letter-spacing: 0.12em; text-transform: uppercase; color: var(--accent-text); margin-bottom: 0.2rem; }

	@media (prefers-reduced-motion: reduce) {
		.signal-aura .aura, .signal-badge i, .signal-cue .line { animation: none; }
	}

	/* ============================================================
	   RENAISSANCE ART - hero landscape behind the portrait, dove by the form
	   ============================================================ */
	/* Stacking: the strand (#signal-strand) is z-index -1 inside .backgrounds
	   (isolation: isolate). For the painting to sit BELOW the strand it must live in
	   that same context, so the hero stops being a stacking context (z-index auto)
	   and the art goes to -2: above the paper ground, under the strand. Hero copy,
	   scroll cue and the portrait (z 2, set here) keep painting on top of it. */
	.signal-hero { z-index: auto; }
	.signal-portrait-wrap { z-index: 2; }

	.hero-art {
		position: absolute;
		z-index: -2;
		pointer-events: none;
		user-select: none;
		/* mobile: a full-bleed band behind the portrait at the foot of the hero,
		   feathered top and bottom so it never hard-cuts against the paper */
		top: auto;
		bottom: 0;
		left: calc(50% - 50vw);
		right: calc(50% - 50vw);
		height: min(92vw, 30rem);
		-webkit-mask-image: linear-gradient(to bottom, transparent 0%, #000 32%, #000 78%, transparent 100%);
		mask-image: linear-gradient(to bottom, transparent 0%, #000 32%, #000 78%, transparent 100%);
	}
	.hero-art img {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
		/* keep the trees and the red cloth (right side of the canvas) behind the sitter */
		object-position: 100% 50%;
		border: 0;
		border-radius: 0;
	}
	/* day in light, dusk in dark (theme is a class on <html>, not a media query) */
	.hero-art .hero-art--dusk { display: none; }
	:global(.theme-dark) .hero-art .hero-art--day { display: none; }
	:global(.theme-dark) .hero-art .hero-art--dusk { display: block; }

	@media (min-width: 50em) {
		.hero-art {
			/* desktop: cover the right ~55% of the hero, bleeding to the viewport edge,
			   feathered into the paper on the left and toward the bottom */
			top: 0;
			bottom: 0;
			left: auto;
			right: calc(50% - 50vw);
			height: auto;
			width: min(58vw, 900px);
			-webkit-mask-image: linear-gradient(to right, transparent 0%, #000 38%), linear-gradient(to bottom, transparent 0%, #000 10%, #000 72%, transparent 100%);
			mask-image: linear-gradient(to right, transparent 0%, #000 38%), linear-gradient(to bottom, transparent 0%, #000 10%, #000 72%, transparent 100%);
			-webkit-mask-composite: source-in;
			mask-composite: intersect;
		}
	}
	@media print { .hero-art { display: none; } }

	/* newsletter: the dove painting beside the heading + form (stacked on mobile) */
	.newsletter-art { width: 100%; aspect-ratio: 16 / 9; }
	.newsletter-art img {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
		border-radius: var(--radius-md);
		border: 1px solid var(--sg-hair);
	}
	.newsletter-body {
		display: flex;
		flex-direction: column;
		align-items: center;
		text-align: center;
		gap: 1rem;
		width: 100%;
	}
	@media (min-width: 50em) {
		.newsletter-wrapper {
			display: grid;
			grid-template-columns: minmax(0, 38fr) minmax(0, 62fr);
			align-items: center;
			gap: 2.5rem;
			max-width: none;
			text-align: left;
		}
		.newsletter-art { aspect-ratio: 4 / 3; }
		.newsletter-body { align-items: flex-start; text-align: left; }
	}
</style>

<style is:global>
	/* The Signal palette - theme-aware. This stylesheet ships only on the homepage,
	   so these overrides never affect the rest of the site. Light is the default
	   (:root); dark overrides apply under .theme-dark (the site's existing toggle). */
	:root {
		/* Paper & Signal - light (see DESIGN.md section 5) */
		--sg-void: #f6f4ef;
		--sg-panel: #ffffff;
		--sg-hair: #e4dfd6;
		--sg-text: #15130f;
		--sg-lede: #3a3632;
		--sg-muted: #6a645c;
		--sg-v1: #b53b15;
		--sg-warm: #8f2e0f;
		--sg-bloom: #b53b15;
		--sg-strand-0: #b53b15;
		--sg-strand-1: #6a3a2a;
		--sg-strand-2: #15130f;
		--sg-strand-3: #b53b15;
		--sg-strand-opacity: 0.9;
		--sg-strand-w: 2.2;
		--sg-pkt-w: 3.2;
		--sg-pkt2-w: 2.5;
		--sg-aura-op: 0.07;
		--sg-aura-1: #f3dcd2;
		--sg-aura-2: #eeebe4;
