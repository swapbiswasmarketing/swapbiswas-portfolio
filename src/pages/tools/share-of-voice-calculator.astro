</BaseLayout>

<script>
	const STATE_KEY = 'tool-state-share-of-voice-calculator';
	const MAX_COMPETITORS = 5;

	type Proxy = {
		valueLabel: string;
		cardMetric: string;
		hint: string;
		breaks: string;
	};

	const PROXIES: Record<string, Proxy> = {
		'ad-spend': {
			valueLabel: 'Spend in the period',
			cardMetric: 'Advertising spend share',
			hint: 'One currency, one window, every brand. This is the only proxy the excess share of voice constant was actually fitted on.',
			breaks: 'Where this proxy breaks: syndicated ad-spend panels measure placements in TV, digital, audio, print, out of home and cinema. Conference sponsorship, documentation and developer relations headcount are not placements, so neither your numerator nor the category total is in the panel.',
		},
		'serp': {
			valueLabel: 'Organic traffic or weighted rank points',
			cardMetric: 'Organic SERP share',
			hint: 'Same keyword set for every brand, and write the keyword list down before you run it.',
			breaks: 'Where this proxy breaks: you choose the keyword set, so the denominator is editable. Swapping ten keywords moves the number more than a quarter of publishing will.',
		},
		'reviews': {
			valueLabel: 'New reviews in the period',
			cardMetric: 'Review velocity share',
			hint: 'One review site, one window. Count new reviews rather than lifetime totals.',
			breaks: 'Where this proxy breaks: review volume is purchasable through gift-card campaigns, so it often measures incentive budget rather than attention. The review site decides who is in the category.',
		},
		'mentions': {
			valueLabel: 'Mentions in the period',
			cardMetric: 'Mention share',
			hint: 'One platform, one query string. A tag count, a post count and a question count are three different measurements.',
			breaks: 'Where this proxy breaks: three counters on one platform on one day gave the same vendor 1.0%, 4.7% and 5.3%, and the spelling of the query moved another vendor by more than half. Publish the query string, not just the vendor name.',
		},
		'events': {
			valueLabel: 'Weighted slots across the year',
			cardMetric: 'Sponsorship slot share',
			hint: 'Fix the event list first, then weight by sponsor tier. A keynote and a booth are not one unit each.',
			breaks: 'Where this proxy breaks: the organiser caps the inventory, so your ceiling is set by someone else rather than by your budget.',
		},
		'ai-citations': {
			valueLabel: 'Citations across your prompt set',
			cardMetric: 'AI citation share',
			hint: 'Fixed prompt set, run on a schedule, same engine. Record the run date with the count.',
			breaks: 'Where this proxy breaks: answers are non-deterministic, so the same prompt returns different citations on consecutive runs, and the prompt set is yours, which makes the denominator editable again.',
		},
		'custom': {
			valueLabel: 'Value in the period',
			cardMetric: 'Custom metric share',
			hint: 'Whatever you count, count it identically for every brand and name it on every chart.',
			breaks: 'Where this proxy breaks: whatever you counted is not advertising spend, which is the input the growth constant was fitted on, so the indication below is an extrapolation.',
		},
	};

	// The growth constant is published at three values by two different research bases.
	// All three pages were re-checked on 12 September 2026 and still carry these figures.
	//   0.5 - Nielsen, "Budgeting for the Upturn" (Aug 2009): "a 10 point difference between
	//         SOV and SOM leads to 0.5% of extra market share growth", from 123 brands across
	//         30 categories, recommended as a norm for fast moving consumer goods brands.
	//   0.7 - LinkedIn, "The B2B Marketer's Guide to the Share of Voice Rule" (Jan 2020):
	//         "an ESOV of 10% leads to market share growth of 0.7% per year", labelled B2B,
	//         from its joint report with Binet and Field on the IPA Effectiveness Databank.
	//   0.6 - the same 2020 page: "10% ESOV drives 0.6% annual growth", labelled B2C.
	// Keep these in sync with the row labels in the markup above.
	const CONSTANTS = [0.5, 0.7, 0.6];

	// Must stay word-for-word identical to the .sov-ind-scope paragraph in the markup:
	// the same sentence ships on screen, in the exported PNG and in the copied text.
	const SCOPE_NOTE = 'All three figures were fitted on advertising spend share, not on any of the substitute proxies in this tool. Nielsen tested 123 brands across 30 categories in 2009 and offered 0.5 as a norm for fast moving consumer goods; the 0.6 and 0.7 come from the IPA Effectiveness Databank campaigns Binet and Field analysed for LinkedIn, published in 2020. Nielsen adds that variance across categories and brands was large, and a 2009 consumer goods figure is not a current cross-category constant. An indication, not a promise of growth.';

	type Sample = { proxy: string; window: string; brand: string; value: string; market: string; comps: string[][] };

	const SAMPLES: Record<string, Sample> = {
		mentions: {
			proxy: 'mentions',
			window: 'Q3 2026',
			brand: 'NorthWind Labs',
			value: '2140',
			market: '12',
			comps: [['Acme Analytics', '4880'], ['RivalCo', '3010'], ['Meridian Data', '1290']],
		},
		serp: {
			proxy: 'serp',
			window: 'Q3 2026',
			brand: 'Kestrel CI',
			value: '18400',
			market: '9',
			comps: [['Forgewright', '52300'], ['Acme Pipelines', '31700'], ['Bellweather Build', '9850']],
		},
		spend: {
			proxy: 'ad-spend',
			window: 'FY 2026',
			brand: 'Harborline',
			value: '1250000',
			market: '14',
			comps: [['Acme Home', '4800000'], ['RivalCo', '2400000'], ['Northfield', '900000']],
		},
	};

	const themeBgColors: Record<string, string> = { dark: '#151311', light: '#f6f4ef', brand: '#b53b15' };

	function compIds(n: number) {
		return { name: 'sov-c' + n + '-name', value: 'sov-c' + n + '-value' };
	}

	const TEXT_IDS: string[] = ['sov-window', 'sov-brand', 'sov-value', 'sov-market'];
	for (let i = 1; i <= MAX_COMPETITORS; i++) {
		TEXT_IDS.push(compIds(i).name, compIds(i).value);
	}

	const MAGNITUDES: Record<string, number> = { k: 1e3, m: 1e6, mn: 1e6, b: 1e9, bn: 1e9 };

	/**
	 * Parses one pasted figure. Commas, spaces and a currency or percent symbol on
	 * either end are stripped, and a k / m / mn / b / bn magnitude suffix
	 * is APPLIED rather than dropped, so "$1.2M" is 1,200,000 and not 1.2.
	 * Anything that is not that exact shape returns null, so the caller leaves the row
	 * out of the denominator and names it in a note instead of silently using a wrong
	 * number. Negatives clamp to zero - a count of attention cannot be below nothing.
	 */
	function parseNum(raw: string): number | null {
		let s = String(raw == null ? '' : raw).trim().toLowerCase();
		if (!s) return null;
		s = s.replace(/,/g, '').replace(/\s/g, '');
		// Currency and percent symbols on either end are noise. Stray LETTERS are not
		// stripped, so "1200 usd" or "12abc" fails the match below instead of becoming 1200.
		s = s.replace(/^[^0-9a-z.+-]+/, '').replace(/[^0-9a-z]+$/, '');
		const m = s.match(/^([+-]?(?:\d+(?:\.\d+)?|\.\d+))(bn|mn|k|m|b)?$/);
		if (!m) return null;
		let n = parseFloat(m[1]);
		if (!isFinite(n)) return null;
		if (m[2]) n = n * MAGNITUDES[m[2]];
		if (!isFinite(n)) return null;
		return n < 0 ? 0 : n;
	}

	/**
	 * Largest remainder rounding to one decimal place. Plain per-row rounding can
	 * leave the column at 99.9 or 100.1, which reads as a bug on a downloaded card.
	 * This distributes the leftover tenths to the largest fractional parts, so the
	 * displayed shares total exactly 100.0 whenever the total is above zero.
	 */
	function roundShares(values: number[], total: number): number[] {
		if (!(total > 0)) return values.map(() => 0);
		const scaled = values.map((v) => (v / total) * 1000);
		const floors = scaled.map((s) => Math.floor(s));
		let remaining = 1000 - floors.reduce((a, b) => a + b, 0);
		const order = scaled
			.map((s, i) => ({ i: i, frac: s - Math.floor(s) }))
			.sort((a, b) => b.frac - a.frac);
		let k = 0;
		while (remaining > 0 && order.length > 0) {
			floors[order[k % order.length].i] += 1;
			remaining -= 1;
			k += 1;
		}
		return floors.map((f) => f / 10);
	}

	function fmtValue(n: number): string {
		if (!isFinite(n)) return '0';
		const rounded = Math.round(n * 100) / 100;
		return rounded.toLocaleString('en-US', { maximumFractionDigits: 2 });
	}

	function signed(n: number, digits: number): string {
		const fixed = n.toFixed(digits);
		return n > 0 ? '+' + fixed : fixed;
	}

	function initShareOfVoice() {
		const form = document.getElementById('sov-form') as HTMLFormElement | null;
		if (!form || (form as any)._initialized) return;
		(form as any)._initialized = true;

		const card = document.getElementById('sov-card') as HTMLElement | null;
		const frame = document.getElementById('preview-frame') as HTMLElement | null;
		if (!card) return;

		const proxySel = document.getElementById('sov-proxy') as HTMLSelectElement | null;
		const notesEl = document.getElementById('sov-notes');
		const savedEl = document.getElementById('sov-saved');
		const counterEl = document.getElementById('sov-counter');
		const compCountEl = document.getElementById('sov-comp-count');
		const addBtn = document.getElementById('sov-add') as HTMLButtonElement | null;

		let visibleComps = 2;
		let lastText = '';

		function val(id: string): string {
			const el = document.getElementById(id) as HTMLInputElement | null;
			return (el && el.value ? el.value : '').trim();
		}

		function setText(id: string, text: string) {
			const el = document.getElementById(id);
			if (el) el.textContent = text;
		}

		function currentProxy(): Proxy {
			const key = proxySel && proxySel.value ? proxySel.value : 'mentions';
			return PROXIES[key] || PROXIES.mentions;
		}

		function applyProxyLabels() {
			const p = currentProxy();
			setText('sov-value-label', p.valueLabel);
			setText('sov-proxy-hint', p.hint);
			setText('sov-card-metric', p.cardMetric);
			setText('sov-proxy-note', p.breaks);
			form.querySelectorAll('.comp-value-label').forEach((el) => {
				el.textContent = p.valueLabel;
			});
		}

		function applyCompVisibility() {
			for (let i = 1; i <= MAX_COMPETITORS; i++) {
				const row = document.getElementById('sov-c' + i + '-row');
				if (row) row.hidden = i > visibleComps;
			}
			if (addBtn) addBtn.disabled = visibleComps >= MAX_COMPETITORS;
			if (compCountEl) compCountEl.textContent = visibleComps + ' of ' + MAX_COMPETITORS + ' rows shown';
		}

		function addNote(list: HTMLElement, text: string) {
			const li = document.createElement('li');
			li.textContent = text;
			list.appendChild(li);
		}

		type Row = { name: string; value: number; you: boolean };

		function update() {
			applyProxyLabels();

			const notes: string[] = [];
			const rows: Row[] = [];

			const brandName = val('sov-brand') || 'Your brand';
			const brandRaw = val('sov-value');
			const brandVal = parseNum(brandRaw);
			if (brandVal === null) {
				if (brandRaw) notes.push('"' + brandRaw + '" is not a number, so your brand was left out of the total.');
				else notes.push('Add a value for your brand to get your share of voice.');
			} else {
				rows.push({ name: brandName, value: brandVal, you: true });
			}

			for (let i = 1; i <= visibleComps; i++) {
				const ids = compIds(i);
				const nm = val(ids.name);
				const rawv = val(ids.value);
				if (!nm && !rawv) continue;
				const v = parseNum(rawv);
				if (v === null) {
					notes.push('"' + (rawv || 'blank') + '" is not a number, so ' + (nm || 'competitor ' + i) + ' was left out of the total.');
					continue;
				}
				rows.push({ name: nm || 'Competitor ' + i, value: v, you: false });
			}

			const total = rows.reduce((a, r) => a + r.value, 0);
			const sorted = rows.slice().sort((a, b) => b.value - a.value);
			const shares = roundShares(sorted.map((r) => r.value), total);
			const maxShare = shares.length ? Math.max.apply(null, shares) : 0;

			// Title and window
			setText('sov-card-title', brandName);
			const windowVal = val('sov-window');
			const windowRow = document.getElementById('sov-window-row');
			if (windowRow) windowRow.hidden = !windowVal;
			setText('sov-card-window', windowVal);

			// Table rows
			for (let i = 0; i < 6; i++) {
				const rowEl = document.getElementById('sov-row-' + i);
				if (!rowEl) continue;
				if (i >= sorted.length || !(total > 0)) {
					rowEl.hidden = true;
					continue;
				}
				rowEl.hidden = false;
				const r = sorted[i];
				const share = shares[i];
				rowEl.classList.toggle('is-you', r.you);
				const nameEl = rowEl.querySelector('.sov-row-name');
				const valEl = rowEl.querySelector('.sov-row-value');
				const pctEl = rowEl.querySelector('.sov-row-pct');
				const fillEl = rowEl.querySelector('.sov-bar-fill') as HTMLElement | null;
				if (nameEl) nameEl.textContent = r.name + (r.you ? ' (you)' : '');
				if (valEl) valEl.textContent = fmtValue(r.value);
				if (pctEl) pctEl.textContent = share.toFixed(1) + '%';
				if (fillEl) fillEl.style.width = (maxShare > 0 ? (share / maxShare) * 100 : 0) + '%';
			}

			const totalRow = document.getElementById('sov-total-row');
			const emptyEl = document.getElementById('sov-empty');
			if (totalRow) totalRow.hidden = !(total > 0);
			if (emptyEl) emptyEl.hidden = total > 0;
			setText('sov-total-value', fmtValue(total));
			setText('sov-total-pct', total > 0 ? '100.0%' : '0.0%');

			if (!(total > 0) && rows.length > 0) {
				notes.push('Every value is zero, so there is no denominator to divide by.');
			}
			if (total > 0 && rows.length === 1) {
				notes.push('Only one brand has a value, so its share is 100%. Add competitors for a denominator that means something.');
			}

			// Your share of voice
			let mySov: number | null = null;
			for (let i = 0; i < sorted.length; i++) {
				if (sorted[i].you && total > 0) mySov = shares[i];
			}
			setText('sov-fig-sov', mySov === null ? 'Not set' : mySov.toFixed(1) + '%');

			// Market share and ESOV
			const marketRaw = val('sov-market');
			let market = parseNum(marketRaw);
			if (market !== null && market > 100) {
				market = 100;
				notes.push('Market share was above 100%, so it was capped at 100%.');
			}
			// Round market share ONCE, here, before it is either displayed or subtracted.
			// Every share of voice out of roundShares is already an exact tenth, so this
			// makes the three printed figures agree: an entered 12.35 used to display as
			// 12.3 while ESOV was computed from 12.35, and 18.9 minus 12.3 is not 6.5.
			if (market !== null) market = Math.round(market * 10) / 10;
			if (market === null && marketRaw) {
				notes.push('"' + marketRaw + '" is not a number, so market share was ignored.');
			}
			setText('sov-fig-ms', market === null ? 'Not set' : market.toFixed(1) + '%');

			const esovEl = document.getElementById('sov-fig-esov');
			const esovNote = document.getElementById('sov-fig-esov-note');
			const indEl = document.getElementById('sov-indication');
			let esov: number | null = null;

			if (mySov !== null && market !== null) {
				esov = Math.round((mySov - market) * 10) / 10;
			}

			if (esov === null) {
				if (esovEl) esovEl.textContent = 'Not set';
				if (esovNote) esovNote.textContent = mySov === null
					? 'Add your brand value to get ESOV'
					: 'Add your market share to get ESOV';
				if (indEl) indEl.hidden = true;
			} else {
				if (esovEl) esovEl.textContent = signed(esov, 1) + ' pts';
				if (esovNote) {
					esovNote.textContent = esov > 0
						? 'Growth-side position: voice above share'
						: (esov < 0 ? 'Deficit: share above voice' : 'At parity: voice equals share');
				}
				if (indEl) indEl.hidden = false;
				for (let i = 0; i < CONSTANTS.length; i++) {
					const pp = (esov / 10) * CONSTANTS[i];
					setText('sov-ind-' + i, signed(pp, 2) + 'pp a year');
				}
				setText('sov-ind-scope', esov < 0
					? SCOPE_NOTE + ' The published statements describe the positive side of the rule, so the negative figures above are the same line run backwards.'
					: SCOPE_NOTE);
			}

			// Notes list
			if (notesEl) {
				notesEl.textContent = '';
				notes.forEach((n) => addNote(notesEl, n));
				notesEl.hidden = notes.length === 0;
			}

			// Field counter
			if (counterEl) {
				const activeIds = ['sov-window', 'sov-brand', 'sov-value', 'sov-market'];
				for (let i = 1; i <= visibleComps; i++) {
					activeIds.push(compIds(i).name, compIds(i).value);
				}
				const filled = activeIds.filter((id) => val(id).length > 0).length;
				counterEl.textContent = filled + '/' + activeIds.length + ' fields filled' + (filled === activeIds.length ? ' (complete)' : '');
			}

			lastText = buildText(sorted, shares, total, mySov, market, esov);
			scaleCard();
		}

		function buildText(
			sorted: Row[],
			shares: number[],
			total: number,
			mySov: number | null,
			market: number | null,
			esov: number | null
		): string {
			const p = currentProxy();
			const lines: string[] = [];
			const windowVal = val('sov-window');
			lines.push('Share of voice - ' + p.cardMetric + (windowVal ? ' - ' + windowVal : ''));
			lines.push('');
			if (total > 0) {
				for (let i = 0; i < sorted.length; i++) {
					const label = (i + 1) + '. ' + sorted[i].name + (sorted[i].you ? ' (you)' : '');
					lines.push(label.padEnd(34, ' ') + fmtValue(sorted[i].value).padStart(14, ' ') + shares[i].toFixed(1).padStart(8, ' ') + '%');
				}
				lines.push('Set total'.padEnd(34, ' ') + fmtValue(total).padStart(14, ' ') + '100.0'.padStart(8, ' ') + '%');
			} else {
				lines.push('No values above zero yet.');
			}
			lines.push('');
			lines.push('Your share of voice: ' + (mySov === null ? 'not set' : mySov.toFixed(1) + '%'));
			lines.push('Your market share: ' + (market === null ? 'not set' : market.toFixed(1) + '%'));
			lines.push('Excess share of voice: ' + (esov === null ? 'not set' : signed(esov, 1) + ' points'));
			if (esov !== null) {
				lines.push('');
				lines.push('Indicated annual market share change at each published constant:');
				lines.push('  0.5 per 10 points (Nielsen, 2009, FMCG norm): ' + signed((esov / 10) * 0.5, 2) + 'pp');
				lines.push('  0.7 per 10 points (LinkedIn with Binet and Field, IPA databank, 2020, B2B): ' + signed((esov / 10) * 0.7, 2) + 'pp');
				lines.push('  0.6 per 10 points (LinkedIn with Binet and Field, IPA databank, 2020, B2C): ' + signed((esov / 10) * 0.6, 2) + 'pp');
				lines.push(SCOPE_NOTE);
			}
			lines.push('');
			lines.push(p.breaks);
			lines.push('Shares rounded to one decimal place by the largest remainder method, so the column totals exactly 100.0. Every number was supplied by the user, nothing was fetched.');
			lines.push('Built with the free share of voice calculator at https://swapbiswas.com/tools/share-of-voice-calculator/');
			return lines.join('\n');
		}

		function scaleCard() {
			// A stale listener from a previous View Transition can still hold this closure,
			// so bail out once the nodes it captured have left the document.
			if (!frame || !card || !frame.isConnected) return;
			const widthScale = Math.min(1, frame.clientWidth / 1000);
			const prev = card.style.getPropertyValue('--sov-scale');
			card.style.setProperty('--sov-scale', '1');
			const naturalHeight = card.scrollHeight;
			card.style.setProperty('--sov-scale', prev || String(widthScale));

			const isDesktop = window.matchMedia('(min-width: 64em)').matches;
			let heightScale = 1;
			if (isDesktop && naturalHeight > 0) {
				const available = window.innerHeight - 24 - 24 - 96;
				heightScale = available / naturalHeight;
			}
			let scale = Math.min(widthScale, heightScale, 1);
			// A very short viewport can drive heightScale to zero or below. Falling back to
			// the width fit keeps the card visible instead of collapsing it to nothing.
			if (!isFinite(scale) || scale <= 0) scale = widthScale > 0 ? widthScale : 1;
			card.style.setProperty('--sov-scale', String(scale));
			frame.style.height = Math.max(0, naturalHeight * scale) + 'px';
		}

		function applyTheme(theme: string) {
			card.dataset.theme = theme;
			document.querySelectorAll('.theme-btn').forEach((btn) => {
				btn.classList.toggle('active', (btn as HTMLElement).dataset.theme === theme);
			});
		}

		function saveState() {
			try {
				const fields: Record<string, string> = {};
				TEXT_IDS.forEach((id) => { const v = val(id); if (v) fields[id] = v; });
				localStorage.setItem(STATE_KEY, JSON.stringify({
					fields: fields,
					proxy: proxySel ? proxySel.value : 'mentions',
					visibleComps: visibleComps,
					theme: card.dataset.theme || 'dark',
					savedAt: Date.now(),
				}));
				if (savedEl) savedEl.textContent = 'Saved to this browser';
			} catch (e) {}
		}

		function loadState(): boolean {
			try {
				const raw = localStorage.getItem(STATE_KEY);
				if (!raw) return false;
				const saved = JSON.parse(raw);
				const fields = saved && saved.fields ? saved.fields : {};
				Object.keys(fields).forEach((id) => {
					const el = document.getElementById(id) as HTMLInputElement | null;
					if (el && typeof fields[id] === 'string') el.value = fields[id];
				});
				if (proxySel && typeof saved.proxy === 'string' && PROXIES[saved.proxy]) proxySel.value = saved.proxy;
				if (typeof saved.visibleComps === 'number' && saved.visibleComps >= 1 && saved.visibleComps <= MAX_COMPETITORS) {
					visibleComps = Math.floor(saved.visibleComps);
				}
				if (typeof saved.theme === 'string' && themeBgColors[saved.theme]) applyTheme(saved.theme);
				applyCompVisibility();
				if (savedEl) savedEl.textContent = 'Restored from this browser';
				return true;
			} catch (e) { return false; }
		}

		function clearFields() {
			TEXT_IDS.forEach((id) => {
				const el = document.getElementById(id) as HTMLInputElement | null;
				if (el) el.value = '';
			});
		}

		function loadSample(key: string) {
			const sample = SAMPLES[key];
			if (!sample) return;
			clearFields();
			if (proxySel) proxySel.value = sample.proxy;
			const setVal = (id: string, v: string) => {
				const el = document.getElementById(id) as HTMLInputElement | null;
				if (el) el.value = v;
			};
			setVal('sov-window', sample.window);
			setVal('sov-brand', sample.brand);
			setVal('sov-value', sample.value);
			setVal('sov-market', sample.market);
			visibleComps = Math.max(2, Math.min(MAX_COMPETITORS, sample.comps.length));
			applyCompVisibility();
			sample.comps.forEach((pair, idx) => {
				const ids = compIds(idx + 1);
				setVal(ids.name, pair[0]);
				setVal(ids.value, pair[1]);
			});
			update();
			saveState();
		}

		async function renderCard(format: 'png' | 'blob'): Promise<any> {
			const frameEl = frame;
			const prevTransform = card.style.transform;
			const prevFrameHeight = frameEl ? frameEl.style.height : '';
			const mod: any = await import('https://esm.sh/html-to-image@1.11.13' as any);
			try {
				card.style.transform = 'none';
				if (frameEl) frameEl.style.height = card.scrollHeight + 'px';
				const theme = card.dataset.theme || 'dark';
				const opts = {
					pixelRatio: 2,
					backgroundColor: themeBgColors[theme] || '#151311',
					cacheBust: true,
					skipFonts: true,
					width: 1000,
					height: card.scrollHeight,
				};
				return format === 'blob' ? await mod.toBlob(card, opts) : await mod.toPng(card, opts);
			} finally {
				card.style.transform = prevTransform;
				if (frameEl) frameEl.style.height = prevFrameHeight;
			}
		}

		function safeFilename(): string {
			const brand = val('sov-brand') || 'share-of-voice';
			const slug = brand.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-+|-+$/g, '');
			return (slug || 'share-of-voice') + '-share-of-voice.png';
		}

		// Events
		let saveTimer: any;
		form.addEventListener('input', () => {
			update();
			clearTimeout(saveTimer);
			saveTimer = setTimeout(saveState, 400);
		});
		form.addEventListener('change', () => {
			update();
			clearTimeout(saveTimer);
			saveTimer = setTimeout(saveState, 400);
		});

		addBtn?.addEventListener('click', () => {
			if (visibleComps >= MAX_COMPETITORS) return;
			visibleComps += 1;
			applyCompVisibility();
			update();
			saveState();
		});

		form.querySelectorAll('.comp-remove').forEach((btn) => {
			btn.addEventListener('click', () => {
				const n = parseInt((btn as HTMLElement).dataset.remove || '0', 10);
				if (!n) return;
				// Shift every row below this one up, then drop the last visible row.
				for (let i = n; i < visibleComps; i++) {
					const from = compIds(i + 1);
					const to = compIds(i);
					const fromName = document.getElementById(from.name) as HTMLInputElement | null;
					const fromValue = document.getElementById(from.value) as HTMLInputElement | null;
					const toName = document.getElementById(to.name) as HTMLInputElement | null;
					const toValue = document.getElementById(to.value) as HTMLInputElement | null;
					if (toName && fromName) toName.value = fromName.value;
					if (toValue && fromValue) toValue.value = fromValue.value;
				}
				const last = compIds(visibleComps);
				const lastName = document.getElementById(last.name) as HTMLInputElement | null;
				const lastValue = document.getElementById(last.value) as HTMLInputElement | null;
				if (lastName) lastName.value = '';
				if (lastValue) lastValue.value = '';
				if (visibleComps > 1) visibleComps -= 1;
				applyCompVisibility();
				update();
				saveState();
			});
		});

		form.querySelectorAll('.sample-option').forEach((btn) => {
			btn.addEventListener('click', () => {
				loadSample((btn as HTMLElement).dataset.sample || '');
				const picker = btn.closest('details');
				if (picker) picker.removeAttribute('open');
			});
		});

		document.getElementById('sov-reset')?.addEventListener('click', () => {
			clearFields();
			if (proxySel) proxySel.value = 'mentions';
			visibleComps = 2;
			applyCompVisibility();
			applyTheme('dark');
			update();
			saveState();
		});

		document.getElementById('sov-clear')?.addEventListener('click', () => {
			if (!confirm('Clear the saved copy in this browser?')) return;
			try { localStorage.removeItem(STATE_KEY); } catch (e) {}
			clearFields();
			if (proxySel) proxySel.value = 'mentions';
			visibleComps = 2;
			applyCompVisibility();
			if (savedEl) savedEl.textContent = 'Cleared';
			update();
		});

		document.querySelectorAll('.theme-btn').forEach((btn) => {
			btn.addEventListener('click', () => {
				applyTheme((btn as HTMLElement).dataset.theme || 'dark');
				saveState();
			});
		});

		const copyBtn = document.getElementById('sov-copy') as HTMLButtonElement | null;
		copyBtn?.addEventListener('click', async () => {
			const label = 'Copy results';
			try {
				await navigator.clipboard.writeText(lastText);
				copyBtn.textContent = 'Copied';
				(window as any).dataLayer = (window as any).dataLayer || [];
				(window as any).dataLayer.push({ event: 'tool_copy', tool_name: 'share-of-voice-calculator', tool_output: 'text' });
			} catch (e) {
				copyBtn.textContent = 'Copy failed';
			}
			setTimeout(() => { copyBtn.textContent = label; }, 1600);
		});

		const downloadBtn = document.getElementById('sov-download') as HTMLButtonElement | null;
		downloadBtn?.addEventListener('click', async () => {
			const label = 'Download PNG';
			downloadBtn.disabled = true;
			downloadBtn.textContent = 'Rendering...';
			try {
				const dataUrl = await renderCard('png');
				const link = document.createElement('a');
				link.download = safeFilename();
				link.href = dataUrl;
				link.click();
				downloadBtn.textContent = 'Downloaded';
				(window as any).dataLayer = (window as any).dataLayer || [];
				(window as any).dataLayer.push({ event: 'tool_download', tool_name: 'share-of-voice-calculator', tool_output: 'png' });
			} catch (e) {
				downloadBtn.textContent = 'Export failed';
			}
			downloadBtn.disabled = false;
			setTimeout(() => { downloadBtn.textContent = label; }, 1600);
		});

		// Keep the card fitted when the column, the viewport or the content changes.
		if (frame && 'ResizeObserver' in window) {
			const ro = new ResizeObserver(() => scaleCard());
			ro.observe(frame);
		}
		if ('MutationObserver' in window) {
			// attributeFilter deliberately excludes "style": scaleCard writes --sov-scale to
			// the card's style attribute, so observing style here would re-enter scaleCard on
			// every pass and spin. hidden and class are the two attributes that change height.
			const mo = new MutationObserver(() => scaleCard());
			mo.observe(card, {
				childList: true,
				subtree: true,
				characterData: true,
				attributes: true,
				attributeFilter: ['hidden', 'class'],
			});
		}
		window.addEventListener('resize', scaleCard);
		if (document.fonts && (document.fonts as any).ready) {
			(document.fonts as any).ready.then(() => scaleCard());
		}

		applyCompVisibility();
		if (!loadState()) loadSample('mentions');
		update();
		scaleCard();
	}

	function initToolNewsletter() {
		const form = document.getElementById('tool-newsletter-form') as HTMLFormElement | null;
		const status = document.getElementById('tool-newsletter-status');
		if (!form || (form as any)._initialized) return;
		(form as any)._initialized = true;

		form.addEventListener('submit', (e) => {
			e.preventDefault();
			const emailInput = form.querySelector('input[name="email_address"]') as HTMLInputElement | null;
			const email = emailInput?.value || '';
			const btn = form.querySelector('button[type="submit"]') as HTMLButtonElement | null;
			if (btn) { btn.textContent = 'Subscribing...'; btn.disabled = true; }
			const formData = new FormData();
			formData.append('email_address', email);
			fetch('https://app.kit.com/forms/9145889/subscriptions', {
				method: 'POST',
				body: formData,
				headers: { 'Accept': 'application/json' }
			}).then((res) => {
				if (!res.ok) throw new Error('fail');
				if (status) { status.textContent = 'Subscribed!'; status.style.color = 'var(--sg-ok)'; }
				form.reset();
				(window as any).dataLayer = (window as any).dataLayer || [];
				(window as any).dataLayer.push({ event: 'newsletter_signup', signup_location: 'tool_share_of_voice_calculator' });
			}).catch(() => {
				if (status) { status.textContent = 'Something went wrong.'; status.style.color = 'var(--accent-text)'; }
			}).finally(() => {
				if (btn) { btn.textContent = 'Subscribe'; btn.disabled = false; }
			});
		});
	}

	initShareOfVoice();
	initToolNewsletter();
	document.addEventListener('astro:page-load', () => {
		initShareOfVoice();
		initToolNewsletter();
	});
</script>

