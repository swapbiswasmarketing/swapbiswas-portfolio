<script>
  // Vanilla stream sequencer - keeps it light + 60fps. Safety-net: every message lives in the
  // markup and is visible by default. JS only hides-then-streams when motion is allowed, reveals
  // anything already in view immediately, and a hard setTimeout force-finalizes every turn.
  const RM = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const root = document.documentElement;
  const thread = document.getElementById('thread');
  const turns = Array.from(document.querySelectorAll('.turn')) as HTMLElement[];

  // suggested-prompt chips + conversation links: smooth-scroll a turn into view (works regardless of RM)
  function jumpTo(sel: string | null){
    if(!sel) return;
    const el = document.querySelector(sel) as HTMLElement | null;
    if(el && thread){ el.scrollIntoView({behavior: RM ? 'auto' : 'smooth', block: 'center'}); }
  }
  document.querySelectorAll('.prompt-chip').forEach(chip => {
    chip.addEventListener('click', () => jumpTo(chip.getAttribute('data-jump')));
  });
  document.querySelectorAll('.conv').forEach(c => {
    c.addEventListener('click', (e) => {
      const href = (c as HTMLAnchorElement).getAttribute('href');
      if(href && href.startsWith('#')){ e.preventDefault(); jumpTo(href);
        document.querySelectorAll('.conv').forEach(x => x.classList.remove('on'));
        c.classList.add('on');
      }
    });
  });

  // auto-grow the composer textarea (cosmetic)
  const ta = document.querySelector('.inputbar .txt') as HTMLTextAreaElement | null;
  if(ta){
    ta.addEventListener('input', () => { ta.style.height = 'auto'; ta.style.height = Math.min(90, ta.scrollHeight) + 'px'; });
  }

  if (RM || !turns.length) {
    // Reduced motion or nothing to do: leave everything fully visible (default CSS). No streaming.
  } else {
    root.classList.add('js-stream');           // CSS now primes .turn hidden
    let finalized = false;

    function finalizeAll(){
      if(finalized) return; finalized = true;
      clearTimeout(safety);
      turns.forEach(t => {
        t.classList.add('shown');
        t.classList.remove('streaming', 'streaming-text');
      });
    }
    // (b) HARD SAFETY NET: force-show every turn within 2.7s no matter what.
    // Once finalized, every step below bails so the sequence can never re-hide a settled bubble.
    const safety = window.setTimeout(finalizeAll, 2700);

    // reveal a single bot bubble: thinking shimmer -> caret text -> settled
    function playBot(turn: HTMLElement, done: () => void){
      if(finalized) return;
      turn.classList.add('shown', 'streaming');   // shows thinking, hides body
      window.setTimeout(() => {
        if(finalized) return;
        turn.classList.remove('streaming');
        turn.classList.add('streaming-text');       // body visible, caret blinking
        window.setTimeout(() => { if(finalized) return; turn.classList.remove('streaming-text'); done(); }, 520);
      }, 340);
    }

    let idx = 0;
    function next(){
      if(finalized) return;
      if(idx >= turns.length){ finalizeAll(); return; }
      const turn = turns[idx];
      const isBot = turn.classList.contains('bot');
      if(isBot){
        playBot(turn, () => { idx++; window.setTimeout(() => requestAnimationFrame(next), 90); });
      } else {
        turn.classList.add('shown');               // user bubble pops in
        idx++;
        window.setTimeout(() => requestAnimationFrame(next), 220);
      }
    }

    // (a) reveal anything already on screen instantly-ish; kick the sequence after fonts settle
    requestAnimationFrame(() => requestAnimationFrame(next));
  }
</script>
</body>
</html>
