---
// REDESIGN PROTOTYPE - "Arcade" - Concept 45.
// The career rendered as a retro arcade game: attract mode, a HUD, levels/stages, a high-score
// table and an insert-coin continue screen. Flat pixel-neon (NOT a curved-glass CRT), original
// concept - its own layout, palette, fonts, motion and signature mechanic (NOT a reskin of the
// existing "broadcast" CRT concept or the "comic" concept).
//  - ATTRACT SCREEN hero with a sticky HUD (1UP score counts up to 657000, HI-SCORE, CR 02,
//    a LEVEL readout that follows scroll), a big pixel LOGO of the name, a marquee tagline and a
//    blinking PRESS START prompt that IS the primary CTA (scrolls to the work).
//  - SELECTED WORK = STAGES (STAGE 1-1 etc); featured LambdaTest = BOSS STAGE. Cards pop in.
//  - METRICS = SCORE BREAKDOWN with segmented pixel power-bars.
//  - DISCIPLINES = POWER-UPS grid.  SHIPPED = ACHIEVEMENTS UNLOCKED.
//  - RECOGNITION = HIGH SCORE TABLE (rank / initials / score / label; top row shimmer).
//  - ABOUT = PLAYER 1 character-select stat card (stat bars + bio facts).
//  - CONTACT = INSERT COIN / CONTINUE? screen: PRESS A: EMAIL, PRESS B: LINKEDIN (real links).
//  - Faint flat scanline overlay + subtle parallax starfield. No curved CRT glass.
// Self-contained: own <html>, own Google Fonts <link>, own CSS tokens, noindex. No BaseLayout.
// GOTCHA NOTES: all content lives in the Astro markup (never injected by JS) so it is fully
// visible with zero JS; JS only enhances (adds html.js-anim to hide-then-reveal). Press Start 2P
// is used ONLY for short HUD text / numbers / titles - all descriptions use VT323 at a legible
// size. prefers-reduced-motion => static scores, no blink/bob/marquee/shimmer, all content shown.
// No text-shadow/filter on any background-clip:text element (Chrome gradient gotcha).
const stages = [
  { lv: 'BOSS STAGE', name: 'LambdaTest', role: 'Product & digital marketing', y: '2021-25', score: '657K LEADS', tag: 'PMM', boss: true,
    d: 'Owned product and digital marketing end to end and built the full organic growth engine.' },
  { lv: 'STAGE 2-1', name: 'TestMu AI', role: 'Rebrand lead', y: '2026', score: 'FULL REBRAND', tag: 'BRD',
    d: 'Led the complete rebrand from LambdaTest to TestMu AI.' },
  { lv: 'STAGE 2-2', name: 'Samsung', role: 'via Sociowash', y: '2019', score: 'M-SERIES', tag: 'LCH',
    d: 'On the Galaxy M-series from inception; ran content distribution, collaborated with Technical Guruji.' },
  { lv: 'STAGE 3-1', name: 'Medilife Superspeciality', role: 'Marketing & web', y: '0 to 1', score: 'SITE + GTM', tag: 'GTM',
    d: 'Built the full digital presence and go-to-market for a NABH-accredited superspeciality hospital in Dehradun.' },
  { lv: 'STAGE 3-2', name: 'Lido Learning', role: 'Growth / CRM', y: '2021', score: 'LEAD OPS', tag: 'CRM',
    d: 'Ran CRM management and lead routing and assignment for the EdTech.' },
  { lv: 'STAGE 4-1', name: 'Appknox', role: 'Freelance content', y: 'Freelance', score: 'SECURITY', tag: 'CNT',
    d: 'Freelance content writer for the mobile app security company.' },
];
const scoreBars = [
  { v: '657K+',  l: 'Leads generated',   w: '0.98', c: 'var(--mag)' },
  { v: '18.2M+', l: 'Organic traffic',   w: '1',    c: 'var(--cyan)' },
  { v: '10x',    l: 'Pipeline efficiency', w: '0.82', c: 'var(--green)' },
];
const powerups = [
  { i: 'P1', t: 'Product Marketing & GTM', d: 'Positioning, launches, battlecards and sales enablement for B2B SaaS.', c: 'var(--mag)' },
  { i: 'P2', t: 'Growth, SEO & AEO', d: 'Technical audits, AI-search optimization and demand gen that compounds.', c: 'var(--cyan)' },
  { i: 'P3', t: 'AI & Automation', d: 'I build the agents and internal tools that do the work - 20+ shipped.', c: 'var(--yellow)' },
  { i: 'P4', t: 'Building in public', d: 'This site, 8 free tools and 76 articles. Shipped systems, not slide-ware.', c: 'var(--green)' },
];
const achievements = [
  { n: '20+', l: 'AI agents & internal tools shipped' },
  { n: '15+', l: 'Marketers mentored & levelled up' },
  { n: '76',  l: 'Long-form articles published' },
];
const highscores = [
  { r: '1', ini: 'AGL', sc: '999999', t: 'VALUE OF AGILITY', m: 'LambdaTest, 2024' },
  { r: '2', ini: 'WOF', sc: '850000', t: 'WALL OF FAME', m: 'LambdaTest' },
  { r: '3', ini: 'PH1', sc: '777777', t: 'PRODUCT OF THE DAY', m: 'Product Hunt, #1' },
];
const playerStats = [
  { k: 'MARKETING', w: '0.96' },
  { k: 'CODE / AI',  w: '0.80' },
  { k: 'SEO / AEO',  w: '0.92' },
  { k: 'GTM',        w: '0.90' },
];
const facts = [
  { k: 'BASE',      v: 'Mumbai, India' },
  { k: 'TENURE',    v: '7+ yrs marketing · 4+ in B2B SaaS' },
  { k: 'EDU',       v: 'Postgrad, Digital Marketing & Growth Strategy, IIM Visakhapatnam' },
  { k: 'CLASS',     v: 'PMM & growth strategist who codes AI agents, ships sites and runs technical SEO' },
];
const brands = ['LambdaTest', 'TestMu AI', 'Samsung', 'Medilife', 'Lido Learning', 'Appknox'];
// pixel invader sprite (mask): white opaque pixels; recolored per element via background
const invader = "data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 11 8' shape-rendering='crispEdges'%3E%3Cg fill='%23fff'%3E%3Crect x='2' y='0' width='1' height='1'/%3E%3Crect x='8' y='0' width='1' height='1'/%3E%3Crect x='3' y='1' width='1' height='1'/%3E%3Crect x='7' y='1' width='1' height='1'/%3E%3Crect x='2' y='2' width='7' height='1'/%3E%3Crect x='1' y='3' width='2' height='1'/%3E%3Crect x='4' y='3' width='3' height='1'/%3E%3Crect x='8' y='3' width='2' height='1'/%3E%3Crect x='0' y='4' width='11' height='1'/%3E%3Crect x='0' y='5' width='1' height='1'/%3E%3Crect x='2' y='5' width='7' height='1'/%3E%3Crect x='10' y='5' width='1' height='1'/%3E%3Crect x='0' y='6' width='1' height='1'/%3E%3Crect x='2' y='6' width='1' height='1'/%3E%3Crect x='8' y='6' width='1' height='1'/%3E%3Crect x='10' y='6' width='1' height='1'/%3E%3Crect x='3' y='7' width='2' height='1'/%3E%3Crect x='6' y='7' width='2' height='1'/%3E%3C/g%3E%3C/svg%3E";
---
<!doctype html>
<html lang="en" data-theme="arcade">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>Swapnil Biswas - Insert Coin</title>
<meta name="robots" content="noindex, follow" />
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Press+Start+2P&family=VT323&display=swap" rel="stylesheet" />
<style>
  :root{
    --bg:#0a0812;          /* deep CRT indigo/black */
    --bg2:#0d0a18;
    --panel:#120f26;       /* cabinet panel */
    --panel2:#17133100;    /* unused-safe */
    --panel-b:#2a2450;     /* panel border */
    --grid:#241f45;        /* faint grid line */
    --mag:#ff5cb4;         /* neon magenta (brightened for AA) */
    --mag-deep:#ff3fa4;
    --cyan:#5cecff;        /* neon cyan (brightened) */
    --cyan-deep:#35e6ff;
    --yellow:#ffd23f;      /* arcade yellow */
    --green:#3ee888;       /* pixel green (brightened) */
    --ink:#f4f2ff;         /* ink white */
    --dim:#b9b4d6;         /* dim ink - AA on dark */
    --faint:#8b86ad;       /* faintest label - AA-safe */
    --press:"Press Start 2P","Courier New",monospace;
    --body:"VT323","Courier New",monospace;
    --wrap:min(1120px,calc(100vw - 24px));
    --shadow:#050409;
  }
  *{margin:0;padding:0;box-sizing:border-box}
  html,body{overflow-x:clip}
  html{scroll-behavior:smooth;background:var(--bg)}
  body{
    font-family:var(--body);color:var(--ink);min-height:100vh;position:relative;
    font-size:clamp(18px,2.4vw,21px);line-height:1.42;-webkit-font-smoothing:antialiased;
    background:
      radial-gradient(130% 90% at 50% -10%, #14102b 0%, var(--bg2) 45%, var(--bg) 100%);
  }
  a{color:inherit;text-decoration:none}
  ::selection{background:var(--mag);color:var(--bg)}
  img{max-width:100%}

  /* ---------- parallax starfield (behind everything) ---------- */
  .stars,.stars2{position:fixed;inset:-20% 0;z-index:0;pointer-events:none}
  .stars{
    background-image:
      radial-gradient(1.5px 1.5px at 20% 30%, #ffffff88 50%, transparent 51%),
      radial-gradient(1.5px 1.5px at 70% 15%, #9be9ff77 50%, transparent 51%),
      radial-gradient(1.5px 1.5px at 85% 60%, #ffffff66 50%, transparent 51%),
      radial-gradient(1.5px 1.5px at 40% 80%, #ffb0e077 50%, transparent 51%),
      radial-gradient(1.5px 1.5px at 12% 65%, #ffffff55 50%, transparent 51%),
      radial-gradient(1.5px 1.5px at 55% 45%, #fff6b055 50%, transparent 51%);
    background-size:100% 100%;opacity:.9;
  }
  .stars2{
    background-image:
      radial-gradient(1px 1px at 33% 22%, #ffffff44 50%, transparent 51%),
      radial-gradient(1px 1px at 62% 72%, #ffffff44 50%, transparent 51%),
      radial-gradient(1px 1px at 8% 40%, #ffffff33 50%, transparent 51%),
      radial-gradient(1px 1px at 90% 33%, #ffffff33 50%, transparent 51%),
      radial-gradient(1px 1px at 48% 12%, #ffffff33 50%, transparent 51%);
    opacity:.6;
  }
  /* faint flat scanline overlay (kept above content, never blocks clicks) */
  .scan{position:fixed;inset:0;z-index:60;pointer-events:none;
    background:repeating-linear-gradient(0deg, rgba(0,0,0,.16) 0 1px, transparent 1px 3px);
    mix-blend-mode:multiply;opacity:.55}

  /* ---------- sticky HUD bar ---------- */
  .hud{position:sticky;top:0;z-index:40;width:100%;
    background:linear-gradient(180deg,#0c0a1c,#0a0812);
    border-bottom:2px solid var(--panel-b);
    box-shadow:0 4px 0 #05040c, 0 10px 24px -12px #000;}
  .hud-in{width:var(--wrap);margin:0 auto;display:flex;align-items:center;gap:clamp(10px,2.4vw,26px);
    flex-wrap:wrap;padding:10px 0;font-family:var(--press);font-size:clamp(7px,1.35vw,10px);line-height:1.5}
  .hud .lab{color:var(--cyan);letter-spacing:.04em}
  .hud .val{color:var(--ink);letter-spacing:.02em}
  .hud .one .lab{color:var(--mag)}
  .hud .credits{color:var(--yellow)}
  .hud .lvl{margin-left:auto;color:var(--green);display:flex;align-items:center;gap:8px}
  .hud .coin{width:11px;height:11px;border-radius:50%;background:var(--yellow);
    box-shadow:inset -2px -2px 0 #b8880f;flex:none}
  .hud .heart{color:var(--mag)}

  /* ---------- shared layout ---------- */
  main{position:relative;z-index:2}
  .wrap{width:var(--wrap);margin:0 auto}
  section{padding:clamp(46px,8vh,84px) 0}
  .cap{font-family:var(--press);font-size:clamp(10px,2vw,14px);letter-spacing:.02em;
    color:var(--ink);display:flex;align-items:center;gap:12px;margin-bottom:6px}
  .cap .pip{width:12px;height:12px;background:var(--mag);flex:none;
    box-shadow:2px 2px 0 var(--cyan)}
  .cap .n{color:var(--cyan)}
  .cap-sub{color:var(--dim);margin:0 0 26px;font-size:clamp(17px,2.2vw,21px)}

  /* pixel panel base */
  .panel{background:var(--panel);border:2px solid var(--panel-b);
    box-shadow:6px 6px 0 var(--shadow);position:relative}

  /* ---------- ATTRACT / hero ---------- */
  .attract{padding-top:clamp(30px,6vh,54px);text-align:center;position:relative}
  .attract .invaders{display:flex;justify-content:center;gap:16px;margin-bottom:22px}
  .sprite{width:34px;height:25px;-webkit-mask:var(--m) no-repeat center/contain;
    mask:var(--m) no-repeat center/contain}
  .blink-slow{}
  .logo{font-family:var(--press);line-height:1;letter-spacing:.01em;
    font-size:clamp(30px,10vw,86px);margin:6px 0 4px}
  .logo .l1{display:block;color:var(--mag)}
  .logo .l2{display:block;color:var(--cyan);margin-top:.16em}
  /* hard pixel drop behind logo (NOT on the letters, so no gradient-text gotcha risk) */
  .logo span{position:relative}
  .role{font-family:var(--press);font-size:clamp(8px,1.7vw,11px);color:var(--yellow);
    letter-spacing:.06em;margin:18px 0 4px}
  /* marquee tagline */
  .marquee{overflow:hidden;width:100%;margin:16px 0 4px;
    -webkit-mask:linear-gradient(90deg,transparent,#000 12%,#000 88%,transparent);
            mask:linear-gradient(90deg,transparent,#000 12%,#000 88%,transparent)}
  .marquee .track{display:inline-flex;white-space:nowrap;will-change:transform;
    animation:marq 22s linear infinite}
  .marquee .track span{padding:0 26px;color:var(--dim);font-size:clamp(17px,2.3vw,22px);letter-spacing:.02em}
  .marquee .track span b{color:var(--cyan)}
  @keyframes marq{from{transform:translateX(0)}to{transform:translateX(-50%)}}
  .lede{max-width:56ch;margin:20px auto 0;color:var(--ink);font-size:clamp(18px,2.5vw,23px);line-height:1.45}
  .lede b{color:var(--yellow);font-weight:400}
  .cta{display:flex;gap:16px;justify-content:center;flex-wrap:wrap;margin-top:30px}
  /* pixel button */
  .btn{font-family:var(--press);font-size:clamp(8px,1.5vw,11px);letter-spacing:.02em;
    padding:15px 20px;border:2px solid;display:inline-flex;align-items:center;gap:10px;cursor:pointer;
    background:var(--bg2);transition:transform .12s steps(2), box-shadow .12s steps(2), background .12s}
  .btn.start{color:var(--bg);background:var(--mag);border-color:var(--mag);box-shadow:5px 5px 0 var(--cyan)}
  .btn.start .press{animation:blink 1.05s steps(1) infinite}
  .btn.start:hover{transform:translate(-2px,-2px);box-shadow:7px 7px 0 var(--cyan)}
  .btn.ghost{color:var(--cyan);border-color:var(--cyan);box-shadow:5px 5px 0 var(--shadow)}
  .btn.ghost:hover{transform:translate(-2px,-2px);box-shadow:7px 7px 0 var(--cyan-deep);background:#0f1830}
  .btn:focus-visible{outline:3px solid var(--yellow);outline-offset:3px}
  @keyframes blink{0%,50%{opacity:1}51%,100%{opacity:0}}
  .press-hint{font-family:var(--press);font-size:clamp(7px,1.3vw,9px);color:var(--faint);
    margin-top:26px;letter-spacing:.08em}

  /* ---------- STAGES / work ---------- */
  .stages{display:grid;grid-template-columns:repeat(2,1fr);gap:18px}
  .stage{padding:20px 20px 22px;display:flex;flex-direction:column;gap:10px}
  .stage.bossc{grid-column:1/-1;border-color:var(--mag);box-shadow:8px 8px 0 var(--shadow)}
  .stage-top{display:flex;align-items:center;gap:12px}
  .stage .tag{width:40px;height:40px;flex:none;display:grid;place-items:center;
    font-family:var(--press);font-size:9px;color:var(--bg);background:var(--cyan);
    border:2px solid #0a2a33;box-shadow:3px 3px 0 var(--shadow)}
  .stage.bossc .tag{background:var(--mag);border-color:#3a0e28}
  .stage .lv{font-family:var(--press);font-size:9px;color:var(--yellow);letter-spacing:.04em}
  .stage.bossc .lv{color:var(--mag)}
  .stage .nm{font-family:var(--press);font-size:clamp(11px,1.9vw,15px);color:var(--ink);line-height:1.25;margin-top:3px}
  .stage .row{display:flex;justify-content:space-between;gap:12px;align-items:baseline;flex-wrap:wrap}
  .stage .role{font-family:var(--body);font-size:clamp(17px,2.1vw,20px);color:var(--dim);margin:0;letter-spacing:0}
  .stage .yr{font-family:var(--press);font-size:8px;color:var(--faint);letter-spacing:.04em}
  .stage .desc{color:var(--ink);font-size:clamp(17px,2.1vw,20px);line-height:1.4}
  .stage .scorepill{align-self:flex-start;font-family:var(--press);font-size:9px;color:var(--green);
    border:2px solid var(--green);padding:6px 9px;letter-spacing:.03em}
  .stage.bossc .scorepill{color:var(--yellow);border-color:var(--yellow)}

  /* ---------- SCORE BREAKDOWN / metrics ---------- */
  .scoreb{padding:26px clamp(18px,3vw,34px) 30px}
  .metric{display:grid;grid-template-columns:1fr;gap:8px;padding:18px 0;border-top:2px dashed var(--grid)}
  .metric:first-child{border-top:0;padding-top:6px}
  .metric-head{display:flex;justify-content:space-between;align-items:baseline;gap:12px;flex-wrap:wrap}
  .metric .mv{font-family:var(--press);font-size:clamp(16px,4vw,30px);color:var(--ink);letter-spacing:.01em}
  .metric .ml{color:var(--dim);font-size:clamp(17px,2.1vw,20px)}
  .bar{height:22px;border:2px solid var(--panel-b);background:#0b0918;padding:2px;overflow:hidden}
  .bar .fill{height:100%;transform-origin:left;transform:scaleX(var(--w));
    background:repeating-linear-gradient(90deg, var(--c) 0 12px, #0b0918 12px 15px)}

  /* ---------- POWER-UPS / disciplines ---------- */
  .grid4{display:grid;grid-template-columns:repeat(2,1fr);gap:18px}
  .pu{padding:20px;display:flex;flex-direction:column;gap:10px}
  .pu .badge{width:44px;height:44px;flex:none;display:grid;place-items:center;
    font-family:var(--press);font-size:11px;color:var(--bg);border:2px solid var(--shadow);
    box-shadow:3px 3px 0 var(--shadow)}
  .pu .pt{font-family:var(--press);font-size:clamp(10px,1.6vw,12px);color:var(--ink);line-height:1.4}
  .pu .pd{color:var(--dim);font-size:clamp(17px,2.1vw,20px);line-height:1.4}

  /* ---------- ACHIEVEMENTS / shipped ---------- */
  .ach{display:grid;grid-template-columns:repeat(3,1fr);gap:18px}
  .ach .a{padding:22px 18px;text-align:center;display:flex;flex-direction:column;gap:10px;align-items:center}
  .ach .trophy{width:26px;height:26px;-webkit-mask:var(--m) no-repeat center/contain;
    mask:var(--m) no-repeat center/contain;background:var(--yellow)}
  .ach .an{font-family:var(--press);font-size:clamp(18px,5vw,34px);color:var(--yellow);line-height:1}
  .ach .al{color:var(--dim);font-size:clamp(16px,2vw,19px);line-height:1.35}
  .ach .unlocked{font-family:var(--press);font-size:7px;color:var(--green);letter-spacing:.1em}

  /* ---------- HIGH SCORE TABLE / recognition ---------- */
  .hst{padding:8px 0}
  .hst-head,.hs{display:grid;grid-template-columns:auto 62px 1fr auto;gap:clamp(10px,2vw,20px);align-items:center;
    padding:14px clamp(16px,3vw,26px)}
  .hst-head{font-family:var(--press);font-size:8px;color:var(--faint);letter-spacing:.08em;
    border-bottom:2px solid var(--panel-b)}
  .hs{border-bottom:2px dashed var(--grid);position:relative;overflow:hidden}
  .hs:last-child{border-bottom:0}
  .hs .rank{font-family:var(--press);font-size:clamp(11px,2vw,15px);color:var(--cyan)}
  .hs .ini{font-family:var(--press);font-size:clamp(11px,2vw,15px);color:var(--yellow);letter-spacing:.06em}
  .hs .who .t{font-family:var(--press);font-size:clamp(9px,1.5vw,11px);color:var(--ink);line-height:1.4}
  .hs .who .m{color:var(--dim);font-size:clamp(16px,2vw,19px)}
  .hs .sc{font-family:var(--press);font-size:clamp(10px,1.7vw,14px);color:var(--green);text-align:right;letter-spacing:.02em}
  .hs.top{background:linear-gradient(90deg, rgba(255,210,63,.07), transparent)}
  .hs.top .rank,.hs.top .sc{color:var(--yellow)}
  /* shimmer sweep on the #1 row */
  .hs.top::after{content:"";position:absolute;inset:0;pointer-events:none;
    background:linear-gradient(105deg, transparent 40%, rgba(255,255,255,.14) 50%, transparent 60%);
    transform:translateX(-120%);animation:sweep 3.4s ease-in-out infinite}
  @keyframes sweep{0%,20%{transform:translateX(-120%)}55%,100%{transform:translateX(120%)}}
  .brands{display:flex;flex-wrap:wrap;gap:10px;margin-top:26px;justify-content:center}
  .brands span{font-family:var(--press);font-size:8px;color:var(--dim);letter-spacing:.02em;
    border:2px solid var(--grid);padding:9px 11px;background:var(--bg2)}
  .brands .lead{width:100%;text-align:center;border:0;color:var(--faint);padding:0 0 4px}

  /* ---------- PLAYER 1 / about ---------- */
  .p1{display:grid;grid-template-columns:0.9fr 1.1fr;gap:0;overflow:hidden}
  .p1-l{padding:26px;border-right:2px solid var(--panel-b);background:
    linear-gradient(180deg, rgba(255,92,180,.06), transparent)}
  .p1 .avatar{width:88px;height:66px;-webkit-mask:var(--m) no-repeat center/contain;
    mask:var(--m) no-repeat center/contain;background:var(--mag);margin-bottom:16px}
  .p1 .pname{font-family:var(--press);font-size:clamp(12px,2.4vw,18px);color:var(--ink);line-height:1.3}
  .p1 .pclass{color:var(--cyan);font-size:clamp(17px,2.1vw,20px);margin-top:8px}
  .p1 .stat{margin-top:16px}
  .p1 .stat .sk{display:flex;justify-content:space-between;font-family:var(--press);font-size:8px;
    color:var(--dim);letter-spacing:.04em;margin-bottom:6px}
  .p1 .stat .sk b{color:var(--yellow)}
  .p1-r{padding:26px}
  .p1 .bio{color:var(--ink);font-size:clamp(17px,2.2vw,21px);line-height:1.45;margin-bottom:18px}
  .fact{display:flex;gap:14px;padding:12px 0;border-top:2px dashed var(--grid)}
  .fact:first-of-type{border-top:0}
  .fact .k{font-family:var(--press);font-size:8px;color:var(--cyan);letter-spacing:.04em;flex:none;width:64px;padding-top:3px}
  .fact .v{color:var(--dim);font-size:clamp(17px,2.1vw,20px);line-height:1.4}

  /* ---------- INSERT COIN / contact ---------- */
  .coin-screen{text-align:center;padding:44px clamp(18px,4vw,44px) 48px}
  .insert{font-family:var(--press);font-size:clamp(14px,4vw,30px);color:var(--yellow);
    letter-spacing:.02em;line-height:1.3}
  .insert .blink-c{animation:blink 1.05s steps(1) infinite}
  .continue{font-family:var(--press);font-size:clamp(9px,1.7vw,12px);color:var(--dim);margin-top:18px;letter-spacing:.04em}
  .continue b{color:var(--cyan)}
  .options{display:grid;grid-template-columns:repeat(2,1fr);gap:18px;margin:30px auto 0;max-width:640px}
  .opt{padding:22px 18px;display:flex;flex-direction:column;gap:10px;align-items:center;text-align:center;
    transition:transform .12s steps(2), box-shadow .12s steps(2), background .12s}
  .opt .key{width:46px;height:46px;display:grid;place-items:center;border-radius:50%;
    font-family:var(--press);font-size:15px;color:var(--bg)}
  .opt.a .key{background:var(--mag)}
  .opt.b .key{background:var(--cyan)}
  .opt .kt{font-family:var(--press);font-size:9px;letter-spacing:.04em}
  .opt.a .kt{color:var(--mag)}
  .opt.b .kt{color:var(--cyan)}
  .opt .kv{color:var(--ink);font-size:clamp(16px,2.2vw,20px);word-break:break-word}
  .opt.a{border-color:var(--mag)}
  .opt.b{border-color:var(--cyan)}
  .opt:hover{transform:translate(-2px,-2px);box-shadow:8px 8px 0 var(--shadow)}
  .opt:focus-visible{outline:3px solid var(--yellow);outline-offset:3px}

  /* ---------- footer (outside cabinet) ---------- */
  .foot{width:var(--wrap);margin:10px auto 0;padding:26px 0 40px;
    display:flex;justify-content:space-between;flex-wrap:wrap;gap:10px;
    border-top:2px solid var(--panel-b);
    font-family:var(--press);font-size:8px;letter-spacing:.04em;color:var(--faint)}
  .foot a{color:var(--cyan)}
  .foot a:hover{color:var(--ink);text-decoration:underline}

  /* ---------- pop-in reveal (content visible by default) ---------- */
  .pop{opacity:1;transform:none}
  html.js-anim .pop{opacity:0;transform:translateY(22px)}
  html.js-anim .pop.in{opacity:1;transform:none;
    transition:opacity .5s ease, transform .5s cubic-bezier(.2,.8,.2,1)}
  html.js-anim .pop .fill{transform:scaleX(0)}
  html.js-anim .pop.in .fill{transform:scaleX(var(--w));transition:transform .9s cubic-bezier(.2,.8,.2,1) .15s}

  /* ---------- responsive ---------- */
  @media(max-width:820px){
    .p1{grid-template-columns:1fr}
    .p1-l{border-right:0;border-bottom:2px solid var(--panel-b)}
  }
  @media(max-width:640px){
    .stages,.grid4{grid-template-columns:1fr}
    .stage.bossc{grid-column:auto}
    .ach{grid-template-columns:1fr}
    .options{grid-template-columns:1fr}
    .hst-head,.hs{grid-template-columns:auto 52px 1fr;}
    .hs .sc{grid-column:1/-1;text-align:left;padding-top:4px}
    .hst-head .h-sc{display:none}
  }

  /* ---------- reduced motion: static everything ---------- */
  @media(prefers-reduced-motion:reduce){
    html{scroll-behavior:auto}
    .pop,.pop.in{opacity:1!important;transform:none!important;transition:none!important}
    .pop .fill,.pop.in .fill{transform:scaleX(var(--w))!important;transition:none!important}
    .marquee .track{animation:none!important;transform:none!important;justify-content:center}
    .btn.start .press,.insert .blink-c{animation:none!important;opacity:1!important}
    .hs.top::after{animation:none!important;display:none}
  }
</style>
</head>
<body>
  <div class="stars" id="stars" aria-hidden="true"></div>
  <div class="stars2" id="stars2" aria-hidden="true"></div>
  <div class="scan" aria-hidden="true"></div>

  <!-- ===== STICKY HUD ===== -->
