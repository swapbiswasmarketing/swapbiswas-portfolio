  </footer>

<script>
  const RM = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const root = document.documentElement;

  // ---- score count-up in the HUD (arcade odometer, leading zeros) ----
  const scoreEl = document.getElementById('score1up');
  const TARGET = 657000;
  const pad = (n:number) => String(n).padStart(7, '0');
  if (scoreEl) {
    if (RM) {
      scoreEl.textContent = pad(TARGET) + '+';
    } else {
      const dur = 2000;
      let start = 0;
      const step = (t:number) => {
        if (!start) start = t;
        const p = Math.min(1, (t - start) / dur);
        const eased = 1 - Math.pow(1 - p, 3);
        scoreEl.textContent = pad(Math.floor(TARGET * eased));
        if (p < 1) requestAnimationFrame(step);
        else scoreEl.textContent = pad(TARGET) + '+';
      };
      requestAnimationFrame(step);
    }
  }

  // ---- pop-in reveal (only when motion allowed) ----
  if (!RM) {
    root.classList.add('js-anim');
    const pops = Array.from(document.querySelectorAll('.pop')) as HTMLElement[];
    if ('IntersectionObserver' in window) {
      const io = new IntersectionObserver((entries) => {
        entries.forEach(e => {
          if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); }
        });
      }, { threshold: 0.14, rootMargin: '0px 0px -8% 0px' });
      pops.forEach(el => io.observe(el));
      // failsafe: reveal everything after 3s no matter what
      setTimeout(() => pops.forEach(el => el.classList.add('in')), 3000);
    } else {
      pops.forEach(el => el.classList.add('in'));
    }
  }

  // ---- HUD level readout follows the section in view ----
  const hudLevel = document.getElementById('hud-level');
  const secs = Array.from(document.querySelectorAll('section[data-level]')) as HTMLElement[];
  if (hudLevel && secs.length && 'IntersectionObserver' in window) {
    const lvio = new IntersectionObserver((entries) => {
      // pick the most-visible section
      let best: IntersectionObserverEntry | null = null;
      entries.forEach(e => { if (!best || e.intersectionRatio > best.intersectionRatio) best = e; });
      if (best && best.isIntersecting) {
        const lv = (best.target as HTMLElement).dataset.level;
        if (lv) hudLevel.textContent = lv;
      }
    }, { threshold: [0.25, 0.55, 0.85] });
    secs.forEach(s => lvio.observe(s));
  }

  // ---- subtle parallax starfield (transform only, throttled to rAF) ----
  const s1 = document.getElementById('stars');
  const s2 = document.getElementById('stars2');
  if (!RM && (s1 || s2)) {
    let ticking = false;
    const onScroll = () => {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(() => {
        const y = window.scrollY || 0;
        if (s1) s1.style.transform = 'translate3d(0,' + (y * 0.06) + 'px,0)';
        if (s2) s2.style.transform = 'translate3d(0,' + (y * 0.14) + 'px,0)';
        ticking = false;
      });
    };
    window.addEventListener('scroll', onScroll, { passive: true });
    onScroll();
  }
</script>
</body>
