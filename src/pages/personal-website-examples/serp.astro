---
<!doctype html>
<html lang="en" data-theme="serp">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>Swapnil Biswas - Ranked #1 for the marketer who ships</title>
<meta name="robots" content="noindex" />
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Arimo:wght@400;500;700&display=swap" rel="stylesheet" />
<style>
  :root{
    --bg:#f6f8fc;          /* page background */
    --bg2:#eef1f8;         /* subtle top wash */
    --card:#ffffff;        /* result / panel card */
    --line:#e3e7ef;        /* hairline borders */
    --line2:#d4dae6;       /* stronger border */
    --ink:#1f2430;         /* primary text - AA on white/bg */
    --muted:#5f6570;       /* secondary text - AA (4.9:1 on white) */
    --faint:#646b7a;       /* tertiary / metadata - AA (4.7:1 on white) */
    --link:#1a56db;        /* result title blue */
    --link-v:#5b3bb5;      /* visited-ish */
    --url:#0b7a3b;         /* result URL green - AA on white */
    --violet:#7c3aed;      /* AI-overview accent */
    --violet-ink:#5b21b6;  /* darker violet for AA text on tint */
    --tint:#f5f1ff;        /* AI-overview card tint */
    --tint2:#efe8ff;
    --chip:#eef2fb;        /* neutral chip fill */
    --amber:#8a5a00;       /* rich-snippet accent text */
    --amber-bg:#fdf3d8;
    --shadow:0 1px 2px rgba(20,30,55,.06),0 6px 18px -10px rgba(20,30,55,.14);
    --shadow-lg:0 2px 6px rgba(20,30,55,.08),0 20px 44px -22px rgba(20,30,55,.28);
    --sans:"Inter","Arimo",system-ui,-apple-system,"Segoe UI",Roboto,Arial,sans-serif;
    --maxw:1120px;
    --gutter:clamp(14px,4vw,28px);
  }
  *{margin:0;padding:0;box-sizing:border-box}
  html,body{overflow-x:clip}
  html{scroll-behavior:smooth;background:var(--bg)}
  body{
    background:
      linear-gradient(180deg,var(--bg2),var(--bg) 220px),
      var(--bg);
    color:var(--ink);font-family:var(--sans);min-height:100vh;line-height:1.55;
    -webkit-font-smoothing:antialiased;text-rendering:optimizeLegibility;
    padding-bottom:0;
  }
  a{color:inherit;text-decoration:none}
  ::selection{background:#d7c8ff;color:#221a44}
  .wrap{max-width:var(--maxw);margin:0 auto;padding:0 var(--gutter)}

  /* ============ top search chrome ============ */
  .topbar{
    position:sticky;top:0;z-index:40;background:rgba(246,248,252,.86);
    backdrop-filter:saturate(1.4) blur(10px);-webkit-backdrop-filter:saturate(1.4) blur(10px);
    border-bottom:1px solid var(--line);
  }
  .topbar-inner{display:flex;align-items:center;gap:clamp(12px,3vw,24px);padding:14px var(--gutter);
    max-width:var(--maxw);margin:0 auto;flex-wrap:wrap}
  .logo{display:flex;align-items:baseline;gap:1px;font-weight:800;font-size:26px;letter-spacing:-.02em;
    line-height:1;flex:none;user-select:none}
  .logo .b{color:var(--link)} .logo .i{color:var(--url)} .logo .o1{color:#c98a00}
  .logo .o2{color:var(--violet)} .logo .k{color:var(--link)}
  .logo .dot{width:7px;height:7px;border-radius:50%;background:var(--violet);align-self:flex-end;
    margin:0 0 4px 3px}

  .searchform{flex:1 1 340px;min-width:0}
  .searchbox{display:flex;align-items:center;gap:10px;background:var(--card);border:1px solid var(--line2);
    border-radius:26px;padding:0 12px 0 16px;height:48px;box-shadow:var(--shadow);
    transition:box-shadow .2s,border-color .2s}
  .searchbox:focus-within{box-shadow:var(--shadow-lg);border-color:#c0c8da}
  .searchbox .mag{width:19px;height:19px;flex:none;color:var(--faint)}
  .searchbox input{flex:1;min-width:0;border:0;outline:0;background:transparent;font:inherit;
    font-size:clamp(15px,2vw,17px);color:var(--ink);padding:0;letter-spacing:-.005em}
  .searchbox .caret{display:inline-block;width:1.5px;height:20px;background:var(--link);
    animation:blink 1.1s steps(1) infinite}
  @keyframes blink{50%{opacity:0}}
  .searchbox .tools{display:flex;align-items:center;gap:10px;flex:none;color:var(--faint)}
  .searchbox .tools .ic{width:20px;height:20px;display:grid;place-items:center;cursor:default}
  .searchbox .tools .spark{color:var(--violet)}
  .searchbox .tools .sbtn{width:34px;height:34px;border-radius:50%;background:var(--link);color:#fff;
    display:grid;place-items:center;border:0;cursor:pointer}
  .searchbox .tools .sbtn svg{width:18px;height:18px}

  /* tabs */
  .tabs{border-bottom:1px solid var(--line);background:transparent}
  .tabs-inner{display:flex;gap:4px;max-width:var(--maxw);margin:0 auto;padding:0 var(--gutter);
    overflow-x:auto;scrollbar-width:none}
  .tabs-inner::-webkit-scrollbar{display:none}
  .tab{display:inline-flex;align-items:center;gap:7px;padding:12px 12px 11px;font-size:13.5px;
    font-weight:600;color:var(--muted);white-space:nowrap;border-bottom:3px solid transparent;
    position:relative;top:1px;transition:color .18s,border-color .18s;cursor:default}
  .tab svg{width:16px;height:16px}
  .tab.on{color:var(--link);border-color:var(--link)}
  .tab.ai{color:var(--violet)}
  .tab.ai.on{border-color:var(--violet)}
  .tab .ai-dot{color:var(--violet)}

  /* results-count line */
  .rcount{font-size:12.5px;color:var(--muted);padding:12px 0 4px}

  /* ============ layout ============ */
  .grid{display:grid;grid-template-columns:minmax(0,1fr) 340px;gap:clamp(20px,3.5vw,44px);
    padding:8px 0 60px;align-items:start}
  .col-main{min-width:0}
  .col-rail{min-width:0}

  /* ============ AI OVERVIEW ============ */
  .overview{position:relative;background:linear-gradient(180deg,var(--tint),#fff 70%);
    border:1px solid var(--tint2);border-radius:18px;padding:clamp(16px,2.4vw,22px);
    box-shadow:var(--shadow);overflow:hidden}
  .overview::before{content:"";position:absolute;inset:0;pointer-events:none;
    background:radial-gradient(120% 60% at 0% 0%,rgba(124,58,237,.07),transparent 60%);}
  .ov-head{display:flex;align-items:center;gap:10px;position:relative;z-index:1}
  .ov-spark{width:26px;height:26px;flex:none;color:var(--violet)}
  .ov-title{font-weight:700;font-size:16px;color:var(--ink);letter-spacing:-.01em}
  .ov-title .beta{font-weight:600;font-size:10px;letter-spacing:.06em;text-transform:uppercase;
    color:var(--violet-ink);background:#ede4ff;padding:2px 7px;border-radius:20px;margin-left:8px;
    vertical-align:middle}
  .ov-gen{margin-left:auto;font-size:11.5px;color:var(--violet-ink);display:inline-flex;align-items:center;
    gap:6px;font-weight:600}
  .ov-gen .live{width:7px;height:7px;border-radius:50%;background:var(--violet);
    box-shadow:0 0 0 0 rgba(124,58,237,.5)}
  .ov-body{position:relative;z-index:1;margin-top:14px;font-size:clamp(14.5px,1.8vw,16px);
    line-height:1.72;color:#2a3040}
  .ov-body p{margin:0 0 10px}
  .ov-body p:last-child{margin-bottom:0}
  .ov-body b{font-weight:700;color:var(--ink)}
  .cite{display:inline-block;font-size:11px;font-weight:700;color:var(--violet-ink);
    background:#ede4ff;border:1px solid #dbcbff;border-radius:6px;padding:0 5px;margin-left:2px;
    line-height:1.5;vertical-align:1px;transition:background .18s,transform .18s}
  a.cite:hover{background:#dcccff;transform:translateY(-1px)}

  /* shimmer skeleton (JS-only overlay; hidden by default so no-JS shows text) */
  .ov-skel{display:none;position:absolute;left:clamp(16px,2.4vw,22px);right:clamp(16px,2.4vw,22px);
    top:64px;z-index:2;pointer-events:none}
  html.js-ai .ov-skel{display:block}
  html.js-ai.ai-done .ov-skel{display:none}
  .ov-skel .bar{height:13px;border-radius:7px;margin-bottom:12px;
    background:linear-gradient(90deg,#ece4fb 0%,#f6f1ff 40%,#ece4fb 80%);
    background-size:220% 100%;animation:shim 1.25s linear infinite}
  .ov-skel .bar:nth-child(1){width:96%}
  .ov-skel .bar:nth-child(2){width:99%}
  .ov-skel .bar:nth-child(3){width:88%}
  .ov-skel .bar:nth-child(4){width:72%}
  @keyframes shim{to{background-position:-220% 0}}

  /* while streaming, hide the real text until JS reveals words */
  html.js-ai .ov-body{opacity:0}
  html.js-ai.ai-start .ov-body{opacity:1}
  .ov-body .w{transition:opacity .18s ease}
  html.js-ai .ov-body .w{opacity:0}
  html.js-ai .ov-body .w.in{opacity:1}
  html.js-ai.ai-done .ov-body,html.js-ai.ai-done .ov-body .w{opacity:1 !important}

  /* source favicon chips */
  .ov-sources{position:relative;z-index:1;margin-top:16px;padding-top:14px;
    border-top:1px solid var(--tint2);display:flex;flex-wrap:wrap;gap:8px;align-items:center}
  .ov-sources .lbl{font-size:11.5px;font-weight:600;color:var(--muted);margin-right:2px}
  .srcchip{display:inline-flex;align-items:center;gap:7px;background:#fff;border:1px solid var(--line2);
    border-radius:20px;padding:5px 11px 5px 5px;font-size:12px;font-weight:500;color:var(--ink);
    box-shadow:0 1px 2px rgba(20,30,55,.05);transition:transform .16s,box-shadow .16s,border-color .16s}
  a.srcchip:hover{transform:translateY(-1px);box-shadow:var(--shadow);border-color:#c6cfe0}
  .srcchip .fav{width:20px;height:20px;border-radius:50%;flex:none;display:grid;place-items:center;
    color:#fff;font-size:10px;font-weight:800;letter-spacing:-.02em}

  /* ============ FEATURED SNIPPET ============ */
  .snippet{background:var(--card);border:1px solid var(--line);border-radius:16px;
    box-shadow:var(--shadow);padding:clamp(16px,2.2vw,20px);margin-top:16px;position:relative}
  .snip-tag{display:inline-flex;align-items:center;gap:6px;font-size:11px;font-weight:700;
    letter-spacing:.05em;text-transform:uppercase;color:var(--amber);background:var(--amber-bg);
    border-radius:20px;padding:4px 10px}
  .snip-lede{margin-top:12px;font-size:clamp(16px,2.4vw,19px);line-height:1.55;color:var(--ink);
    font-weight:500;letter-spacing:-.01em}
  .snip-lede b{font-weight:800;color:var(--link)}
  .snip-metrics{display:grid;grid-template-columns:repeat(3,1fr);gap:10px;margin-top:16px}
  .snip-metrics .m{background:var(--bg);border:1px solid var(--line);border-radius:12px;padding:12px 10px;
    text-align:center}
  .snip-metrics .mv{font-size:clamp(20px,4vw,26px);font-weight:800;color:var(--ink);letter-spacing:-.02em;
    line-height:1}
  .snip-metrics .ml{font-size:11px;color:var(--muted);margin-top:5px;font-weight:500}
  .snip-cta{display:flex;flex-wrap:wrap;gap:9px;margin-top:16px}
  .btn{display:inline-flex;align-items:center;gap:7px;font-size:13.5px;font-weight:600;
    border-radius:24px;padding:10px 18px;transition:transform .18s,box-shadow .18s,background .18s,border-color .18s;
    cursor:pointer;border:1px solid transparent}
  .btn svg{width:15px;height:15px}
  .btn.primary{background:var(--link);color:#fff;box-shadow:0 4px 14px -4px rgba(26,86,219,.5)}
  .btn.primary:hover{transform:translateY(-2px);box-shadow:0 8px 20px -6px rgba(26,86,219,.55)}
  .btn.ghost{background:#fff;color:var(--link);border-color:var(--line2)}
  .btn.ghost:hover{border-color:var(--link);transform:translateY(-2px)}
  .snip-source{margin-top:14px;display:flex;align-items:center;gap:8px;font-size:12px;color:var(--url)}
  .snip-source .fav{width:16px;height:16px;border-radius:50%;background:var(--link);color:#fff;
    font-size:9px;font-weight:800;display:grid;place-items:center;flex:none}

  /* ============ ORGANIC RESULTS ============ */
  .results{margin-top:26px}
  .results-h{font-size:12.5px;font-weight:700;letter-spacing:.04em;text-transform:uppercase;
    color:var(--faint);margin:0 0 6px 2px}
  .result{padding:16px 2px 18px;border-top:1px solid var(--line)}
  .result:first-of-type{border-top:0}
  .r-url{display:flex;align-items:center;gap:9px}
  .r-fav{width:26px;height:26px;border-radius:50%;background:#eef2fb;border:1px solid var(--line2);
    display:grid;place-items:center;flex:none;font-size:11px;font-weight:800;color:var(--link)}
  .r-crumb{min-width:0}
  .r-site{font-size:13px;color:var(--ink);line-height:1.2;font-weight:500}
  .r-path{font-size:12px;color:var(--url);line-height:1.3;display:flex;flex-wrap:wrap;gap:3px;align-items:center}
  .r-path .sep{color:var(--faint)}
  .r-title{display:inline-block;margin:6px 0 2px;font-size:clamp(18px,2.6vw,21px);line-height:1.3;
    color:var(--link);font-weight:500;letter-spacing:-.01em}
  .r-title:hover{text-decoration:underline}
  .result.feat .r-title{color:var(--link)}
  .r-meta{display:flex;flex-wrap:wrap;align-items:center;gap:8px;margin:2px 0 4px;font-size:12.5px;
    color:var(--muted)}
  .r-meta .date{color:var(--faint)}
  .r-chip{font-size:11px;font-weight:700;letter-spacing:.02em;padding:2px 8px;border-radius:6px;
    background:var(--chip);color:#33507f}
  .r-chip.hot{background:#eafaf0;color:var(--url)}
  .r-chip.star{background:#fdf3d8;color:var(--amber);display:inline-flex;align-items:center;gap:4px}
  .r-desc{font-size:14px;line-height:1.6;color:#3d434f;margin-top:4px}
  .result.feat{background:linear-gradient(180deg,#fbfcff,#fff);border:1px solid var(--line);
    border-radius:14px;padding:16px;box-shadow:var(--shadow);margin-bottom:4px}
  .r-sublinks{display:grid;grid-template-columns:1fr 1fr;gap:8px 18px;margin-top:12px}
  .r-sublink .st{font-size:14px;color:var(--link);font-weight:500}
  .r-sublink .st:hover{text-decoration:underline}
  .r-sublink .sd{font-size:12px;color:var(--muted);line-height:1.45}

  /* discipline results block */
  .disc{margin-top:26px}
  .disc .result .r-fav{color:var(--violet);background:#f2ecff;border-color:#e2d6ff}
  .disc .r-title{color:var(--link)}

  /* shipped inline stat strip */
  .shipstrip{display:grid;grid-template-columns:repeat(3,1fr);gap:10px;margin-top:16px}
  .shipstrip .s{background:var(--card);border:1px solid var(--line);border-radius:12px;padding:14px 12px}
  .shipstrip .sn{font-size:clamp(22px,4vw,28px);font-weight:800;color:var(--violet-ink);letter-spacing:-.02em;
    line-height:1}
  .shipstrip .sl{font-size:12px;color:var(--muted);margin-top:6px;line-height:1.4;font-weight:500}

  /* ============ PEOPLE ALSO ASK ============ */
  .paa{margin-top:30px;background:var(--card);border:1px solid var(--line);border-radius:16px;
    box-shadow:var(--shadow);overflow:hidden}
  .paa-h{display:flex;align-items:center;gap:9px;padding:16px 18px 12px;font-size:19px;font-weight:700;
    color:var(--ink);letter-spacing:-.01em}
  .paa-h svg{width:20px;height:20px;color:var(--violet)}
  .paa-item{border-top:1px solid var(--line)}
  .paa-q{width:100%;text-align:left;background:none;border:0;cursor:pointer;font:inherit;
    display:flex;align-items:center;justify-content:space-between;gap:12px;padding:15px 18px;
    font-size:15.5px;font-weight:500;color:var(--ink);line-height:1.4}
  .paa-q:hover{color:var(--link)}
  .paa-q .ch{width:20px;height:20px;flex:none;color:var(--faint);transition:transform .25s ease}
  .paa-item[open] .paa-q .ch,.paa-item.open .paa-q .ch{transform:rotate(180deg)}
  .paa-a{padding:0 18px 17px;font-size:14px;line-height:1.65;color:#3d434f}
  /* no-JS: use <details>; JS enhances but content always present */
  details.paa-item>summary{list-style:none}
  details.paa-item>summary::-webkit-details-marker{display:none}
  details.paa-item[open] .paa-q .ch{transform:rotate(180deg)}

  /* ============ KNOWLEDGE PANEL (right rail) ============ */
  .panel{position:sticky;top:132px;background:var(--card);border:1px solid var(--line);
    border-radius:18px;box-shadow:var(--shadow-lg);overflow:hidden}
  .panel-hero{padding:22px 20px 18px;background:
      radial-gradient(120% 90% at 100% 0%,rgba(124,58,237,.12),transparent 60%),
      linear-gradient(180deg,#faf8ff,#fff);border-bottom:1px solid var(--line);text-align:center}
  .mono{width:74px;height:74px;margin:0 auto 12px;border-radius:20px;display:grid;place-items:center;
    color:#fff;font-weight:800;font-size:28px;letter-spacing:-.02em;
    background:linear-gradient(135deg,var(--violet),#4f46e5);
    box-shadow:0 10px 24px -8px rgba(124,58,237,.55)}
  .panel-name{font-size:22px;font-weight:800;color:var(--ink);letter-spacing:-.02em;line-height:1.1}
  .panel-role{margin-top:5px;font-size:13px;color:var(--muted);line-height:1.45}
  .verified{display:inline-flex;align-items:center;gap:5px;margin-top:9px;font-size:11.5px;font-weight:600;
    color:var(--link);background:#eaf1ff;border-radius:20px;padding:4px 11px}
  .verified svg{width:14px;height:14px}

  .facts{padding:14px 20px 6px}
  .fact{display:flex;gap:12px;padding:9px 0;border-top:1px solid var(--line);font-size:13px}
  .fact:first-child{border-top:0}
  .fact .k{color:var(--faint);flex:none;width:82px;font-weight:600}
  .fact .v{color:var(--ink);line-height:1.5}

  .panel-actions{display:grid;grid-template-columns:1fr 1fr;gap:9px;padding:8px 20px 4px}
  .pa{display:inline-flex;align-items:center;justify-content:center;gap:7px;font-size:13px;font-weight:600;
    border-radius:11px;padding:11px 8px;transition:transform .18s,box-shadow .18s,background .18s;
    border:1px solid var(--line2)}
  .pa svg{width:16px;height:16px}
  .pa.mail{background:var(--link);color:#fff;border-color:transparent;
    box-shadow:0 4px 12px -4px rgba(26,86,219,.5)}
  .pa.mail:hover{transform:translateY(-2px)}
  .pa.li{background:#fff;color:#0a66c2}
  .pa.li:hover{transform:translateY(-2px);border-color:#0a66c2}

  .panel-sub{padding:14px 20px 4px}
  .panel-sub h4{font-size:11.5px;font-weight:700;letter-spacing:.05em;text-transform:uppercase;
    color:var(--faint);margin-bottom:9px}
  .known{display:flex;flex-wrap:wrap;gap:6px}
  .known span{font-size:12px;font-weight:500;color:var(--ink);background:var(--chip);border:1px solid var(--line);
    border-radius:8px;padding:5px 9px}
  .profiles{display:flex;flex-direction:column;gap:2px;padding:6px 20px 18px}
  .profile{display:flex;align-items:center;gap:10px;padding:9px 0;border-top:1px solid var(--line);
    font-size:13px}
  .profile:first-child{border-top:0}
  .profile .pf{width:24px;height:24px;border-radius:6px;flex:none;display:grid;place-items:center;
    color:#fff;font-size:10px;font-weight:800}
  .profile .pk{color:var(--faint);flex:none;width:64px;font-weight:600;font-size:12px}
  .profile .pv{color:var(--link);word-break:break-word}
  .profile:hover .pv{text-decoration:underline}

  /* awards mini list in panel */
  .awards{padding:2px 20px 18px}
  .award{display:flex;gap:10px;align-items:flex-start;padding:9px 0;border-top:1px solid var(--line);
    font-size:12.5px}
  .award:first-child{border-top:0}
  .award .medal{width:22px;height:22px;flex:none;color:#c98a00}
  .award b{display:block;font-size:13px;font-weight:700;color:var(--ink);line-height:1.3}
  .award span{color:var(--muted);font-size:12px}

  /* ============ footer chrome ============ */
  .related{background:#eef1f8;border-top:1px solid var(--line);padding:26px 0}
  .related h3{font-size:18px;font-weight:700;color:var(--ink);margin-bottom:14px;letter-spacing:-.01em}
  .related-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(230px,1fr));gap:10px}
  .rel{display:flex;align-items:center;gap:11px;background:#fff;border:1px solid var(--line);
    border-radius:24px;padding:10px 16px;font-size:13.5px;color:var(--ink);font-weight:500;
    transition:transform .16s,box-shadow .16s,border-color .16s}
  .rel:hover{transform:translateY(-1px);box-shadow:var(--shadow);border-color:#c6cfe0}
  .rel svg{width:16px;height:16px;flex:none;color:var(--faint)}

  .sitelinks{background:var(--bg);padding:22px 0 8px}
  .sitelinks-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(180px,1fr));gap:12px}
  .sl{display:block;background:#fff;border:1px solid var(--line);border-radius:12px;padding:14px 16px;
    transition:transform .16s,box-shadow .16s}
  .sl:hover{transform:translateY(-2px);box-shadow:var(--shadow)}
  .sl .slt{font-size:15px;color:var(--link);font-weight:600}
  .sl:hover .slt{text-decoration:underline}
  .sl .sld{font-size:12.5px;color:var(--muted);margin-top:3px}

  /* pagination-ish flourish */
  .pager{display:flex;justify-content:center;align-items:center;gap:4px;padding:22px 0 6px;
    font-size:15px;color:var(--muted);letter-spacing:.04em}
  .pager .g{font-weight:800;font-size:24px;letter-spacing:-.02em;display:flex;gap:1px}
  .pager .g .b{color:var(--link)}.pager .g .i{color:var(--url)}.pager .g .o1{color:#c98a00}
  .pager .g .o2{color:var(--violet)}.pager .g .k{color:var(--link)}
  .pager .cur{color:var(--ink);font-weight:700}
  .pager a{color:var(--link);padding:0 6px}

  /* ============ site footer (outside the SERP object) ============ */
  .foot{border-top:1px solid var(--line);background:#e9edf5;color:var(--muted)}
  .foot-inner{max-width:var(--maxw);margin:0 auto;padding:16px var(--gutter);display:flex;
    justify-content:space-between;flex-wrap:wrap;gap:8px;font-size:12px;letter-spacing:.02em}
  .foot a{color:var(--link);border-bottom:1px solid transparent;transition:border-color .2s}
  .foot a:hover{border-color:var(--link)}

  /* ============ responsive ============ */
  @media(max-width:900px){
    .grid{grid-template-columns:1fr}
    .panel{position:static;top:auto}
    .col-rail{order:-1}      /* knowledge panel first on mobile, like a real SERP */
  }
  @media(max-width:560px){
    .snip-metrics{grid-template-columns:1fr;gap:8px}
    .snip-metrics .m{display:flex;align-items:baseline;justify-content:space-between;text-align:left}
    .snip-metrics .ml{margin-top:0}
    .r-sublinks{grid-template-columns:1fr}
    .panel-actions{grid-template-columns:1fr}
    .logo{font-size:22px}
  }

  @media(prefers-reduced-motion:reduce){
    html{scroll-behavior:auto}
    *{animation-duration:.001ms !important;animation-iteration-count:1 !important;
      transition-duration:.001ms !important}
    .searchbox .caret{animation:none;opacity:1}
    html.js-ai .ov-body,html.js-ai .ov-body .w{opacity:1 !important}
    html.js-ai .ov-skel{display:none !important}
  }
</style>
</head>
<body>

  <!-- ===== TOP SEARCH CHROME ===== -->
  <header class="topbar">
    <div class="topbar-inner">
      <div class="logo" aria-label="Search">
        <span class="b">B</span><span class="i">i</span><span class="o1">o</span><span class="o2">g</span><span class="k">le</span><span class="dot" aria-hidden="true"></span>
      </div>
      <form class="searchform" role="search" onsubmit="return false;">
        <div class="searchbox">
          <svg class="mag" viewBox="0 0 24 24" fill="none" aria-hidden="true"><circle cx="11" cy="11" r="7" stroke="currentColor" stroke-width="2"/><path d="M21 21l-4.3-4.3" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
          <input id="q" type="text" value={query} aria-label="Search query" autocomplete="off" spellcheck="false" />
          <div class="tools" aria-hidden="true">
            <span class="ic spark" title="AI search"><svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 2l1.8 4.6L18.5 8.4l-3.7 3 1.3 4.9L12 13.9 7.9 16.3l1.3-4.9-3.7-3 4.7-1.8z"/></svg></span>
            <span class="ic" title="Voice"><svg viewBox="0 0 24 24" fill="none"><rect x="9" y="3" width="6" height="12" rx="3" fill="#4285f4"/><path d="M6 11a6 6 0 0012 0M12 17v4" stroke="#34a853" stroke-width="2" stroke-linecap="round"/></svg></span>
            <button type="submit" class="sbtn" aria-label="Search"><svg viewBox="0 0 24 24" fill="none"><circle cx="11" cy="11" r="7" stroke="currentColor" stroke-width="2"/><path d="M21 21l-4.3-4.3" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg></button>
          </div>
        </div>
      </form>
    </div>
    <nav class="tabs" aria-label="Result types">
      <div class="tabs-inner">
        <span class="tab on">
          <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="1.8"/><path d="M3 12h18M12 3c3 3 3 15 0 18M12 3c-3 3-3 15 0 18" stroke="currentColor" stroke-width="1.4"/></svg>
          All
        </span>
        <span class="tab">
          <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><rect x="3" y="4" width="18" height="16" rx="2" stroke="currentColor" stroke-width="1.8"/><path d="M3 15l5-4 4 3 3-2 6 5" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/><circle cx="8" cy="9" r="1.4" fill="currentColor"/></svg>
          Images
        </span>
        <span class="tab">
          <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2" stroke="currentColor" stroke-width="1.8"/><path d="M7 9h6M7 13h10M7 16h10" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
          News
        </span>
        <span class="tab ai">
          <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2l1.6 4.2L18 7.8l-3.4 2.6 1.2 4.4L12 12.6 8.2 14.8l1.2-4.4L6 7.8l4.4-1.6z"/></svg>
          AI Mode
        </span>
        <span class="tab">Maps</span>
        <span class="tab">More</span>
      </div>
    </nav>
  </header>

  <div class="wrap">
    <p class="rcount">About 657,000 results (0.42 seconds)</p>
  </div>

  <div class="wrap">
    <div class="grid">

      <!-- ============ MAIN COLUMN ============ -->
      <main class="col-main">

        <!-- ===== AI OVERVIEW ===== -->
        <section class="overview" aria-labelledby="ov-title">
          <div class="ov-head">
            <svg class="ov-spark" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 1.5l1.9 5.1 5.1 1.9-5.1 1.9L12 15.5l-1.9-5.1L5 8.5l5.1-1.9z"/><path d="M19 14l.9 2.4L22 17.3l-2.1.9L19 20.6l-.9-2.4L16 17.3l2.1-.9z"/></svg>
            <span class="ov-title" id="ov-title">AI Overview<span class="beta">AEO</span></span>
            <span class="ov-gen" id="ovGen"><span class="live" aria-hidden="true"></span> Generated</span>
          </div>

          <!-- shimmer skeleton (JS-only; hidden with no JS) -->
          <div class="ov-skel" aria-hidden="true">
            <div class="bar"></div><div class="bar"></div><div class="bar"></div><div class="bar"></div>
          </div>

          <!-- real synthesized answer: fully in markup, visible without JS -->
          <div class="ov-body" id="ovBody">
            <p><b>Swapnil Biswas</b> is a Senior Product Marketing Manager at LambdaTest who engineers the growth rather than just describing it. He builds the AI agents, websites and SEO systems behind <b>657K+ leads</b> and <b>18.2M+ in organic traffic</b>, running product marketing, technical SEO and AEO as engineering disciplines.<a class="cite" href="#results" aria-label="Source 1: selected work">[1]</a><a class="cite" href="#panel" aria-label="Source 2: profile">[2]</a></p>
            <p>Across seven-plus years in marketing and four-plus in B2B SaaS, he has shipped 20+ AI agents and internal tools, published 76 long-form articles, and led the full rebrand from LambdaTest to TestMu AI. His work spans Samsung, Medilife, Lido Learning and Appknox, with recognition including a #1 Product of the Day on Product Hunt.<a class="cite" href="#disciplines" aria-label="Source 3: disciplines">[3]</a></p>
          </div>

          <div class="ov-sources">
            <span class="lbl">Sources</span>
            {sources.map(s => (
              <a class="srcchip" href={s.n === 'linkedin.com' ? 'https://www.linkedin.com/in/swapbiswas/' : '#results'}>
                <span class="fav" style={`background:${s.c}`}>{s.g}</span>{s.n}
              </a>
            ))}
          </div>
        </section>

        <!-- ===== FEATURED SNIPPET ===== -->
        <section class="snippet" aria-labelledby="snip-h">
          <span class="snip-tag">
            <svg viewBox="0 0 24 24" width="13" height="13" fill="currentColor" aria-hidden="true"><path d="M12 2l3 6.3 6.9.9-5 4.8 1.2 6.9L12 17.8 5.9 20.9 7.1 14 2 9.2l6.9-.9z"/></svg>
            Featured snippet
          </span>
          <h2 class="snip-lede" id="snip-h">I build the agents, sites and SEO systems behind <b>657K+ leads</b> and <b>18.2M+ in organic traffic</b> - not just the decks that describe them. A product marketer who actually engineers the growth.</h2>
          <div class="snip-metrics">
            {metrics.map(m => (
              <div class="m"><div class="mv">{m.v}</div><div class="ml">{m.l}</div></div>
            ))}
          </div>
          <div class="snip-cta">
            <a class="btn primary" href="#results">
              <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><circle cx="11" cy="11" r="7" stroke="currentColor" stroke-width="2"/><path d="M21 21l-4.3-4.3" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
              View the work
            </a>
            <a class="btn ghost" href="#panel">Get in touch</a>
          </div>
          <div class="snip-source">
            <span class="fav" aria-hidden="true">S</span>
            swapbiswas.com &rsaquo; about &rsaquo; positioning
          </div>
        </section>

        <!-- ===== ORGANIC RESULTS (selected work) ===== -->
        <section class="results" id="results" aria-label="Organic results - selected work">
          <p class="results-h">Selected work &middot; 6 shipped engagements</p>
          {results.map(r => (
            <article class={'result' + (r.feat ? ' feat' : '')}>
              <div class="r-url">
                <span class="r-fav" aria-hidden="true">{r.crumb[0].charAt(0).toUpperCase()}</span>
                <div class="r-crumb">
                  <div class="r-site">{r.crumb[0]}</div>
                  <div class="r-path">
                    {r.crumb.slice(1).map((c, idx) => (
                      <>{idx > 0 && <span class="sep">&rsaquo;</span>}<span>{c}</span></>
                    ))}
                  </div>
                </div>
              </div>
              <a class="r-title" href="#panel">{r.title}</a>
              <div class="r-meta">
                <span class="date">{r.date}</span>
                {r.chips.map(c => (
                  <span class={'r-chip' + (c.includes('LEADS') ? ' hot' : '') + (c === 'Featured' ? ' star' : '')}>
                    {c === 'Featured' && <svg viewBox="0 0 24 24" width="11" height="11" fill="currentColor" aria-hidden="true"><path d="M12 2l3 6.3 6.9.9-5 4.8 1.2 6.9L12 17.8 5.9 20.9 7.1 14 2 9.2l6.9-.9z"/></svg>}
                    {c}
                  </span>
                ))}
              </div>
              <p class="r-desc">{r.desc}</p>
              {r.sub && (
                <div class="r-sublinks">
                  {r.sub.map(s => (
                    <div class="r-sublink"><a class="st" href="#results">{s.t}</a><div class="sd">{s.d}</div></div>
                  ))}
                </div>
              )}
            </article>
          ))}
        </section>

        <!-- ===== DISCIPLINES (indented results) ===== -->
        <section class="results disc" id="disciplines" aria-label="Disciplines">
          <p class="results-h">Disciplines &middot; one operator, four systems</p>
          {disciplines.map(d => (
            <article class="result">
              <div class="r-url">
                <span class="r-fav" aria-hidden="true">{d.i}</span>
                <div class="r-crumb">
                  <div class="r-site">swapbiswas.com</div>
                  <div class="r-path"><span>disciplines</span><span class="sep">&rsaquo;</span><span>{d.t.toLowerCase().replace(/[^a-z]+/g,'-').replace(/^-|-$/g,'')}</span></div>
                </div>
              </div>
              <a class="r-title" href="#panel">{d.t}</a>
              <p class="r-desc">{d.d}</p>
            </article>
          ))}
          <div class="shipstrip">
            {shipped.map(s => (
              <div class="s"><div class="sn">{s.n}</div><div class="sl">{s.l}</div></div>
            ))}
          </div>
        </section>

        <!-- ===== PEOPLE ALSO ASK ===== -->
        <section class="paa" id="paa" aria-label="People also ask">
          <div class="paa-h">
            <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="1.8"/><path d="M9.2 9.2a2.8 2.8 0 115 1.6c-.8.7-1.7 1-1.7 2.2" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/><circle cx="12" cy="16.6" r="1" fill="currentColor"/></svg>
            People also ask
          </div>
          {paa.map((p, idx) => (
            <details class="paa-item" open={idx === 0}>
              <summary class="paa-q">
                {p.q}
                <svg class="ch" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M6 9l6 6 6-6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </summary>
              <div class="paa-a">{p.a}</div>
            </details>
          ))}
        </section>

        <!-- ===== PAGINATION FLOURISH ===== -->
        <div class="pager" aria-label="Result pages">
          <span class="g" aria-hidden="true"><span class="b">B</span><span class="i">i</span><span class="o1">o</span><span class="o2">g</span><span class="k">o</span><span class="b">o</span><span class="o1">o</span><span class="k">gle</span></span>
          <span style="width:8px"></span>
          <span class="cur">1</span><a href="#results">2</a><a href="#results">3</a><a href="#results">4</a>
          <a href="#results">Next &rsaquo;</a>
        </div>
      </main>

      <!-- ============ KNOWLEDGE PANEL ============ -->
      <aside class="col-rail" id="panel">
        <div class="panel">
          <div class="panel-hero">
            <div class="mono" aria-hidden="true">SB</div>
            <h1 class="panel-name">Swapnil Biswas</h1>
            <div class="panel-role">Senior Product Marketing Manager, LambdaTest</div>
            <span class="verified">
              <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2l2.4 1.8 3-.2 1 2.8 2.6 1.5-.9 2.9.9 2.9-2.6 1.5-1 2.8-3-.2L12 22l-2.4-1.8-3 .2-1-2.8L3 16.3l.9-2.9L3 10.5l2.6-1.5 1-2.8 3 .2z"/><path d="M8.5 12.2l2.2 2.2 4.6-4.6" stroke="#fff" stroke-width="1.8" fill="none" stroke-linecap="round" stroke-linejoin="round"/></svg>
              Verified positioning
            </span>
          </div>

          <div class="facts">
            <div class="fact"><span class="k">Based</span><span class="v">Mumbai, India</span></div>
            <div class="fact"><span class="k">Tenure</span><span class="v">7+ yrs marketing &middot; 4+ in B2B SaaS</span></div>
            <div class="fact"><span class="k">Education</span><span class="v">Postgrad in Digital Marketing &amp; Growth Strategy, IIM Visakhapatnam</span></div>
            <div class="fact"><span class="k">Practice</span><span class="v">PMM &amp; growth strategist who codes AI agents, ships websites and runs technical SEO</span></div>
          </div>

          <div class="panel-actions">
            <a class="pa mail" href="mailto:swapbiswas.marketing@gmail.com">
              <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2" stroke="currentColor" stroke-width="1.8"/><path d="M4 7l8 6 8-6" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
              Email
            </a>
            <a class="pa li" href="https://www.linkedin.com/in/swapbiswas/">
              <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M4.5 3.5A2 2 0 104.5 7.5 2 2 0 004.5 3.5zM3 9h3v12H3zM9 9h2.9v1.7h.04c.4-.75 1.4-1.55 2.86-1.55 3.06 0 3.62 2 3.62 4.6V21h-3v-5.2c0-1.24-.02-2.83-1.73-2.83-1.73 0-2 1.35-2 2.74V21H9z"/></svg>
              LinkedIn
            </a>
          </div>

          <div class="panel-sub">
