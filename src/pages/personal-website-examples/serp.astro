    title: 'Lido Learning - growth, CRM and lead operations',
    date: '2021',
    chips: ['LEAD OPS'],
    desc: 'Ran CRM management and lead routing and assignment for the EdTech.',
  },
  {
    crumb: ['swapbiswas.com', 'work', 'appknox'],
    title: 'Appknox - freelance security content',
