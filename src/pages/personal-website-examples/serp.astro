];

const sitelinks = [
  { t: 'Selected work', d: 'Six shipped engagements', href: '#results' },
  { t: 'Disciplines', d: 'PMM, SEO/AEO, AI, in public', href: '#disciplines' },
  { t: 'People also ask', d: 'The FAQ, answered', href: '#paa' },
  { t: 'Contact', d: 'Email and LinkedIn', href: '#panel' },
