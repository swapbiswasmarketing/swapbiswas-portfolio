// People Also Ask = disciplines + recognition rendered as expandable Q&A.
const paa = [
  {
    q: 'What does Swapnil Biswas actually do?',
    a: 'He is a Senior Product Marketing Manager at LambdaTest who engineers the growth, not just the decks that describe it. He builds the AI agents, sites and SEO systems behind the numbers.',
  },
