    </div>
  </footer>

<script>
  // Vanilla, light. Two enhancements only: (1) AI Overview "generate in" shimmer + word stream,
  // (2) People-Also-Ask single-open accordion nicety. Everything degrades to full content with no JS.
  const RM = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const root = document.documentElement;

  /* ---------- 1. AI OVERVIEW generate + stream ---------- */
  (function aiOverview(){
    const body = document.getElementById('ovBody');
    const gen = document.getElementById('ovGen');
    if(!body) return;

    // Reduced motion: leave the overview fully rendered (markup default). No shimmer, no stream.
    if(RM){ return; }

    // Wrap each text node's words in spans so we can fade them in. Citations stay attached to
    // the word they follow. We only touch text nodes, preserving <b> and <a class="cite">.
    const words = [];
    function wrapWords(node){
      const kids = Array.from(node.childNodes);
      for(const k of kids){
        if(k.nodeType === 3){ // text
          const parts = k.textContent.split(/(\s+)/);
          const frag = document.createDocumentFragment();
          for(const p of parts){
            if(p === '') continue;
            if(/^\s+$/.test(p)){ frag.appendChild(document.createTextNode(p)); continue; }
            const span = document.createElement('span');
            span.className = 'w';
            span.textContent = p;
            frag.appendChild(span);
            words.push(span);
          }
          node.replaceChild(frag, k);
        } else if(k.nodeType === 1){
          if(k.classList && k.classList.contains('cite')){
            k.classList.add('w'); words.push(k);   // reveal citation chips inline too
          } else {
            wrapWords(k); // recurse into <b>, <p>
          }
        }
      }
    }

    let finished = false;
    function finalize(){
      if(finished) return; finished = true;
      root.classList.add('ai-done');           // CSS forces all words + skeleton to final
      words.forEach(w => w.classList.add('in'));
    }

    // Hard safety net ARMED BEFORE any DOM mutation: even if wrapWords throws or the
    // observer never fires, the overview can never stay stuck hidden - it force-finalizes.
    const safety = window.setTimeout(finalize, 2600);

    root.classList.add('js-ai');   // shows skeleton, hides body text (CSS)
    try { wrapWords(body); } catch(e){ finalize(); return; }

    function startStream(){
      // brief shimmer, then reveal body and stream words
      setTimeout(() => {
        if(finished) return;
        root.classList.add('ai-start'); // body opacity 1; individual words still hidden
        let i = 0;
        const total = words.length;
        const per = Math.max(10, Math.min(34, 900 / Math.max(total,1)));
        function step(){
          if(finished) return;
          // reveal a small batch per frame for a smooth "streamed" feel
          const batch = 2;
          for(let b=0;b<batch && i<total;b++,i++){ words[i].classList.add('in'); }
          if(i >= total){ root.classList.add('ai-done'); clearTimeout(safety); finished = true; return; }
          setTimeout(() => requestAnimationFrame(step), per);
        }
        requestAnimationFrame(step);
      }, 620);
    }

    // Trigger immediately since the overview sits at the top of the page (in view on load).
    // Still guard with IntersectionObserver in case it is scrolled; either path is safe.
    if('IntersectionObserver' in window){
      const io = new IntersectionObserver((entries) => {
        entries.forEach(e => { if(e.isIntersecting){ io.disconnect(); startStream(); } });
      }, { threshold: 0.15 });
      io.observe(document.querySelector('.overview'));
      // and kick immediately if already visible
      const r = document.querySelector('.overview').getBoundingClientRect();
      if(r.top < window.innerHeight && r.bottom > 0){ io.disconnect(); startStream(); }
    } else {
      startStream();
    }
  })();

  /* ---------- 2. People Also Ask: single-open accordion polish ---------- */
  (function paa(){
    const items = Array.from(document.querySelectorAll('.paa-item'));
    if(!items.length) return;
    items.forEach(d => {
      d.addEventListener('toggle', () => {
        if(d.open){
          items.forEach(o => { if(o !== d) o.open = false; });
        }
      });
    });
  })();
</script>
</body>
