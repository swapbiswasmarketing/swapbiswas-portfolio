  <div class="toast" id="toast" role="status" aria-live="polite">Copied</div>

<script>
  const RM = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const root = document.documentElement;

  // ---------- reveal-on-scroll (with safety-net) ----------
  const blocks = Array.from(document.querySelectorAll('.reveal')) as HTMLElement[];
  if (!RM && blocks.length && 'IntersectionObserver' in window) {
    root.classList.add('js-anim');          // opt into hidden->reveal (default CSS stays visible without this)
    const finalizeAll = () => blocks.forEach(b => b.classList.add('in'));

    const io = new IntersectionObserver((entries, obs) => {
      entries.forEach(e => {
        if (e.isIntersecting) { (e.target as HTMLElement).classList.add('in'); obs.unobserve(e.target); }
      });
    }, { rootMargin: '0px 0px -8% 0px', threshold: 0.08 });

    blocks.forEach(b => {
      const r = b.getBoundingClientRect();
      if (r.top < window.innerHeight && r.bottom > 0) b.classList.add('in'); // already in view on load
      else io.observe(b);
    });

    // SAFETY NET: force every block to final visible state within ~2.7s no matter what.
    window.setTimeout(finalizeAll, 2700);
  }
  // (RM path: no js-anim class added -> default CSS shows all blocks in final state.)

  // ---------- side rail active-section tracking ----------
  const railLinks = Array.from(document.querySelectorAll('.rail a')) as HTMLElement[];
  const railMap = new Map(railLinks.map(a => [a.getAttribute('data-rail'), a]));
  if (railLinks.length && 'IntersectionObserver' in window) {
    const secObs = new IntersectionObserver((entries) => {
      entries.forEach(e => {
        if (e.isIntersecting) {
          railLinks.forEach(a => a.classList.remove('active'));
          const link = railMap.get(e.target.id);
          if (link) link.classList.add('active');
        }
      });
    }, { rootMargin: '-45% 0px -45% 0px', threshold: 0 });
    document.querySelectorAll('section[id]').forEach(s => secObs.observe(s));
  }

  // ---------- swatch: click to copy hex ----------
  const toast = document.getElementById('toast') as HTMLElement | null;
  let toastT = 0;
  function showToast(msg: string) {
    if (!toast) return;
    toast.textContent = msg;
    toast.classList.add('show');
    clearTimeout(toastT);
    toastT = window.setTimeout(() => toast.classList.remove('show'), 1400);
  }
  document.querySelectorAll('.swatch').forEach(el => {
    el.addEventListener('click', () => {
      const hex = (el as HTMLElement).getAttribute('data-hex') || '';
      if (navigator.clipboard && navigator.clipboard.writeText) {
        navigator.clipboard.writeText(hex).then(() => showToast(hex + ' copied')).catch(() => showToast(hex));
      } else {
        showToast(hex);
      }
    });
  });
</script>
