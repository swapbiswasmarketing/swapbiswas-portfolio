---
// REDESIGN PROTOTYPE - "Exchange" - Concept 42.
// The career rendered as a live stock market / trading-floor big board. Original concept
// (NOT a reskin): own layout + interaction + palette + fonts + signature mechanic.
//  - A TICKER TAPE scrolls across the very top (CSS translateX marquee, duplicated track for a
//    seamless loop, pause on hover). Career quoted as real market anatomy: a hero INDEX QUOTE with
//    last price + MARKET OPEN pill, index cards quoted like stocks (count up on load), a MARKET
//    BOARD table of selected work (symbol / name / position / year / last / chg + sparkline), an
//    animated CANDLESTICK chart for career growth 2018-2026 (candles grow scaleY when scrolled in),
//    a SECTORS panel (disciplines), a VOLUME readout (shipped), ANALYST RATINGS (recognition,
//    BUY / STRONG BUY), a WATCHLIST chip row (brands), a COMPANY PROFILE facts table (about) and a
//    PLACE ORDER contact panel (email + linkedin as the two actions).
//  - Near-black trading terminal bg + faint green grid, UP green + amber accent, mono numbers.
// Self-contained: own <html>, own Google Fonts <link>, own CSS tokens, noindex. No BaseLayout.
// GOTCHA NOTES: every quote/number/row lives in the Astro markup and is FULLY VISIBLE with JS off
// (default state = final). JS only enhances: it adds html.js-anim ONLY after confirming motion is
// allowed, which primes count-up (JS sets start values) and hides candles so they can grow back in.
// prefers-reduced-motion shows everything in final state, the ticker renders as one static row, no
// looping animation. No text-shadow/filter on any background-clip:text element (Chrome gotcha).

const indexSym = 'SWAP';
const tape = [
  { s: 'SWAP', p: '657K', c: '+18.4%', d: 'up' },
  { s: 'ORG',  p: '18.2M', c: '+240%', d: 'up' },
  { s: 'PIPE', p: '10.0x', c: '+900%', d: 'up' },
  { s: 'LMBD', p: '657.0', c: '+34.2%', d: 'up' },
  { s: 'TSTM', p: '128.4', c: '+12.8%', d: 'up' },
  { s: 'SMSG', p: '210.6', c: '+6.1%',  d: 'up' },
  { s: 'MEDI', p: '1.00',  c: '+8.6%',  d: 'up' },
  { s: 'LIDO', p: '44.2',  c: '-2.1%',  d: 'down' },
  { s: 'APPX', p: '19.0',  c: '+5.4%',  d: 'up' },
  { s: 'SEO',  p: '76.0',  c: '+41.0%', d: 'up' },
  { s: 'AGNT', p: '20.0',  c: '+120%',  d: 'up' },
];

const metrics = [
  { sym: 'SWAP', to: 657,  dec: 0, pre: '', suf: 'K+', l: 'Leads',           c: '+18.4%' },
  { sym: 'ORGX', to: 18.2, dec: 1, pre: '', suf: 'M+', l: 'Organic traffic', c: '+240%' },
  { sym: 'PIPE', to: 10,   dec: 0, pre: '', suf: 'x',  l: 'Pipeline efficiency', c: '+900%' },
];

const board = [
  { sym: 'LMBD', name: 'LambdaTest', role: 'Product & digital marketing', y: '2021-25', last: '657K LEADS', c: '+34.2%', dir: 'up', feat: true,
    d: 'Owned product and digital marketing end to end and built the full organic growth engine.',
    spark: '0,18 14,15 28,16 42,11 56,12 70,7 84,8 98,4 112,2' },
  { sym: 'TSTM', name: 'TestMu AI', role: 'Rebrand lead', y: '2026', last: 'FULL REBRAND', c: '+12.8%', dir: 'up',
    d: 'Led the complete rebrand from LambdaTest to TestMu AI.',
    spark: '0,16 16,17 32,13 48,14 64,10 80,9 96,6 112,5' },
  { sym: 'SMSG', name: 'Samsung', role: 'via Sociowash', y: '2019', last: 'M-SERIES', c: '+6.1%', dir: 'up',
    d: 'On the Galaxy M-series from inception; ran content distribution, collaborated with Technical Guruji.',
    spark: '0,14 16,15 32,12 48,13 64,11 80,12 96,9 112,10' },
  { sym: 'MEDI', name: 'Medilife Superspeciality', role: 'Marketing & web', y: '0 to 1', last: 'WEBSITE + GTM', c: '+8.6%', dir: 'up',
    d: 'Built the full digital presence and go-to-market for a NABH-accredited superspeciality hospital in Dehradun.',
    spark: '0,19 16,18 32,17 48,14 64,15 80,11 96,10 112,7' },
  { sym: 'LIDO', name: 'Lido Learning', role: 'Growth / CRM', y: '2021', last: 'LEAD OPS', c: '+4.4%', dir: 'amber',
    d: 'Ran CRM management and lead routing and assignment for the EdTech.',
    spark: '0,12 16,13 32,11 48,12 64,13 80,10 96,11 112,9' },
  { sym: 'APPX', name: 'Appknox', role: 'Freelance content', y: 'Freelance', last: 'SECURITY', c: '+5.4%', dir: 'up',
    d: 'Freelance content writer for the mobile app security company.',
    spark: '0,15 16,14 32,15 48,12 64,13 80,11 96,12 112,9' },
