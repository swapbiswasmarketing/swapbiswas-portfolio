// Career candlesticks 2018-2026 (SVG y: smaller = higher value). Baseline visual only.
const candles = [
  { yr: '18', x: 70,  o: 282, c: 266, h: 258, l: 290, dir: 'up' },
  { yr: '19', x: 165, o: 266, c: 240, h: 232, l: 272, dir: 'up' },
  { yr: '20', x: 260, o: 240, c: 251, h: 234, l: 258, dir: 'amber' },
  { yr: '21', x: 355, o: 251, c: 200, h: 190, l: 256, dir: 'up' },
  { yr: '22', x: 450, o: 200, c: 165, h: 156, l: 208, dir: 'up' },
  { yr: '23', x: 545, o: 165, c: 152, h: 142, l: 174, dir: 'amber' },
  { yr: '24', x: 640, o: 152, c: 110, h: 100, l: 158, dir: 'up' },
  { yr: '25', x: 735, o: 110, c: 78,  h: 68,  l: 116, dir: 'up' },
  { yr: '26', x: 830, o: 78,  c: 56,  h: 46,  l: 88,  dir: 'up' },
];

const sectors = [
  { i: '01', t: 'Product Marketing & GTM', d: 'Positioning, launches, battlecards and sales enablement for B2B SaaS.' },
  { i: '02', t: 'Growth, SEO & AEO', d: 'Technical audits, AI-search optimization and demand gen that compounds.' },
  { i: '03', t: 'AI & Automation', d: 'I build the agents and internal tools that do the work - 20+ shipped.' },
  { i: '04', t: 'Building in public', d: 'This site, 8 free tools and 76 articles. Shipped systems, not slide-ware.' },
];

const volume = [
  { n: '20+', l: 'AI agents & internal tools shipped' },
  { n: '15+', l: 'Marketers mentored & levelled up' },
  { n: '76',  l: 'Long-form articles published' },
];

const ratings = [
  { t: 'Value of Agility Award', m: 'LambdaTest, 2024', r: 'STRONG BUY' },
  { t: 'Wall of Fame', m: 'LambdaTest', r: 'BUY' },
  { t: '#1 Product of the Day', m: 'Product Hunt', r: 'STRONG BUY' },
];

const watchlist = ['LambdaTest', 'TestMu AI', 'Samsung', 'Medilife', 'Lido Learning', 'Appknox'];

const profile = [
  { k: 'HQ', v: 'Mumbai, India' },
  { k: 'Tenure', v: '7+ yrs marketing · 4+ in B2B SaaS' },
  { k: 'Education', v: 'Postgrad in Digital Marketing & Growth Strategy, IIM Visakhapatnam' },
  { k: 'Coverage', v: 'PMM & growth strategist who codes AI agents, ships websites and runs technical SEO' },
];
---
<!doctype html>
<html lang="en" data-theme="exchange">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>Swapnil Biswas - The career, live on the big board</title>
<meta name="robots" content="noindex" />
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;700;800&family=Space+Grotesk:wght@400;500;600;700&display=swap" rel="stylesheet" />
<style>
  :root{
    --bg:#0a0d0c;          /* trading terminal near-black */
    --bg2:#0c110f;
    --panel:#0e1512;       /* panel fill */
    --panel2:#111a16;
    --line:#1b2721;        /* panel borders */
    --line2:#16211c;
    --grid:rgba(34,227,154,.055); /* faint green grid */
    --up:#22e39a;          /* UP green */
    --up2:#16c784;
    --amber:#f5b301;       /* amber accent */
    --down:#ff6b81;        /* down / sell red */
    --ink:#e8f0ea;         /* primary ink - AA on bg */
    --muted:#7c8a82;       /* muted label - ~5.3:1 on bg */
    --muted2:#9aa89f;
    --up-soft:rgba(34,227,154,.10);
    --up-line:rgba(34,227,154,.30);
    --amber-soft:rgba(245,179,1,.12);
    --mono:"JetBrains Mono",ui-monospace,"SFMono-Regular",Menlo,monospace;
    --disp:"Space Grotesk",system-ui,-apple-system,sans-serif;
    --pad:clamp(16px,4vw,30px);
    --maxw:1180px;
  }
  *{margin:0;padding:0;box-sizing:border-box}
  html,body{overflow-x:clip}
  html{scroll-behavior:smooth;background:var(--bg)}
  body{
    background:
      radial-gradient(130% 90% at 50% -10%, var(--bg2), var(--bg) 62%),
      var(--bg);
    color:var(--ink);font-family:var(--disp);min-height:100vh;line-height:1.5;
    -webkit-font-smoothing:antialiased;position:relative;
  }
  /* faint terminal grid over everything (decorative) */
  body::before{content:"";position:fixed;inset:0;z-index:0;pointer-events:none;
    background-image:linear-gradient(var(--grid) 1px,transparent 1px),linear-gradient(90deg,var(--grid) 1px,transparent 1px);
    background-size:46px 46px;mask-image:radial-gradient(120% 100% at 50% 0,#000 55%,transparent 100%)}
  a{color:inherit;text-decoration:none}
  ::selection{background:var(--up);color:#04120c}
  .num{font-family:var(--mono);font-variant-numeric:tabular-nums;font-feature-settings:"tnum" 1}

  .wrap{position:relative;z-index:2;max-width:var(--maxw);margin:0 auto;padding:0 var(--pad)}

  /* ============ TICKER TAPE ============ */
  .ticker{position:sticky;top:0;z-index:40;background:linear-gradient(180deg,#070a09,#0a0f0d);
    border-bottom:1px solid var(--line);overflow:hidden;white-space:nowrap}
  .ticker::after{content:"";position:absolute;inset:0;pointer-events:none;
    background:linear-gradient(90deg,var(--bg) 0,transparent 5%,transparent 95%,var(--bg) 100%)}
  .tt-row{display:flex;width:max-content;animation:tape 46s linear infinite}
  .ticker:hover .tt-row{animation-play-state:paused}
  .tt-track{display:flex;flex:none}
  .tt{display:inline-flex;align-items:baseline;gap:8px;padding:9px 20px;font-family:var(--mono);
    font-size:12.5px;letter-spacing:.02em;border-right:1px solid var(--line2)}
  .tt .sym{color:var(--muted2);font-weight:700;letter-spacing:.06em}
  .tt .px{color:var(--ink);font-weight:500}
  .tt .ch{font-weight:700;font-size:11.5px}
  .tt .ch.up{color:var(--up)} .tt .ch.down{color:var(--down)}
  .tt .ar{font-size:9px} .tt .ar.up{color:var(--up)} .tt .ar.down{color:var(--down)}
  @keyframes tape{from{transform:translateX(0)}to{transform:translateX(-50%)}}

  /* ============ TOP BAR ============ */
  .topbar{display:flex;align-items:center;justify-content:space-between;gap:14px;
    padding:14px 0 10px;flex-wrap:wrap}
  .brandmark{display:flex;align-items:center;gap:10px;font-family:var(--mono);font-size:12px;
    letter-spacing:.16em;text-transform:uppercase;color:var(--muted2)}
  .brandmark .dotgrid{display:grid;grid-template-columns:repeat(3,4px);gap:2px}
  .brandmark .dotgrid i{width:4px;height:4px;background:var(--up);opacity:.5;border-radius:1px}
  .brandmark .dotgrid i:nth-child(3n){opacity:.85}
  .clock{font-family:var(--mono);font-size:11.5px;color:var(--muted);letter-spacing:.08em;display:flex;gap:14px}
  .clock .lit{color:var(--up)}

  /* ============ HERO INDEX QUOTE ============ */
  .hero{border:1px solid var(--line);border-radius:14px;background:
      radial-gradient(120% 140% at 100% 0,var(--up-soft),transparent 55%),
      linear-gradient(180deg,var(--panel),var(--bg2));
    padding:clamp(20px,4vw,40px);margin-top:6px;position:relative;overflow:hidden}
  .hero::before{content:"";position:absolute;inset:0;pointer-events:none;
    background-image:linear-gradient(var(--grid) 1px,transparent 1px);background-size:100% 34px;opacity:.5}
  .hero-top{display:flex;align-items:center;gap:12px;flex-wrap:wrap;position:relative}
  .pill{display:inline-flex;align-items:center;gap:8px;font-family:var(--mono);font-size:11px;
    letter-spacing:.14em;text-transform:uppercase;color:var(--up);border:1px solid var(--up-line);
    background:var(--up-soft);padding:6px 12px;border-radius:100px}
  .pill .dot{width:8px;height:8px;border-radius:50%;background:var(--up);position:relative}
  .pill .dot::after{content:"";position:absolute;inset:-4px;border-radius:50%;border:1px solid var(--up);
    animation:ping 1.8s ease-out infinite}
  @keyframes ping{0%{transform:scale(.7);opacity:.8}100%{transform:scale(1.9);opacity:0}}
  .exch{font-family:var(--mono);font-size:11px;letter-spacing:.14em;text-transform:uppercase;color:var(--muted)}

  .hero-grid{display:grid;grid-template-columns:1.35fr .9fr;gap:clamp(20px,4vw,44px);
    align-items:center;margin-top:22px;position:relative}
  .quote-sym{font-family:var(--mono);font-size:13px;letter-spacing:.22em;color:var(--muted2);margin-bottom:4px}
  h1.name{font-family:var(--disp);font-weight:700;line-height:.94;letter-spacing:-.02em;
    font-size:clamp(38px,7.4vw,80px);color:var(--ink)}
  .last-row{display:flex;align-items:flex-end;gap:16px;margin-top:16px;flex-wrap:wrap}
  .last{font-family:var(--mono);font-weight:800;line-height:1;font-size:clamp(40px,8vw,68px);color:var(--up)}
  .last .cur{font-size:.42em;color:var(--muted2);vertical-align:top;font-weight:700}
  .last-meta{display:flex;flex-direction:column;gap:3px;font-family:var(--mono);padding-bottom:6px}
  .last-meta .chg{color:var(--up);font-weight:700;font-size:15px}
  .last-meta .lbl{color:var(--muted);font-size:10.5px;letter-spacing:.1em;text-transform:uppercase}
  .lede{margin-top:20px;font-size:clamp(14px,1.9vw,16.5px);line-height:1.66;color:var(--muted2);max-width:56ch}
  .lede b{color:var(--ink);font-weight:600}
  .lede b.g{color:var(--up)}
  .cta{display:flex;gap:10px;margin-top:24px;flex-wrap:wrap}
  .btn{font-family:var(--mono);font-size:12px;font-weight:700;letter-spacing:.1em;text-transform:uppercase;
    padding:13px 20px;border-radius:9px;display:inline-flex;gap:9px;align-items:center;cursor:pointer;
    transition:transform .2s,background .2s,border-color .2s,color .2s;border:1px solid transparent}
  .btn .ar{transition:transform .2s}
  .btn.buy{background:var(--up);color:#04140d;box-shadow:0 8px 24px -12px var(--up)}
  .btn.buy:hover{transform:translateY(-2px)}
  .btn.buy:hover .ar{transform:translateX(3px)}
  .btn.watch{border-color:var(--line);color:var(--ink);background:rgba(255,255,255,.02)}
  .btn.watch:hover{border-color:var(--up-line);color:var(--up)}

  /* hero sparkline candlestick */
  .hero-chart{border:1px solid var(--line);border-radius:12px;background:var(--bg2);padding:16px 16px 10px;
    position:relative}
  .hero-chart .hc-top{display:flex;justify-content:space-between;font-family:var(--mono);font-size:10.5px;
    letter-spacing:.08em;color:var(--muted);text-transform:uppercase;margin-bottom:8px}
  .hero-chart .hc-top .up{color:var(--up)}
  .hero-chart svg{display:block;width:100%;height:auto}

  /* ============ generic section chrome ============ */
  section{position:relative;z-index:2}
  .sec{margin-top:clamp(46px,7vw,84px)}
  .sec-head{display:flex;align-items:baseline;gap:14px;flex-wrap:wrap;margin-bottom:20px;
    border-bottom:1px solid var(--line);padding-bottom:12px}
  .sec-head .tag{font-family:var(--mono);font-size:11px;letter-spacing:.2em;text-transform:uppercase;color:var(--up)}
  .sec-head h2{font-family:var(--disp);font-weight:600;font-size:clamp(20px,3vw,28px);letter-spacing:-.01em;color:var(--ink)}
  .sec-head .sub{font-family:var(--mono);font-size:11px;color:var(--muted);letter-spacing:.06em;margin-left:auto}

  /* ============ INDEX CARDS (metrics) ============ */
  .idx{display:grid;grid-template-columns:repeat(3,1fr);gap:14px}
  .idx-card{border:1px solid var(--line);border-radius:12px;background:linear-gradient(180deg,var(--panel),var(--bg2));
    padding:20px 20px 18px;position:relative;overflow:hidden;transition:border-color .25s,transform .25s}
  .idx-card::after{content:"";position:absolute;left:0;right:0;bottom:0;height:2px;
    background:linear-gradient(90deg,transparent,var(--up),transparent);opacity:.4}
  .idx-card:hover{border-color:var(--up-line);transform:translateY(-3px)}
  .idx-card .sym{font-family:var(--mono);font-size:11px;letter-spacing:.18em;color:var(--muted2);
    display:flex;justify-content:space-between;align-items:center}
  .idx-card .sym .chg{color:var(--up);font-weight:700}
  .idx-card .val{font-family:var(--mono);font-weight:800;font-size:clamp(32px,5vw,46px);color:var(--ink);
    line-height:1;margin:14px 0 8px}
  .idx-card .lbl{font-size:12.5px;color:var(--muted2);letter-spacing:.02em}
  .idx-card .bar{margin-top:14px;height:6px;border-radius:3px;background:rgba(255,255,255,.04);overflow:hidden}
  .idx-card .bar i{display:block;height:100%;background:linear-gradient(90deg,var(--up2),var(--up));border-radius:3px}

  /* ============ MARKET BOARD (work) ============ */
  .board{border:1px solid var(--line);border-radius:12px;overflow:hidden;background:var(--panel)}
  .brow{display:grid;grid-template-columns:88px 1fr 168px 92px 92px 132px 82px;align-items:center;
    gap:14px;padding:14px var(--pad);border-top:1px solid var(--line2)}
  .brow.head{border-top:0;background:var(--bg2);padding-top:11px;padding-bottom:11px}
  .brow.head span{font-family:var(--mono);font-size:10px;letter-spacing:.16em;text-transform:uppercase;color:var(--muted)}
  .brow:not(.head){transition:background .2s}
  .brow:not(.head):hover{background:var(--up-soft)}
  .brow .c-sym{font-family:var(--mono);font-weight:800;font-size:14px;letter-spacing:.04em;color:var(--ink)}
  .brow .c-name b{display:block;font-weight:600;font-size:15px;color:var(--ink);letter-spacing:-.01em}
  .brow .c-name span{display:block;font-size:11.5px;color:var(--muted);line-height:1.5;margin-top:3px;max-width:52ch}
  .brow .c-role{font-family:var(--mono);font-size:11.5px;color:var(--muted2);letter-spacing:.02em}
  .brow .c-year{font-family:var(--mono);font-size:12px;color:var(--muted2)}
  .brow .c-spark{display:flex;justify-content:flex-end}
  .brow .c-spark svg{width:100%;max-width:100px;height:26px;display:block}
  .brow .c-last{font-family:var(--mono);font-size:11.5px;font-weight:700;color:var(--ink);text-align:right;letter-spacing:.02em}
  .brow .c-chg{font-family:var(--mono);font-size:13px;font-weight:700;text-align:right}
  .c-chg.up{color:var(--up)} .c-chg.amber{color:var(--amber)}
  .brow.feat{background:linear-gradient(90deg,var(--up-soft),transparent 70%);position:relative}
  .brow.feat::before{content:"";position:absolute;left:0;top:0;bottom:0;width:3px;background:var(--up)}
  .brow.feat .c-sym{color:var(--up)}
  .m-tag{display:none}
  .feat-badge{font-family:var(--mono);font-size:8.5px;font-weight:800;letter-spacing:.1em;color:#04140d;
    background:var(--up);padding:2px 6px;border-radius:3px;margin-left:8px;vertical-align:2px}

  /* ============ CANDLESTICK CHART (career) ============ */
  .chartwrap{border:1px solid var(--line);border-radius:12px;background:var(--bg2);padding:clamp(14px,2.5vw,24px);overflow-x:auto}
  .chart-legend{display:flex;gap:18px;flex-wrap:wrap;font-family:var(--mono);font-size:11px;color:var(--muted);margin-top:14px}
  .chart-legend b{color:var(--ink);font-weight:700}
  .chart-legend .k{display:inline-flex;align-items:center;gap:7px}
  .chart-legend .sw{width:10px;height:10px;border-radius:2px}
  .chart-legend .sw.up{background:var(--up)} .chart-legend .sw.am{background:var(--amber)}
  .chart svg{display:block;width:100%;min-width:640px;height:auto}
  .gridline{stroke:var(--line);stroke-width:1;stroke-dasharray:2 6}
  .axis-yr{font-family:var(--mono);font-size:12px;fill:var(--muted);letter-spacing:.04em}
  .axis-px{font-family:var(--mono);font-size:11px;fill:var(--muted2)}
  .wick{stroke-width:2}
  .candle{transform-box:fill-box;transform-origin:50% 100%}
  .candle.up .body{fill:var(--up)} .candle.up .wick{stroke:var(--up)}
  .candle.amber .body{fill:var(--amber)} .candle.amber .wick{stroke:var(--amber)}

  /* ============ SECTORS (disciplines) ============ */
  .sectors{display:grid;grid-template-columns:repeat(2,1fr);gap:14px}
  .sector{border:1px solid var(--line);border-radius:12px;background:var(--panel);padding:22px 22px 20px;
    position:relative;transition:border-color .25s,transform .25s;overflow:hidden}
  .sector:hover{border-color:var(--up-line);transform:translateY(-3px)}
  .sector .idxn{font-family:var(--mono);font-size:11px;letter-spacing:.14em;color:var(--muted);
    display:flex;justify-content:space-between;align-items:center}
  .sector .idxn .tick{color:var(--up)}
  .sector h3{font-family:var(--disp);font-weight:600;font-size:18px;color:var(--ink);margin:12px 0 8px;letter-spacing:-.01em}
  .sector p{font-size:13.5px;color:var(--muted2);line-height:1.6}

  /* ============ VOLUME (shipped) ============ */
  .volume{display:grid;grid-template-columns:repeat(3,1fr);gap:14px}
  .vol{border:1px solid var(--line);border-radius:12px;background:linear-gradient(180deg,var(--panel),var(--bg2));
    padding:22px;text-align:left}
  .vol .n{font-family:var(--mono);font-weight:800;font-size:clamp(30px,5vw,44px);color:var(--up);line-height:1}
  .vol .l{font-size:12.5px;color:var(--muted2);margin-top:10px;line-height:1.5}
  .vol .rail{margin-top:14px;display:flex;gap:3px;align-items:flex-end;height:22px}
  .vol .rail i{flex:1;background:var(--up-line);border-radius:1px}

  /* ============ ANALYST RATINGS (recognition) ============ */
  .ratings{display:flex;flex-direction:column;border:1px solid var(--line);border-radius:12px;overflow:hidden;background:var(--panel)}
  .rating{display:flex;align-items:center;gap:16px;padding:18px var(--pad);border-top:1px solid var(--line2)}
  .rating:first-child{border-top:0}
  .rating .badge{font-family:var(--mono);font-size:11px;font-weight:800;letter-spacing:.08em;
    padding:7px 12px;border-radius:6px;flex:none;white-space:nowrap}
  .rating .badge.strong{background:var(--up);color:#04140d}
  .rating .badge.buy{background:var(--up-soft);color:var(--up);border:1px solid var(--up-line)}
  .rating b{display:block;font-family:var(--disp);font-weight:600;font-size:15.5px;color:var(--ink)}
  .rating span{font-family:var(--mono);font-size:11.5px;color:var(--muted);letter-spacing:.04em}
  .rating .price{margin-left:auto;font-family:var(--mono);font-size:12px;color:var(--up);font-weight:700;white-space:nowrap}

  /* ============ WATCHLIST (brands) ============ */
  .watch-row{display:flex;flex-wrap:wrap;gap:9px}
  .watch-chip{font-family:var(--mono);font-size:12px;letter-spacing:.02em;color:var(--muted2);
    border:1px solid var(--line);border-radius:100px;padding:9px 15px;display:inline-flex;align-items:center;gap:8px;
    transition:border-color .2s,color .2s}
  .watch-chip::before{content:"";width:6px;height:6px;border-radius:50%;background:var(--up);opacity:.7}
  .watch-chip:hover{border-color:var(--up-line);color:var(--ink)}

  /* ============ COMPANY PROFILE (about) ============ */
  .profile{border:1px solid var(--line);border-radius:12px;background:var(--panel);overflow:hidden}
  .profile .lead{padding:22px var(--pad);border-bottom:1px solid var(--line2);font-size:14.5px;line-height:1.66;color:var(--muted2)}
  .profile .lead b{color:var(--ink);font-weight:600}
  .prow{display:grid;grid-template-columns:150px 1fr;gap:16px;padding:14px var(--pad);border-top:1px solid var(--line2)}
  .prow .k{font-family:var(--mono);font-size:11px;letter-spacing:.1em;text-transform:uppercase;color:var(--muted)}
  .prow .v{font-size:13.5px;color:var(--ink);line-height:1.55}

  /* ============ PLACE ORDER (contact) ============ */
  .order{border:1px solid var(--up-line);border-radius:14px;overflow:hidden;
    background:radial-gradient(120% 140% at 0 0,var(--up-soft),transparent 55%),linear-gradient(180deg,var(--panel),var(--bg2))}
  .order .oh{padding:22px var(--pad) 6px;font-family:var(--mono);font-size:11px;letter-spacing:.18em;
    text-transform:uppercase;color:var(--up)}
  .order h2{padding:0 var(--pad);font-family:var(--disp);font-weight:700;font-size:clamp(26px,4.6vw,44px);
    letter-spacing:-.02em;color:var(--ink);line-height:1.02;margin-bottom:6px}
  .order p{padding:0 var(--pad);color:var(--muted2);font-size:14px;max-width:58ch;line-height:1.6}
  .order-actions{display:grid;grid-template-columns:1fr 1fr;gap:14px;padding:22px var(--pad) 26px}
  .order-btn{border:1px solid var(--line);border-radius:11px;background:var(--bg2);padding:18px 20px;
    display:flex;align-items:center;justify-content:space-between;gap:14px;transition:border-color .2s,transform .2s,background .2s}
  .order-btn:hover{border-color:var(--up-line);transform:translateY(-2px);background:var(--panel)}
  .order-btn .side{font-family:var(--mono);font-size:10.5px;letter-spacing:.14em;text-transform:uppercase;color:var(--up)}
  .order-btn .v{font-family:var(--mono);font-size:14px;color:var(--ink);margin-top:6px;word-break:break-word}
  .order-btn .ar{font-size:18px;color:var(--up);flex:none}

  /* ============ FOOTER ============ */
  .foot{position:relative;z-index:2;max-width:var(--maxw);margin:clamp(46px,7vw,80px) auto 0;
    padding:20px var(--pad) 44px;border-top:1px solid var(--line);
    display:flex;justify-content:space-between;flex-wrap:wrap;gap:10px;
    font-family:var(--mono);font-size:11px;letter-spacing:.06em;color:var(--muted)}
  .foot a{color:var(--muted2);border-bottom:1px solid transparent;transition:color .2s,border-color .2s}
  .foot a:hover{color:var(--up);border-color:var(--up-line)}

  /* ============ ANIMATION PRIMING (only added by JS when motion allowed) ============ */
  html.js-anim .candle{transform:scaleY(0)}
  html.js-anim .candle.grown{transform:scaleY(1);transition:transform .9s cubic-bezier(.2,.85,.25,1)}

  /* ============ RESPONSIVE ============ */
  @media(max-width:920px){
    .hero-grid{grid-template-columns:1fr}
    .hero-chart{order:-1}
    .idx,.volume{grid-template-columns:1fr}
    .sectors{grid-template-columns:1fr}
    .order-actions{grid-template-columns:1fr}
  }
  @media(max-width:920px){
    /* market board -> stacked cards (must stack before the 7 rigid columns clip) */
    .brow.head{display:none}
    .brow{grid-template-columns:1fr auto;grid-template-areas:
      "sym chg" "name name" "role year" "spark last";
      gap:8px 14px;padding:16px var(--pad)}
    .brow .c-sym{grid-area:sym}
    .brow .c-chg{grid-area:chg}
    .brow .c-name{grid-area:name}
    .brow .c-role{grid-area:role}
    .brow .c-year{grid-area:year;text-align:right}
    .brow .c-spark{grid-area:spark;justify-content:flex-start}
    .brow .c-spark svg{max-width:120px}
    .brow .c-last{grid-area:last;align-self:center}
    .prow{grid-template-columns:1fr;gap:5px}
  }
  @media(prefers-reduced-motion:reduce){
    html{scroll-behavior:auto}
    .tt-row{animation:none;transform:none}
    .pill .dot::after{animation:none;display:none}
    .idx-card::after{opacity:.3}
    html.js-anim .candle{transform:none!important;transition:none!important}
  }
</style>
