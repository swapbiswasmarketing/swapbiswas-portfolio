<script>
  // Vanilla, light, transforms/opacity only. Content is final-state in markup; JS only enhances
  // AFTER confirming motion is allowed.
  const RM = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const root = document.documentElement;

  if (!RM) {
    root.classList.add('js-anim'); // hides candles (scaleY 0) + lets us prime counters

    // --- candles grow when scrolled into view ---
    const candleEls = Array.from(document.querySelectorAll('.candle')) as HTMLElement[];
    if ('IntersectionObserver' in window && candleEls.length) {
      const cObs = new IntersectionObserver((entries) => {
        entries.forEach((e) => {
          if (e.isIntersecting) {
            const el = e.target as HTMLElement;
            // stagger by horizontal position for a left-to-right print
            const delay = Math.min(560, (candleEls.indexOf(el) % 9) * 60);
            el.style.transitionDelay = delay + 'ms';
            el.classList.add('grown');
            cObs.unobserve(el);
          }
        });
      }, { threshold: 0.15 });
      candleEls.forEach((el) => cObs.observe(el));
      // safety: reveal anything still hidden after 2.6s
      window.setTimeout(() => candleEls.forEach((el) => el.classList.add('grown')), 2600);
    } else {
      candleEls.forEach((el) => el.classList.add('grown'));
    }

    // --- count-up on the index cards ---
    const nums = Array.from(document.querySelectorAll('[data-to]')) as HTMLElement[];
    const fmt = (val: number, dec: number, pre: string, suf: string) =>
      pre + val.toFixed(dec) + suf;

    function countUp(el: HTMLElement) {
      const to = parseFloat(el.getAttribute('data-to') || '0');
      const dec = parseInt(el.getAttribute('data-dec') || '0', 10);
      const pre = el.getAttribute('data-pre') || '';
      const suf = el.getAttribute('data-suf') || '';
      const dur = 1100;
      const t0 = performance.now();
      function frame(now: number) {
        const p = Math.min(1, (now - t0) / dur);
        const eased = 1 - Math.pow(1 - p, 3);
        el.textContent = fmt(to * eased, dec, pre, suf);
        if (p < 1) requestAnimationFrame(frame);
        else el.textContent = fmt(to, dec, pre, suf);
      }
      requestAnimationFrame(frame);
    }

    if ('IntersectionObserver' in window && nums.length) {
      const started = new WeakSet<HTMLElement>();
      const finalize = (el: HTMLElement) =>
        el.textContent = fmt(parseFloat(el.getAttribute('data-to') || '0'),
          parseInt(el.getAttribute('data-dec') || '0', 10),
          el.getAttribute('data-pre') || '', el.getAttribute('data-suf') || '');
      const run = (el: HTMLElement) => { if (started.has(el)) return; started.add(el); countUp(el); };
      // prime to start (only now that we know motion is allowed)
      nums.forEach((el) => {
        const dec = parseInt(el.getAttribute('data-dec') || '0', 10);
        el.textContent = fmt(0, dec, el.getAttribute('data-pre') || '', el.getAttribute('data-suf') || '');
      });
      // animate anything already on screen right away (no wait-for-scroll)
      nums.forEach((el) => {
        const r = el.getBoundingClientRect();
        if (r.top < window.innerHeight * 0.92 && r.bottom > 0) run(el);
      });
      const nObs = new IntersectionObserver((entries) => {
        entries.forEach((e) => {
          if (e.isIntersecting) { run(e.target as HTMLElement); nObs.unobserve(e.target); }
        });
      }, { threshold: 0.4 });
      nums.forEach((el) => { if (!started.has(el)) nObs.observe(el); });
      // safety net: never leave a counter stuck at 0 (mirrors the candle safety above)
      window.setTimeout(() => nums.forEach((el) => { if (!started.has(el)) finalize(el); }), 2400);
    }
  }
</script>
</body>
</html>
