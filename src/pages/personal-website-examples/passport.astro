<script>
  // Vanilla, GPU-only. Content is fully in the markup; JS only enhances.
  const RM = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const root = document.documentElement;

  // ---- Route-map readout (works regardless of motion pref; keyboard + hover) ----
  const readoutCode = document.getElementById('readout-code');
  const readoutText = document.getElementById('readout-text');
  function setReadout(el){
    if(!el || !readoutCode || !readoutText) return;
    readoutCode.textContent = el.getAttribute('data-code') || '';
    const city = el.getAttribute('data-city') || '';
    const role = el.getAttribute('data-role') || '';
    readoutText.innerHTML = '<b>' + city + '.</b> ' + role + '.';
  }
  document.querySelectorAll('.stop').forEach(function(st){
    st.addEventListener('mouseenter', function(){ setReadout(st); });
    st.addEventListener('focus', function(){ setReadout(st); });
  });

  if (!RM) {
    // Motion allowed: hide stamps + un-draw route line, then reveal on scroll into view.
    root.classList.add('js-motion');

    // Stamps thunk in, staggered per grid.
    const stamps = Array.from(document.querySelectorAll<HTMLElement>('.stamps .stamp'));
    if ('IntersectionObserver' in window && stamps.length) {
      const so = new IntersectionObserver(function(entries){
        entries.forEach(function(e){
          if (e.isIntersecting) {
            const el = e.target;
            const delay = (Number(el.dataset.i) || 0) * 90;
            setTimeout(function(){ el.classList.add('in'); }, delay);
            so.unobserve(el);
          }
        });
      }, { threshold: 0.35, rootMargin: '0px 0px -8% 0px' });
      stamps.forEach(function(el, i){ el.dataset.i = String(i % 3); so.observe(el); });
      // Safety: reveal all within 3.5s no matter what.
      setTimeout(function(){ stamps.forEach(function(el){ el.classList.add('in'); }); }, 3500);
    } else {
      stamps.forEach(function(el){ el.classList.add('in'); });
    }

    // Route line draws itself when the map scrolls in.
    const map = document.getElementById('mapfield');
    if (map && 'IntersectionObserver' in window) {
      const mo = new IntersectionObserver(function(entries){
        entries.forEach(function(e){
          if (e.isIntersecting) { map.classList.add('drawn'); mo.unobserve(map); }
        });
      }, { threshold: 0.3 });
      mo.observe(map);
      setTimeout(function(){ map.classList.add('drawn'); }, 3500);
    } else if (map) {
      map.classList.add('drawn');
    }
  }
</script>
</body>
</html>
